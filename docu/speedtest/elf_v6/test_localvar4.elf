// lambda test with parent variable type ... SLOW like global var ... lol!
// because of missing ++/--/.. short cuts

// NOTE so ein dummfug ... all the work is useless ....


#define JLOOPS 25
#define ILOOPS 1000000
#define HALF_ILOOPS 500000

#parentX = 0.0;


%loop1 = fn() {
    for(%i in range ILOOPS)  {
        #parentX ++;
    }
    print("SUM (++) IS:" SPC #parentX);

};

%loop2 = fn() {

    for(%i in range ILOOPS)  {
        #parentX --;
    }
    print("SUM (--) IS:" SPC #parentX);

};

%loop3 = fn() {

    for(%i in range ILOOPS)  {
        #parentX *= %i + 1.0;
        #parentX /= %i + 1.0;
    }
    print("SUM (*/ %i+1) IS:" SPC #parentX);

};

%loop4 = fn() {

    for(%i in range HALF_ILOOPS)  {
        %ran = math.randomf(%i);
        #parentX -= %ran;
        #parentX += %ran;
    }
    print("SUM (rand +-) IS:" SPC #parentX);

};

%loopReset = fn() {
    #parentX = 66.0;
    print("set Sum to 66 == " SPC #parentX);

};

%loops = [%loop1,%loop2,%loopReset, %loop3,%loop4];


for(%j in range JLOOPS)  {
    foreach(%l in %loops) {
        %l();

    }
}
#parentX -= 33.0 ;
print("---------------------");
print("---------------------");
print("Final sum should be 33 == ", #parentX);
print("---------------------");
print("---------------------");
