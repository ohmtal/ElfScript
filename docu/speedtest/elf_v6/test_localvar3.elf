// lambda test with pointers -  not slower and not faster ...
// using pointer to localX ... still experimental .. will be better inside VM
// and it's slower than with parameter and return, so far . but i finally got
// a way to transfer the global scope variables




#define JLOOPS 25
#define ILOOPS 1000000
#define HALF_ILOOPS 500000
%localX = 0.0;

$ptr = getVarPtr("%localX");

%loop1 = fn() {
    %x =  getValueByPtr($ptr);
    for(%i in range ILOOPS)  {
        %x ++;
    }
    print("SUM (++) IS:" SPC %x);
    setValueByPtr($ptr , %x);
};

%loop2 = fn() {
    %x =  getValueByPtr($ptr);
    for(%i in range ILOOPS)  {
        %x --;
    }
    print("SUM (--) IS:" SPC %x);
    setValueByPtr($ptr , %x);
};

%loop3 = fn() {
    %x =  getValueByPtr($ptr);
    for(%i in range ILOOPS)  {
        %x *= %i + 1.0;
        %x /= %i + 1.0;
    }
    print("SUM (*/ %i+1) IS:" SPC %x);
     setValueByPtr($ptr , %x);
};

%loop4 = fn() {
    %x =  getValueByPtr($ptr);
    for(%i in range HALF_ILOOPS)  {
        %ran = math.randomf(%i);
        %x -= %ran;
        %x += %ran;
    }
    print("SUM (rand +-) IS:" SPC %x);
     setValueByPtr($ptr , %x);
};

%loopReset = fn() {
    %x = 66.0;
    print("set Sum to 66 == " SPC %x);
     setValueByPtr($ptr , %x);
};

%loops = [%loop1,%loop2,%loopReset, %loop3,%loop4];


for(%j in range JLOOPS)  {
        // printSeparator();
    foreach(%l in %loops) {
        %l();
        // varDump("%l");
        // %localX = %l(%localX);
        // printSeparator();

    }
}
%localX -= 33.0 ;
print("---------------------");
print("---------------------");
print("Final sum should be 33 == ", %localX);
print("---------------------");
print("---------------------");
