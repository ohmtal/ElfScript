#define JLOOPS 25
#define ILOOPS 1000000

// ElfSctipt 0.8 using Ptr!
%stoObjPtr = new PointStorageObject().getPtr();


%stoObjPtr.x = 0.0;
for (%j in range JLOOPS) {
    for (%i  in range ILOOPS) {
        %stoObjPtr.x ++;
    }
    print("SUM (++) IS:" SPC %stoObjPtr.x);
    for (%i  in range ILOOPS) {
        %stoObjPtr.x --;
    }
    print("SUM (--) IS:" SPC %stoObjPtr.x);
    %stoObjPtr.x = 66.0;
    print("set Sum to 66 == " SPC %stoObjPtr.x);
    for (%i  in range ILOOPS) {
        %stoObjPtr.x *= %i + 1.0;
        %stoObjPtr.x /= %i + 1.0;
    }
    print("SUM (*/ %i+1) IS:" SPC %stoObjPtr.x);
    for (%i in range ILOOPS / 2.0) {
        //%ran = getRandomF(%i);
        %ran = math.randomf(%i);
        // %ran = math::randomf() * %i;
        %stoObjPtr.x -= %ran;
        %stoObjPtr.x += %ran;
    }
    print("SUM (rand +-) IS:" SPC %stoObjPtr.x);
}
%stoObjPtr.x -= 66.0 ;
print("---------------------");
print("---------------------");
print("Static field is float and console is double .. we get rounding errors!!");
print("Final sum should be 0 == ", %stoObjPtr.x);
print("---------------------");
print("---------------------");
vardump("%stoObjPtr");
