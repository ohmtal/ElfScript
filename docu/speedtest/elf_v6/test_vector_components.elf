#define JLOOPS 25
#define ILOOPS 1000000

%myVec = { 0.0, 0.0 };
vardump("%myVec");

for (%j in range  JLOOPS) {
    for (%i in range ILOOPS) {
        %myVec.x ++;
    }
    print("SUM (++) IS:" SPC %myVec.x);
    // varDumpField("%myVec.x");
    for (%i in range  ILOOPS) {
        %myVec.x --;
    }
    print("SUM (--) IS:" SPC %myVec.x);
    // varDumpField("%myVec.x");
    %myVec.x = 66.0;
    print("set Sum to 66 == " SPC %myVec.x * 1);
    for (%i in range  ILOOPS) {
        %myVec.x *= %i + 1;
        %myVec.x /= %i + 1;
    }
    print("SUM (*/ %i+1) IS:" SPC %myVec.x);
    // varDumpField("%myVec.x");
    %ran = 0.0;
    for (%i in range  ILOOPS / 2) {
        // %ran = getRandomF(%i);
        %ran = math.randomf(%i);
        %myVec.x -= %ran;
        %myVec.x += %ran;
    }
    vardump("%ran");
    print("SUM (rand +-) IS:" SPC %myVec.x);
    // varDumpField("%myVec.x");
}
%myVec.x -= 66.0 ;
print("---------------------");
print("---------------------");
print("Final sum should be 0 == ", %myVec.x);
print("---------------------");
print("---------------------");
