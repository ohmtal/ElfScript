#define JLOOPS 25
#define ILOOPS 1000000
#define HALF_ILOOPS 500000

// a bit unfair ;) mixing pointer with local vars and lambda

%myVec = { 0.0, 0.0 };
%ptr = getComponentPrt("%myVec.x");

vardump("%myVecXPrt");


%loop1 = fn(%ptr) {
    %x =  getFloatByComponentPtr(%ptr);
    for(%i in range ILOOPS)  {
        %x ++;
    }
    print("SUM (++) IS:" SPC %x);
    setFloatByComponentPtr(%ptr , %x);
};

%loop2 = fn( %ptr ) {
    %x =  getFloatByComponentPtr(%ptr);
    for(%i in range ILOOPS)  {
        %x --;
    }
    print("SUM (--) IS:" SPC %x);
    setFloatByComponentPtr(%ptr , %x);
};

%loop3 = fn( %ptr ) {
    %x =  getFloatByComponentPtr(%ptr);
    for(%i in range ILOOPS)  {
        %x *= %i + 1.0;
        %x /= %i + 1.0;
    }
    print("SUM (*/ %i+1) IS:" SPC %x);
    setFloatByComponentPtr(%ptr , %x);
};

%loop4 = fn( %ptr ) {
    %x =  getFloatByComponentPtr(%ptr);
    for(%i in range HALF_ILOOPS)  {
        %ran = math.randomf(%i);
        %x -= %ran;
        %x += %ran;
    }
    print("SUM (rand +-) IS:" SPC %x);
    setFloatByComponentPtr(%ptr , %x);
};

%loopReset = fn( %ptr ) {
    %x = 66.0;
    print("set Sum to 66 == " SPC %x);
    setFloatByComponentPtr(%ptr , %x);
};

%loops = [%loop1,%loop2,%loopReset, %loop3,%loop4];


for(%j in range JLOOPS)  {
    foreach(%l in %loops) {
        %l(%ptr);

    }
}

%myVec.x -= 33.0 ;
print("---------------------");
print("---------------------");
print("Final sum should be 33.0 == ", %myVec.x);
print("---------------------");
print("---------------------");
