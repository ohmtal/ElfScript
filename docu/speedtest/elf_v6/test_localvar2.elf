// lambda test with parameter ... not slower and not faster ...


#define JLOOPS 25
#define ILOOPS 1000000
#define HALF_ILOOPS 500000
%localX = 0.0;



%loop1 = fn(%x) {

    for(%i in range ILOOPS)  {
        %x ++;
    }
    print("SUM (++) IS:" SPC %x);
   return %x;
};

%loop2 = fn(%x) {

    for(%i in range ILOOPS)  {
        %x --;
    }
    print("SUM (--) IS:" SPC %x);
   return %x;
};

%loop3 = fn(%x) {

    for(%i in range ILOOPS)  {
        %x *= %i + 1.0;
        %x /= %i + 1.0;
    }
    print("SUM (*/ %i+1) IS:" SPC %x);
   return %x;
};

%loop4 = fn(%x) {

    for(%i in range HALF_ILOOPS)  {
        %ran = math.randomf(%i);
        %x -= %ran;
        %x += %ran;
    }
    print("SUM (rand +-) IS:" SPC %x);
   return %x;
};

%loopReset = fn(%x) {
    %x = 66.0;
    print("set Sum to 66 == " SPC %x);
   return %x;
};

%loops = [%loop1,%loop2,%loopReset, %loop3,%loop4];


for(%j in range JLOOPS)  {
    foreach(%l in %loops) {
        %localX = %l(%localX);
    }
}
%localX -= 33.0 ;
print("---------------------");
print("---------------------");
print("Final sum should be 33 == ", %localX);
print("---------------------");
print("---------------------");
