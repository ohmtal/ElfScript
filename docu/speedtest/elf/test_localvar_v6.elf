// print and math::randomf are core commands
#define JLOOPS 25
#define ILOOPS 1000000
#define HALF_ILOOPS 500000
%localX = 0.0;
for(%j in range JLOOPS)  {
    for(%i in range ILOOPS)  {
        %localX ++;
    }
    print("SUM (++) IS:" SPC %localX);
    for(%i in range ILOOPS)  {
        %localX --;
    }
    print("SUM (--) IS:" SPC %localX);
    %localX = 66.0;
    print("set Sum to 66 == " SPC %localX);
    for(%i in range ILOOPS)  {
        %localX *= %i + 1.0;
        %localX /= %i + 1.0;
    }
    print("SUM (*/ %i+1) IS:" SPC %localX);
    for(%i in range HALF_ILOOPS)  {
        %ran = math::randomf() * %i;
        %localX -= %ran;
        %localX += %ran;
    }
    print("SUM (rand +-) IS:" SPC %localX);
}
%localX -= 66.0 ;
print("---------------------");
print("---------------------");
print("Final sum should be 0 == ", %localX);
print("---------------------");
print("---------------------");
