#define JLOOPS 25
#define ILOOPS 1000000

%sto = new PointStorageObject(){
    TypeF32 DynX = 0;
};

// %sto.DynX = 0;
for (%j in range  JLOOPS) {
    for (%j in range ILOOPS) {
        %sto.DynX ++;
    }
    echo("SUM (++) IS:" SPC %sto.DynX);
    // varDumpField("%sto.DynX");
    for (%j in range  ILOOPS) {
        %sto.DynX --;
    }
    echo("SUM (--) IS:" SPC %sto.DynX);
    // varDumpField("%sto.DynX");
    %sto.DynX = 66.0;
    echo("set Sum to 66 == " SPC %sto.DynX * 1);
    for (%j in range  ILOOPS) {
        %sto.DynX *= %i + 1;
        %sto.DynX /= %i + 1;
    }
    echo("SUM (*/ %i+1) IS:" SPC %sto.DynX);
    // varDumpField("%sto.DynX");
    %ran = 0.0;
    for (%j in range  ILOOPS / 2) {
        %ran = getRandomF(%i);
        %sto.DynX -= %ran;
        %sto.DynX += %ran;
    }
    echo("SUM (rand +-) IS:" SPC %sto.DynX);
    // varDumpField("%sto.DynX");
}
%sto.DynX -= 66.0 ;
// echo(" NOT A SPEED TEST !!! varDumpField is slow.");
echo("---------------------");
echo("---------------------");
echo("Final sum should be 0 == ", %sto.DynX);
echo("---------------------");
echo("---------------------");
