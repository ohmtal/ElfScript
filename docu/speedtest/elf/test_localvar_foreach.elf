// foreach or fast for  include the first and last so i have to decrease LOOPS by ONE
// or start at 1
#define JLOOPS 25
#define ILOOPS 1000000
#define HALF_ILOOPS 500000

// new PointStorageObject(sto);

%localX = 0.0;
for(%j in range JLOOPS)  {
    for(%i in range ILOOPS)  {
        %localX ++;
    }
    echo("SUM (++) IS:" SPC %localX);
    for(%i in range ILOOPS)  {
        %localX --;
    }
    echo("SUM (--) IS:" SPC %localX);
    %localX = 66.0;
    echo("set Sum to 66 == " SPC %localX);
    for(%i in range ILOOPS)  {
        %localX *= %i + 1.0;
        %localX /= %i + 1.0;
    }
    echo("SUM (*/ %i+1) IS:" SPC %localX);
    for(%i in range HALF_ILOOPS)  {
        %ran = getRandomF(%i);
        // %ran = randomf() * %i; //0.6g!
        %localX -= %ran;
        %localX += %ran;
    }
    echo("SUM (rand +-) IS:" SPC %localX);
}
%localX -= 66.0 ;
echo("---------------------");
echo("---------------------");
echo("Final sum should be 0 == ", %localX);
echo("---------------------");
echo("---------------------");
