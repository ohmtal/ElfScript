#define JLOOPS 25
#define ILOOPS 1000000

$myVec = { 0.0 };
vardump("$myVec");

for (%j in range  JLOOPS) {
    for (%i in range ILOOPS) {
        $myVec.x ++;
    }
    echo("1 SUM (++) IS:" SPC $myVec.x);
    // varDumpField("$myVec.x");
    for (%i in range  ILOOPS) {
        $myVec.x --;
    }
    echo("2 SUM (--) IS:" SPC $myVec.x);
    // varDumpField("$myVec.x");
    $myVec.x = 66.0;
    echo("3 set Sum to 66 == " SPC $myVec.x * 1.0);
    for (%i in  1 .. ILOOPS) {
        $myVec.x *= %i;
        $myVec.x /= %i;
    }
    echo("4 SUM (*/ %i+1) IS:" SPC $myVec.x);
    // varDumpField("$myVec.x");
    %ran = 0.0;
    for (%i in range  ILOOPS / 2) {
        %ran = getRandomF(%i);
        $myVec.x -= %ran;
        $myVec.x += %ran;
    }
    vardump("%ran");
    echo("5 SUM (rand +-) IS:" SPC $myVec.x);
    // varDumpField("$myVec.x");
}
$myVec.x -= 66.0 ;
echo("---------------------");
echo("---------------------");
echo("Final sum should be 0 == ", $myVec.x);
echo("---------------------");
echo("---------------------");
