#define JLOOPS 25
#define ILOOPS 1000000

new PointStorageObject(sto) {
    TypeF32 DynX = 0;
};

%part = (1 << 4);

for (%j = 0; %j < JLOOPS; %j++) {

    if (%part & (1 << 0) ) {

        for (%i = 0; %i < ILOOPS; %i++) {
            sto.DynX ++;
        }
        echo("SUM (++) IS:" SPC sto.DynX);
    }
    if (%part & (1 << 1)) {
        for (%i = 0; %i < ILOOPS; %i++) {
            sto.DynX --;
        }
        echo("SUM (--) IS:" SPC sto.DynX);
    }
    sto.DynX = 66;
    echo("set Sum to 66 == " SPC sto.DynX * 1);
    if (%part & (1 << 2)) {
        for (%i = 0; %i < ILOOPS; %i++) {
            sto.DynX *= %i + 1;
            sto.DynX /= %i + 1;
        }
        echo("SUM (*/ %i+1) IS:" SPC sto.DynX);
    }
    if (%part & (1 << 3)) {
        for (%i = 0; %i < ILOOPS / 2.0; %i++) {
            %ran = getRandomF(%i);
            sto.DynX -= %ran;
            sto.DynX += %ran;
        }
        echo("SUM (rand +-) IS:" SPC sto.DynX);
    }
    if (%part & (1 << 4)) {
        for (%i = 0; %i < ILOOPS / 2.0; %i++) {
            sto.DynX = getRandomF(%i);
        }
        echo("SET (rand ) IS:" SPC sto.DynX);
    }
}
