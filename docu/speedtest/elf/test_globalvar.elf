#define JLOOPS 25
#define ILOOPS 1000000

// new PointStorageObject(sto);

$globalX = 0.0;
for (%j = 0; %j < JLOOPS; %j++) {
    for (%i = 0; %i < ILOOPS; %i++) {
        $globalX ++;
    }
    echo("SUM (++) IS:" SPC $globalX);
    for (%i = 0; %i < ILOOPS; %i++) {
        $globalX --;
    }
    echo("SUM (--) IS:" SPC $globalX);
    $globalX = 66;
    echo("set Sum to 66 == " SPC $globalX * 1);
    for (%i = 0; %i < ILOOPS; %i++) {
        $globalX *= %i + 1;
        $globalX /= %i + 1;
    }
    echo("SUM (*/ %i+1) IS:" SPC $globalX);
    for (%i = 0; %i < ILOOPS / 2.0; %i++) {
        %ran = getRandomF(%i);
        $globalX -= %ran;
        $globalX += %ran;
    }
    echo("SUM (rand +-) IS:" SPC $globalX);
}
$globalX -= 66.0 ;
echo("---------------------");
echo("---------------------");
echo("Final sum should be 0 == ", $globalX);
echo("---------------------");
echo("---------------------");
