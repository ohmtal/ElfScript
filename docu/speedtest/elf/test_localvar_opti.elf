#define JLOOPS 25.0
#define ILOOPS 1000000.0

// - set all to float but is the same ^^
// - removing echo is not really faster
// - while is slower !!!

// no ideas left what i can do here at the moment

%localX = 0.0;
for (%j = 0; %j < JLOOPS; %j++) {
    for (%i = 0.0; %i < ILOOPS; %i++) {
        %localX ++;
    }
    echo("SUM (++) IS:" SPC %localX);
    for (%i = 0.0; %i < ILOOPS; %i++) {
        %localX --;
    }
    echo("SUM (--) IS:" SPC %localX);
    %localX = 66.0;
    echo("set Sum to 66 == " SPC %localX);
    for (%i = 0.0; %i < ILOOPS; %i++) {
        %localX *= %i + 1.0;
        %localX /= %i + 1.0;
    }
    echo("SUM (*/ %i+1) IS:" SPC %localX);
    for (%i = 0.0; %i < ILOOPS / 2.0; %i++) {
        %ran = getRandomF(%i);
        %localX -= %ran;
        %localX += %ran;
    }
    echo("SUM (rand +-) IS:" SPC %localX);
}
%localX -= 66.0 ;
echo("---------------------");
echo("---------------------");
echo("Final sum should be 0 == ", %localX);
echo("---------------------");
echo("---------------------");
