// Prototype for 2D Editor using a Aquarium
// Graphics: Fish Pack 2.0 - Created/distributed by Kenney (www.kenney.nl)
//-----------------------------------------------------------------------------
// FIXME implement: 1.) Add Mouse Object!! which is cloned or placed
// Control Scheme:
//
// - Scale          : Mouse Wheel
// - Rotate         : CTRL + Mouse Wheel.
// - Layer (0..20)  : Shift + Mouse Wheel.
// - Flip (0..3)    : Middle Mouse Click Cycle.
//
// - deselect       : right mouse button
// - placement      : left mouse button (in placement mode)
// - select object  : left mouse button (in select mode)
// - attach selected to mouse: SPACE
//
// GUI:
// - Snap To Grid  : F1
// - reset placement parameters : F2
// - Atlas Map      : TAB
// - Main Menu      : ESCAPE
// - Inspector      : F10
//
//-----------------------------------------------------------------------------
exec ("include/TextureAtlas.elf");
exec ("include/Inspector.elf");
exec ("include/GuiTool.elf");

#define MAX_LAYER 20
#define MAX_SCALE 1024
#define SCALE_SNAP 8
#define PREVIEW_SIZE 96
#define SHOW_PREVIEW 0
#define BACKGROUND_COLOR "176 233 252"
#define SCENE_FILE "pref:/aquarium.elfscene"
#define EXPORT_PNG_FILE "pictures:/AquariumBackground.png"

function createAquarium() {
    %obj = new ScriptGroup(Aquarium) {
        // class = "Aquarium";
    };

    return %obj;
}
//----------------------------------------------------------------------
function Aquarium::onAdd(%this) {

    SetClearBackground(BACKGROUND_COLOR); //only set once

    %this.Spritesheet = loadTextureAtlas("texture/kenney_fish-pack_2/Spritesheet/", "spritesheet-double.xml", 0.5);
    %this.Spritesheet.name = "SpriteSheet";
    %this.add(%this.Spritesheet);

    %this.showSheet = true;
    %this.snapToGrid = true;

    %this.paintSize = 48;
    %this.paintAngle = 0;
    %this.paintCenterPoint = "24 24";
    %this.paintFlip = 0;

    %this.add( new SpriteGroup(SceneObjects));
    %this.placementLayer = mFloor(MAX_LAYER / 2); // start with in the middle
    %this.selectedSceneObject = 0;
    %this.add( new SimSet(SelectList));

    %this.hideSpriteSheet = false;


    %target = CreateRenderTarget(getScreenSize());
    %target.name = "RenderTarget";
    %this.add( %target );

    %this.dirty = true;

    %this.add ( new SimObject(FieldInspector));
    %this.showInspector = false;

    $Main.hideBottomMessage = true;

    // Menu
    %this.MainMenu = new SimObject() {
        class = "GuiToolMenu";
        MenuCaption = "Menu";
        MenuFontScale = 2.5;
        MenuEntries = "Save Scene" TAB "Load Scene" TAB "Export Image" TAB  "Resume" TAB "Quit";
        OnMenuObject = %this;
        OnMenuMethod = "onMainMenu";
    };

    %this.ConfirmMenu = new SimObject() {
        class = "GuiToolMenu";
        MenuCaption = "Confirm";
        MenuFontScale = 3.0;
        MenuEntries = "YES" TAB "NO";
        OnMenuObject = %this;
        OnMenuMethod = "onConfirmMenu";
    };

    %this.SelectObjectMenu = new SimObject() {
        class = "GuiToolMenu";
        MenuCaption = "select";
        MenuFontScale = 1.2;
        OnMenuObject = %this;
        OnMenuMethod = "onSelectObject";
        MenuTextureAtlas = %this.SpriteSheet;
        MenuTextureAtlasSize = "24 24";
        MenuEntries = "";
        MenuTextureRects = "";
        NoDarkenOverlay = true;
    };

    GuiTool.CurrentMenu = 0; //reset



    return true;
}
//----------------------------------------------------------------------
function Aquarium::OnRemove(%this) {
    GuiTool.CurrentMenu = 0; //reset
}
//----------------------------------------------------------------------
function Aquarium::OnUpdate(%this, %dt) {
}
//----------------------------------------------------------------------
//----------------------------------------------------------------------
function Aquarium::DrawSpriteSheet(%this) {
    %s = %this.Spritesheet;
    %cnt = %s.getDynamicFieldCount();
    %screenSize = getScreenSize();
    %screenSize.y /= 2;
    %x = 0; %y = 0;
    %size = 32;
    %mousePos = GetMousePosition();
    %this.cursorTexure = "";
    // BeginBlendMode();
    for (%i = 0; %i < %cnt ; %i++) {
        %f = %s.getDynamicField(%i);
        %name = getField(%f,0);
        %srcRect = getField(%f,1);
        %y += %size;
        if ( %y+%size > %screenSize.y) {
            %y = 0;
            %x += %size;
        }
        %dstRect = %x SPC %y SPC %size SPC %size;
        %s.DrawSrcDstRect(%srcRect,%dstRect, WHITEBLEND);
        if (PointInRect(%mousePos, %dstRect)) {

            if (SDL_IsMouseButtonDown(SDL_BUTTON_LEFT)) {
                %this.selectedSceneObject = 0;
                %this.mouseObject = new SpriteObject() {
                    class = "SceneObject";
                    TypeRectF srcRect = %srcRect;
                    // TypeRectF dstRect = %dstRect;
                    TypeF32   angle = %this.paintAngle;
                    TypeF32   centerPoint = %this.paintCenterPoint;
                    TypeColor color=WHITEBLEND;
                    TypeS32   flip = %this.paintFlip;
                    TypeF32   layer = %this.placementLayer; //higher = rendered first
                    TypeString textureName = %name;
                    TypeBool ignoreOnMultiSelect = false;
                };
                SceneObjects.add( %this.mouseObject);
            }
            %this.cursorTexure = %name;
        }

    }
    if (!isObject(%this.mouseObject))  DrawText(%mousePos.x + 8, %mousePos.y + 8,%this.cursorTexure , 1.8, "128 255 0", true, BLACK);
}
//----------------------------------------------------------------------
// sort by layers higher == move to back (render first)
function compareLayers(%objA, %objB)
{
    if (%objA.layer == %objB.layer) return 0;
    return (%objA.layer > %objB.layer) ? -1 : 1;
}

//----------------------------------------------------------------------
function Aquarium::removeSceneObject(%this,%obj) {
    %obj.delete();
    %this.dirty = true;
}
//----------------------------------------------------------------------
function Aquarium::load(%this) {
    %path = getFullPath(SCENE_FILE);


    %savScene = SceneObjects.getId();
    %savScene.name = "savScene";

    if (exec(%path)) {

        GuiTool.Message = "Scene loaded from:\n" @ %path;
        warn("will delete previous scene in 100ms id:" SPC %savScene);
        // add new one to this:
        %this.add(SceneObjects);

        //update objects to current version
        foreach(%obj in SceneObjects) {
            // when a version is changed ... for future use
        }


        // delete prev:
        %savScene.schedule(100, delete);
    } else {
        GuiTool.Message = "[error] Failed to load Scene from:\n" @ %path;
        %savScene.name = SceneObjects; //restore saved scene
        warn("Saved Scene restored:" SPC SceneObjects.getId() SPC "==" SPC %savScene);
    }
    %this.dirty = true;


}

//----------------------------------------------------------------------
function Aquarium::onSelectObject(%this, %menuId, %menuCaption) {

    // echo("LIST:"); SelectList.listObjects();

    %obj = SelectList.getObject(%menuId).getId();
    %this.selectedSceneObject = %obj;
    FieldInspector.inspect(%obj);
    SelectList.clear();
    GuiTool.CurrentMenu = 0;

    // warn("SELECT " SPC %menuId SPC  %menuCaption SPC "=>" SPC %obj);
}
//----------------------------------------------------------------------
function Aquarium::save(%this) {

    %path = getFullPath(SCENE_FILE);
    if (SceneObjects.save(%path)) GuiTool.Message = "Scene saved to:\n" SPC %path;
    else GuiTool.Message = "[error] Failed to save Scene to:\n" SPC %path;
    %this.dirty = true;
}
//----------------------------------------------------------------------
function Aquarium::onConfirmMenu(%this, %menuId, %menuCaption) {

    if (%this.ConfirmMenu.action $= "Save Scene" && %menuId == 0) {
        %this.save();
    }
    GuiTool.CurrentMenu = 0;
}

//----------------------------------------------------------------------
function Aquarium::onMainMenu(%this, %menuId, %menuCaption) {
    switch$ (%menuCaption) {

        case "Save Scene":
            if (SceneObjects.getCount() == 0) {
                GuiTool.Message = "Skip save empty scene!";
                return;
            }
            %this.ConfirmMenu.MenuCaption = "Confirm Save Scene";
            %this.ConfirmMenu.action = "Save Scene";
            GuiTool.CurrentMenu = %this.ConfirmMenu;


        case "Load Scene":
            GuiTool.CurrentMenu = 0;
            %this.load();

        case "Export Image":
            GuiTool.CurrentMenu = 0;

            %path = getFullPath(EXPORT_PNG_FILE);
            if (RenderTarget.saveImage(%path))
                GuiTool.Message = "Image exported to:\n" @ %path;
        else
            GuiTool.Message = "[error]Failed to export Image to:\n" @ %path;

        case "Resume":
            GuiTool.CurrentMenu = 0;

        case "Quit": schedule(250,0, quit);

    } //switch
}

//----------------------------------------------------------------------
function Aquarium::Render(%this) {

    if (%this.showInspector && %this.selectedSceneObject != 0) FieldInspector.render();

    %screenSize = getScreenSize();
    %mousePos = GetMousePosition();
    %haveMouseObject = isObject(%this.mouseObject);

    %haveOverlay =  GuiTool.haveOverlay();

    if (%this.dirty ) {
        if (!SetRenderTarget(RenderTarget.getId()))  { error("Failed to set RenderTarget to " SPC  RenderTarget.getId());}
        ClearBackground(BACKGROUND_COLOR);

        SceneObjects.drawAtlasBatch(SpriteSheet.getId(), 0);
        // foreach(%obj in SceneObjects) {
        //     Spritesheet.DrawRotatedSrcDstRect(%obj.srcRect,
        //                                       %obj.dstRect,
        //                                       %obj.angle,
        //                                       %obj.centerPoint,
        //                                       %obj.flip,
        //                                        %obj.color
        //                                       );
        //
        // }
        SetRenderTarget(0);
        %this.dirty = false;
    }

    RenderTarget.DrawRect("0 0" SPC RenderTarget.getSize());
     if (!%this.dirty && !%haveOverlay) {

        //FIXME cleanup source code :

        %mouseDown = SDL_IsMouseButtonPressed(SDL_BUTTON_LEFT);
        %deletePressed = SDL_IsKeyPressed(SDL_SCANCODE_DELETE);
        %lctrlPressed = SDL_IsKeyDown(SDL_SCANCODE_LCTRL);
        %lshiftPressed = SDL_IsKeyDown(SDL_SCANCODE_LSHIFT);
        if (%mouseDown   )  {
            %this.selectedSceneObject = 0;
            FieldInspector.inspect(0);
            SelectList.clear();
        }
        if (%mouseDown || %deletePressed || %lctrlPressed || %lshiftPressed || %this.selectedSceneObject != 0) {

            // FIXME HELPLINE
            DrawText(10,%screenSize.y - 30, "DEL delete,  F10 Inspector", 2, BLUE, true);

            foreach(%obj in SceneObjects) {

                // SHOW THE LAYERS OF ALL OBJECTS
                if (%lshiftPressed) {
                    DrawText(%obj.dstRect.x + 1 ,%obj.dstRect.y + 1, %obj.Layer , 1.0, YELLOW, true);
                }


                // SELECT OBJECT
                if (!%haveMouseObject && !%haveOverlay && %mouseDown) {
                    if (PointInRect(%mousePos, %obj.dstRect)) {
                        %this.selectedSceneObject = %obj;
                        FieldInspector.inspect(%obj.getId());
                        SelectList.add(%obj);
                    }
                }


                // draw SELECTION RECT
                if (%this.selectedSceneObject == %obj) {
                    DrawRectRec(%obj.dstRect, ORANGE, false);
                }
            } //foreach
        }
    }

    // check Multiple selections and show menu
    if (SelectList.getCount() > 1 && %mouseDown) {
        warn("Multiple Objects found at mouse position:");

        foreach( %obj in SelectList ) {
            if (%obj.ignoreOnMultiSelect) {
                SelectList.remove(%obj);
                echo(%obj.getid SPC "ignored");
            }
        }

        if (SelectList.getCount() == 1) {
            %this.selectedSceneObject = SelectList.getObject(0);
            Inspector.inspect(%this.selectedSceneObject);
        } else {
            %this.SelectObjectMenu.MenuEntries = "";
            %this.SelectObjectMenu.MenuTextureRects = "";

            foreach( %obj in SelectList ) {
                %this.SelectObjectMenu.MenuEntries = trim( %this.SelectObjectMenu.MenuEntries TAB %obj.getId());
                %this.SelectObjectMenu.MenuTextureRects = trim( %this.SelectObjectMenu.MenuTextureRects TAB %obj.srcRect );
            }
            %this.SelectObjectMenu.position = GetMousePosition();
            GuiTool.CurrentMenu =  %this.SelectObjectMenu;
        }

    }



    if (!%haveMouseObject) {
        if (!%haveOverlay) {
            if ( %this.hideSpriteSheet ) {

                DrawText(0,0,"[TAB]",1.5, "200 200 0 150", true);

            } else {
                %this.DrawSpriteSheet();
            }

        }

    } else /*if (!%haveOverlay )*/ {

        %halvPaintSize =  %this.paintSize / 2;
        if (%this.snapToGrid) {
            // Snap to grid
            %gridSize = SCALE_SNAP;

            %snapX = mFloor((%mousePos.x - %halvPaintSize) / %gridSize) * %gridSize;
            %snapY = mFloor((%mousePos.y - %halvPaintSize) / %gridSize) * %gridSize;

            %maxX = getWord(%screenSize, 0) - %this.paintSize;
            %maxY = getWord(%screenSize, 1) - %this.paintSize;

            %snapX = mClamp(%snapX, 0, %maxX);
            %snapY = mClamp(%snapY, 0, %maxY);

            %this.mouseObject.dstRect = %snapX SPC %snapY SPC %this.paintSize SPC %this.paintSize;

        } else {
            %this.mouseObject.dstRect = (%mousePos.x - %halvPaintSize) SPC (%mousePos.y - %halvPaintSize) SPC %this.paintSize SPC %this.paintSize;
        }

        Spritesheet.DrawRotatedSrcDstRect(%this.mouseObject.srcRect,
                                          %this.mouseObject.dstRect,
                                          %this.mouseObject.angle,
                                          %this.mouseObject.centerPoint,
                                          %this.mouseObject.flip,
                                          %this.mouseObject.color
        );
        %dstRect = %this.mouseObject.dstRect;
        DrawText(%dstRect.x + 1 , %dstRect.y + 1, %this.paintSize SPC "/" SPC %this.placementLayer , 1.0);

        //  P L A C E M E N T
        if (!%haveOverlay && SDL_IsMouseButtonPressed(SDL_BUTTON_LEFT)) {
            SceneObjects.add( %this.mouseObject.clone());
            // SceneObjects.sort("compareLayers");
            SceneObjects.sortLayers();
            %this.dirty = true;
        }


        DrawText(5, 5, "snap to grid (F1):" SPC (%this.snapToGrid ? "ON" : "OFF"), 2.0, BLUE, true);
    }


    GuiTool.Render(%screenSize);



}

function SceneObject::onInspectPostApply(%this) {
    // echo("onInspectPostApply" SPC %this);
    Aquarium.dirty = true;
    // SceneObjects.sort("compareLayers");
    SceneObjects.sortLayers();
}
//----------------------------------------------------------------------
function Aquarium::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) {

    if ( GuiTool.haveOverlay() ) return;

    if (%isDown) {
        if (%scancode == SDL_SCANCODE_ESCAPE) {
            if (GuiTool.CurrentMenu == 0) GuiTool.CurrentMenu =%this.MainMenu;
            else GuiTool.CurrentMenu = 0;
        }
        if (%scancode == SDL_SCANCODE_F1) %this.snapToGrid = !%this.snapToGrid;
        if (%scancode == SDL_SCANCODE_F2) {
            %this.paintSize = 48;
            %this.paintAngle = 0;
            %this.paintCenterPoint = "24 24";
            %this.paintFlip = 0;
            if (isObject(%this.mouseObject)) {
                %this.mouseObject.angle = %this.paintAngle;
                %this.mouseObject.centerPoint = %this.paintCenterPoint;
                %this.mouseObject.flip = %this.paintFlip;
            }

        }
        if (%scancode == SDL_SCANCODE_F10) %this.showInspector = !%this.showInspector;
        if (%scancode == SDL_SCANCODE_TAB) %this.hideSpriteSheet = !%this.hideSpriteSheet;

        if (%scancode == SDL_SCANCODE_SPACE) {
            if (isObject(%this.selectedSceneObject)) {
                %obj = %this.selectedSceneObject;
                %this.selectedSceneObject = 0;
                SceneObjects.remove(%obj);
                %this.dirty = true;

                %this.paintSize = %obj.dstRect.width;
                %this.mouseObject = %obj;

            }
        }

        if (%scancode ==  SDL_SCANCODE_DELETE) {
            if (isObject(%this.selectedSceneObject)) {
                %this.selectedSceneObject.delete();
                %this.selectedSceneObject = 0;
                %this.dirty = true;
            }
        }

    }
}
//----------------------------------------------------------------------
function Aquarium::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {
    if (%isDown) {
        // change flip
        if (%button == SDL_BUTTON_MIDDLE) {
            %obj = isObject(%this.mouseObject) ? %this.mouseObject :  %this.selectedSceneObject;
            %haveObject = isObject(%obj);
            if (haveObject) {


                if (%obj == %this.selectedSceneObject) {
                    %obj.flip ++;
                    %obj.flip = %obj.flip % 4;
                    %this.dirty = true;
                } else {
                    %this.paintFlip++;
                    %this.paintFlip = %this.paintFlip % 4;
                    %obj.flip = %this.paintFlip;
                }
            }
        } else if ( %button == SDL_BUTTON_RIGHT ) {
            if (%this.mouseObject != 0) {
                %this.mouseObject.delete();
                %this.mouseObject = 0;
            }
            if (%this.selectedSceneObject != 0) {
                %this.selectedSceneObject = 0;
            }
        }
    }
}
//----------------------------------------------------------------------
function Aquarium::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){

    %obj = isObject(%this.mouseObject) ? %this.mouseObject :  %this.selectedSceneObject;
    %haveObject = isObject(%obj);

    if (%wheelY != 0 && %haveObject) {
        // Wheel + SHIFT = LAYER
        if (SDL_IsKeyDown(SDL_SCANCODE_LSHIFT) || SDL_IsKeyDown(SDL_SCANCODE_RSHIFT) ) {

            if (%obj == %this.selectedSceneObject) {
                %obj.layer = mClamp(%obj.layer + %wheelY, 0, MAX_LAYER) ;
                %this.dirty = true;
                // SceneObjects.sort("compareLayers");
                SceneObjects.sortLayers();
            } else {
                //must be mouseObject
                %this.placementLayer = mClamp( %this.placementLayer  + %wheelY, 0,MAX_LAYER) ;
                %obj.layer = %this.placementLayer;
            }
        }
        // Wheel + ctrl = Rotate
        else if (SDL_IsKeyDown(SDL_SCANCODE_LCTRL) || SDL_IsKeyDown(SDL_SCANCODE_RCTRL) ) {
            %a = %obj.angle + %wheelY;
            // clamp
            %a = ((%a % 360) + 360) % 360;

            %obj.angle = %a;
            if (%obj == %this.selectedSceneObject) {
                %this.dirty = true;
            } else {
                %this.paintAngle += %obj.angle;

            }
        }
        // not ctrl and to shift we resize
        else {
            // should i keep the paintSize == new selected SceneObject size
            %this.paintSize = mClamp( %this.paintSize + SCALE_SNAP * %wheelY,SCALE_SNAP, MAX_SCALE) ;

            %this.paintCenterPoint = %this.paintSize / 2 SPC %this.paintSize / 2;
            %obj.centerPoint = %this.paintCenterPoint;

            if (%obj == %this.selectedSceneObject) {
                %obj.dstRect.width = %this.paintSize;
                %obj.dstRect.height = %this.paintSize;

                %this.dirty = true;
            }
        }
    } // wheel + object
}
