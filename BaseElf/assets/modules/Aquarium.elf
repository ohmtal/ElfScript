//-----------------------------------------------------------------------------
// Prototype for 2D Editor using a Aquarium
// Graphics: 	Fish Pack 2.0 - Created/distributed by Kenney (www.kenney.nl)
//-----------------------------------------------------------------------------
// Control Scheme:
// FIXME implement
// - Scale          : Mouse Wheel alone. Quick and natural for resizing.
// - Rotate         : Shift + Mouse Wheel.
// - Layer (0..20)  : Ctrl + Mouse Wheel.
// - Flip (0..3)    : Middle Mouse Click Cycle.
//
// GUI:
// - Atlas Map      : SPACE
// - Main Menu      : ESCAPE
// - Inspector      : F10
//
//-----------------------------------------------------------------------------
exec ("include/TextureAtlas.elf");
exec ("include/Inspector.elf");
exec ("include/GuiTool.elf");

#define MAX_LAYER 20
#define MAX_SCALE 256
#define SCALE_SNAP 8
#define PREVIEW_SIZE 96
#define SHOW_PREVIEW 0
#define BACKGROUND_COLOR "176 233 252"
#define SCENE_FILE "pref:/aquarium.elfscene"
#define EXPORT_PNG_FILE "pictures:/AquariumBackground.png"

function createAquarium() {
    %obj = new ScriptGroup(Aquarium) {
        // class = "Aquarium";
    };

    return %obj;
}
//----------------------------------------------------------------------
function Aquarium::onAdd(%this) {

    SetClearBackground(BACKGROUND_COLOR); //only set once

    %this.Spritesheet = loadTextureAtlas("texture/kenney_fish-pack_2/Spritesheet/", "spritesheet-double.xml", 0.5);
    %this.Spritesheet.name = "SpriteSheet";
    %this.add(%this.Spritesheet);

    %this.showSheet = true;
    %this.paintSize = 32;
    //FIXME unused >>>>
    %this.paintRotate = 0;
    %this.paintCenterPoint = "32 32";
    %this.paintFlip = 0;
    // <<<<
    // %this.painting = false;
    %this.add( new SimGroup(SceneObjects));
    %this.placementLayer = mFloor(MAX_LAYER / 2); // start with in the middle
    %this.selectedSceneObject = 0;
    %this.add( new SimSet(SelectList));

    %this.hideSpriteSheet = false;


    %target = CreateRenderTarget(getScreenSize());
    %target.name = "RenderTarget";
    %this.add( %target );

    %this.dirty = true;

    %this.add ( new SimObject(FieldInspector));
    %this.showInspector = false;

    $Main.hideBottomMessage = true;

    // Menu
    %this.MainMenu = new SimObject() {
        class = "GuiToolMenu";
        MenuCaption = "Menu";
        MenuFontScale = 2.5;
        MenuEntries = "Save Scene" TAB "Load Scene" TAB "Export Image" TAB  "Resume" TAB "Quit";
        OnMenuObject = %this;
        OnMenuMethod = "onMainMenu";
    };

    %this.SelectObjectMenu = new SimObject() {
        class = "GuiToolMenu";
        MenuCaption = "Multiple Objects:";
        MenuFontScale = 1.5;
        OnMenuObject = %this;
        OnMenuMethod = "onSelectObject";
        MenuTextureAtlas = %this.SpriteSheet;
        MenuTextureAtlasSize = "16 16";
        MenuEntries = "";
        MenuTextureRects = "";
    };

    GuiTool.CurrentMenu = 0; //reset



    return true;
}
//----------------------------------------------------------------------
function Aquarium::OnRemove(%this) {
    GuiTool.CurrentMenu = 0; //reset
}
//----------------------------------------------------------------------
function Aquarium::OnUpdate(%this, %dt) {
}
//----------------------------------------------------------------------
//----------------------------------------------------------------------
function Aquarium::DrawSpriteSheet(%this) {
    %s = %this.Spritesheet;
    %cnt = %s.getDynamicFieldCount();
    %screenSize = getScreenSize();
    %screenSize.y /= 2;
    %x = 0; %y = 0;
    %size = 32;
    %mousePos = GetMousePosition();
    %this.cursorTexure = "";
    // BeginBlendMode();
    for (%i = 0; %i < %cnt ; %i++) {
        %f = %s.getDynamicField(%i);
        %name = getField(%f,0);
        %srcRect = getField(%f,1);
        %y += %size;
        if ( %y+%size > %screenSize.y) {
            %y = 0;
            %x += %size;
        }
        %dstRect = %x SPC %y SPC %size SPC %size;
        %s.DrawSrcDstRect(%srcRect,%dstRect, WHITEBLEND);
        if (PointInRect(%mousePos, %dstRect)) {
            // echo("inRect:" SPC %name);
            if (SDL_IsMouseButtonDown(SDL_BUTTON_LEFT)) {
                %this.selectedTexture = %name;
                %this.selectedSceneObject = 0;
            }
            %this.cursorTexure = %name;
        }

        // DrawText(%x , %y, %name,0.8);
    }
    if (%this.cursorTexure !$="")  DrawText(%mousePos.x + 8, %mousePos.y + 8,%this.cursorTexure, 1.8, "128 255 0", true, BLACK);
    // DrawText(0, %screenSize.y, "Press left shift to enter paint mode", 1.2, WHITE, true);
    // EndBlendMode();
}
//----------------------------------------------------------------------
// sort by layers higher == move to back (render first)
function compareLayers(%objA, %objB)
{
    if (%objA.layer == %objB.layer) return 0;
    return (%objA.layer > %objB.layer) ? -1 : 1;
}

//----------------------------------------------------------------------
function Aquarium::removeSceneObject(%this,%obj) {
    %obj.delete();
    %this.dirty = true;
}
//----------------------------------------------------------------------
function Aquarium::load(%this) {
    %path = getFullPath(SCENE_FILE);


    %savScene = SceneObjects.getId();
    %savScene.name = "savScene";

    if (exec(%path)) {

        GuiTool.Message = "Scene loaded from:\n" @ %path;
        warn("will delete previous scene in 100ms id:" SPC %savScene);
        // add new one to this:
        %this.add(SceneObjects);

        //update objects to current version
        foreach(%obj in SceneObjects) {
            %obj.class = "SceneObject";

            if (%obj.color $= "") {
                %obj.color = WHITEBLEND;
                // setup bleeding hack here ...
                %obj.srcRect.x += 0.5;
                %obj.srcRect.y += 0.5;
                %obj.srcRect.width -= 1;
                %obj.srcRect.height -= 1;
            }

            if (%obj.angle $= "") %obj.angle = 0;

            if (%obj.centerPoint $= "")
                %obj.centerPoint = %obj.dstRect.width / 2 SPC %obj.dstRect.height / 2;

            if (%obj.flip $= "") %obj.flip = 0;
        }


        // delete prev:
        %savScene.schedule(100, delete);
    } else {
        GuiTool.Message = "[error] Failed to load Scene from:\n" @ %path;
        %savScene.name = SceneObjects; //restore saved scene
        warn("Saved Scene restored:" SPC SceneObjects.getId() SPC "==" SPC %savScene);
    }
    %this.dirty = true;


}

//----------------------------------------------------------------------
function Aquarium::onSelectObject(%this, %menuId, %menuCaption) {

    // echo("LIST:"); SelectList.listObjects();

    %obj = SelectList.getObject(%menuId);
    %this.selectedSceneObject = %obj;
    SelectList.clear();
    GuiTool.CurrentMenu = 0;

    // warn("SELECT " SPC %menuId SPC  %menuCaption SPC "=>" SPC %obj);
}
//----------------------------------------------------------------------
function Aquarium::onMainMenu(%this, %menuId, %menuCaption) {
    switch$ (%menuCaption) {

        case "Save Scene":
            GuiTool.CurrentMenu = 0;
            %path = getFullPath(SCENE_FILE);
            if (SceneObjects.save(%path)) GuiTool.Message = "Scene saved to:\n" SPC %path;
            else GuiTool.Message = "[error] Failed to save Scene to:\n" SPC %path;
            %this.dirty = true;

        case "Load Scene":
            GuiTool.CurrentMenu = 0;
            %this.load();

        case "Export Image":
            GuiTool.CurrentMenu = 0;

            %path = getFullPath(EXPORT_PNG_FILE);
            if (RenderTarget.saveImage(%path))
                GuiTool.Message = "Image exported to:\n" @ %path;
        else
            GuiTool.Message = "[error]Failed to export Image to:\n" @ %path;

        case "Resume":
            GuiTool.CurrentMenu = 0;

        case "Quit": schedule(250,0, quit);

    } //switch
}

//----------------------------------------------------------------------
function Aquarium::Render(%this) {

    if (%this.showInspector && %this.selectedSceneObject != 0) FieldInspector.render();

    %screenSize = getScreenSize();
    %mousePos = GetMousePosition();
    %haveSelected = %this.selectedTexture !$= "";

    %haveOverlay =  GuiTool.haveOverlay();

    if (%this.dirty /*|| %this.selectedSceneObject != 0*/) {
        if (!SetRenderTarget(RenderTarget.getId()))  { error("Failed to set RenderTarget to " SPC  RenderTarget.getId());}
        ClearBackground(BACKGROUND_COLOR);

        foreach(%obj in SceneObjects) {
            Spritesheet.DrawRotatedSrcDstRect(%obj.srcRect,
                                              %obj.dstRect,
                                              %obj.angle,
                                              %obj.centerPoint,
                                              %obj.flip,
                                               %obj.color
                                              );
            // if (SDL_IsKeyDown(SDL_SCANCODE_LCTRL)) DrawText(%obj.dstRect.x + 1 ,%obj.dstRect.y + 1, %obj.Layer , 1.0, YELLOW, true);
            // if (!%haveSelected && !%haveOverlay && SDL_IsMouseButtonPressed(SDL_BUTTON_LEFT)) {
            //     if (PointInRect(%mousePos, %obj.dstRect)) %this.selectedSceneObject = %obj;
            // }
            //
            // if (%this.selectedSceneObject == %obj) {
            //     DrawRectRec(%obj.dstRect, ORANGE, false);
            //     if (SDL_IsKeyPressed(SDL_SCANCODE_DELETE)) {
            //         %this.selectedSceneObject = 0;
            //         %this.schedule(100, removeSceneObject, %obj);
            //     }
            // }
        }
        SetRenderTarget(0);
        %this.dirty = false;
    }

     if (!%this.dirty && !%haveOverlay) {
        RenderTarget.DrawRect("0 0" SPC RenderTarget.getSize());
        %mouseDown = SDL_IsMouseButtonPressed(SDL_BUTTON_LEFT);
        %deletePressed = SDL_IsKeyPressed(SDL_SCANCODE_DELETE);
        %lctrlPressed = SDL_IsKeyDown(SDL_SCANCODE_LCTRL);
        %lshiftPressed = SDL_IsKeyDown(SDL_SCANCODE_LSHIFT);
        if (%mouseDown   )  {
            %this.selectedSceneObject = 0;
            FieldInspector.inspect(0);
            SelectList.clear();
        }
        if (%mouseDown || %deletePressed || %lctrlPressed || %lshiftPressed || %this.selectedSceneObject != 0) {

            if (%this.selectedSceneObject != 0) {

                DrawText(10,%screenSize.y - 30, "DEL delete, 1-4 flip, wheel rotate, F10 Inspector", 2, BLUE, true);

                %wheel = SDL_GetMouseWheelY();
                if ( %wheel != 0 ) {
                    %this.selectedSceneObject.angle += SDL_GetMouseWheelY();

                    %this.dirty = true;
                }
                if (SDL_IsKeyPressed(SDL_SCANCODE_1))  {
                    %this.selectedSceneObject.flip = 0;
                    %this.dirty = true;
                }
                if (SDL_IsKeyPressed(SDL_SCANCODE_2))  {
                    %this.selectedSceneObject.flip = 1;
                    %this.dirty = true;
                }
                if (SDL_IsKeyPressed(SDL_SCANCODE_3))  {
                    %this.selectedSceneObject.flip = 2;
                    %this.dirty = true;
                }
                if (SDL_IsKeyPressed(SDL_SCANCODE_4))  {
                    %this.selectedSceneObject.flip = 3;
                    %this.dirty = true;
                }
            }

            foreach(%obj in SceneObjects) {
                if (%lctrlPressed) {
                    DrawText(%obj.dstRect.x + 1 ,%obj.dstRect.y + 1, %obj.Layer , 1.0, YELLOW, true);
                }


                if (!%haveSelected && !%haveOverlay && %mouseDown) {
                    if (PointInRect(%mousePos, %obj.dstRect)) {
                        %this.selectedSceneObject = %obj;
                        FieldInspector.inspect(%obj.getId());
                        SelectList.add(%obj);
                    }

                }

                if (%this.selectedSceneObject == %obj) {
                    DrawRectRec(%obj.dstRect, ORANGE, false);
                    if (%deletePressed) {
                        %this.selectedSceneObject = 0;
                        FieldInspector.inspect(0);
                        %this.schedule(100, removeSceneObject, %obj);
                    }
                }
            } //foreach
        }
    }

    if (SelectList.getCount() > 1 && %mouseDown) {
        warn("Multiple Objects found at mouse position:");

        %this.SelectObjectMenu.MenuEntries = "";
        %this.SelectObjectMenu.MenuTextureRects = "";

        foreach( %obj in SelectList ) {
            %this.SelectObjectMenu.MenuEntries = trim( %this.SelectObjectMenu.MenuEntries TAB %obj.getId());
            %this.SelectObjectMenu.MenuTextureRects = trim( %this.SelectObjectMenu.MenuTextureRects TAB %obj.srcRect );
        }
        GuiTool.CurrentMenu =  %this.SelectObjectMenu;


    }



    if (!%haveSelected) {
       if (!%this.hideSpriteSheet && !%haveOverlay) %this.DrawSpriteSheet();
       if (SDL_IsKeyPressed(SDL_SCANCODE_SPACE)) %this.hideSpriteSheet = !%this.hideSpriteSheet;
    } else if (!%haveOverlay){
        %srcRect = Spritesheet.getFieldValue(%this.selectedTexture);
        %dstRect = (%screenSize.x - PREVIEW_SIZE) SPC 0 SPC PREVIEW_SIZE SPC PREVIEW_SIZE;
        if (SHOW_PREVIEW) {
            if (PointInRect(%mousePos, %dstRect)) {
                %dstRect.x -= PREVIEW_SIZE * 2;
            }
            Spritesheet.DrawSrcDstRect(%srcRect,%dstRect, WHITEBLEND);
            DrawRectRec(%dstRect, BLACK, false);
        }


        %wheel = SDL_GetMouseWheelY();
        if (%wheel != 0) {
//FIXME paintRotate + paintCenterPoint + paintFlip
            if (SDL_IsKeyDown(SDL_SCANCODE_LCTRL)) {
                %this.placementLayer += %wheel;
                if (%this.placementLayer < 0) %this.placementLayer = 0;
                if (%this.placementLayer > MAX_LAYER) %this.placementLayer = MAX_LAYER;

            } else  {
                %this.paintSize += SCALE_SNAP * %wheel;
                if (%this.paintSize < SCALE_SNAP )  %this.paintSize = SCALE_SNAP;
                if (%this.paintSize > MAX_SCALE )  %this.paintSize = MAX_SCALE;
            }

        }


        %halvPaintSize =  %this.paintSize / 2;
        if (SDL_IsKeyDown(SDL_SCANCODE_LSHIFT)) {
            // Snap to grid
            %gridSize = SCALE_SNAP; // %this.paintSize;

            %snapX = mFloor((%mousePos.x - %halvPaintSize) / %gridSize) * %gridSize;
            %snapY = mFloor((%mousePos.y - %halvPaintSize) / %gridSize) * %gridSize;

            %maxX = getWord(%screenSize, 0) - %this.paintSize;
            %maxY = getWord(%screenSize, 1) - %this.paintSize;

            %snapX = mClamp(%snapX, 0, %maxX);
            %snapY = mClamp(%snapY, 0, %maxY);

            %dstRect = %snapX SPC %snapY SPC %this.paintSize SPC %this.paintSize;

        } else {
            %dstRect = (%mousePos.x - %halvPaintSize) SPC (%mousePos.y - %halvPaintSize) SPC %this.paintSize SPC %this.paintSize;
        }
        Spritesheet.DrawSrcDstRect(%srcRect,%dstRect, WHITEBLEND);
        DrawText(%dstRect.x + 1 , %dstRect.y + 1, %this.paintSize SPC "/" SPC %this.placementLayer , 1.0);

        if (!%haveOverlay && SDL_IsMouseButtonPressed(SDL_BUTTON_LEFT)) {

            // FIXME: flip and rotate

            SceneObjects.add(
                new SimObject() {
                    class = "SceneObject";
                    TypeRectF srcRect = %srcRect;
                    TypeRectF dstRect = %dstRect;
                    TypeF32 angle = 0;
                    TypeF32 centerPoint = %dstRect.width / 2 SPC %dstRect.height / 2;
                    TypeColor color=WHITEBLEND;
                    TypeS32 flip = 0;
                    TypeF32   layer = %this.placementLayer; //higher = rendered first
                });
            SceneObjects.sort("compareLayers");
            %this.dirty = true;
        }

        if ( SDL_IsMouseButtonPressed(SDL_BUTTON_RIGHT)) {
            %this.selectedTexture = "";
            // %this.painting = false;
        }
        DrawText(5, 5, "shift = snap to grid, wheel = size, ctrl+wheel = layer, right click = select", 1.2, WHITE, true);
    }


    GuiTool.Render(%screenSize);


    // if (%this.showMenu) {
    //     %menuWidth = 300;
    //     %menuHeight = 300;
    //     %x =  %screenSize.x / 2 - %menuWidth / 2;
    //     %y = %screenSize.y / 2 - %menuHeight / 2;
    //     %menuRect = %x SPC %y  SPC %menuWidth SPC %menuHeight;
    //     BeginBlendMode();
    //     DrawRectRec(%menuRect, "20 20 20 200"  );
    //     EndBlendMode();
    //     DrawRectRec(%menuRect, "200 200 200", false );
    //
    //     %x += 25;
    //     %y += 15;DrawText(%x, %y, "Menu", 2.5, GRAY);
    //     %y += 25; DrawLine(%x, %y, %x+250, %y, GRAY );
    //     // Button Save
    //     %y += 15;%rect = %x - 5 SPC  %y - 5 SPC 250 SPC 30;
    //     if (GuiTool.MenuEntry(%rect, "Save Scene")) {
    //         %this.showMenu = false;
    //         %path = getFullPath(SCENE_FILE);
    //         if (SceneObjects.save(%path)) GuiTool.Message = "Scene saved to:\n" SPC %path;
    //         else GuiTool.Message = "[error] Failed to save Scene to:\n" SPC %path;
    //         %this.dirty = true;
    //     }
    //     // Button Load
    //     %y += 40;%rect = %x - 5 SPC  %y - 5 SPC 250 SPC 30;
    //     if (GuiTool.MenuEntry(%rect, "Load Scene")){
    //         %this.showMenu = false;
    //         %this.load();
    //
    //     }
    //
    //     // Button Export
    //     %y += 40;%rect = %x - 5 SPC  %y - 5 SPC 250 SPC 30;
    //     if (GuiTool.MenuEntry(%rect, "Export Image")){
    //         %this.showMenu = false;
    //
    //         %path = getFullPath(EXPORT_PNG_FILE);
    //         if (RenderTarget.saveImage(%path))
    //             GuiTool.Message = "Image exported to:\n" @ %path;
    //         else
    //             GuiTool.Message = "[error]Failed to export Image to:\n" @ %path;
    //     }
    //
    //     // Button Resume
    //     %y += 40;%rect = %x - 5 SPC  %y - 5 SPC 250 SPC 30;
    //     if (GuiTool.MenuEntry(%rect, "Resume")) %this.showMenu = false;
    //
    //     // Button QUIT
    //     %y += 40;%rect = %x - 5 SPC  %y - 5 SPC 250 SPC 30;
    //     if (GuiTool.MenuEntry(%rect, "Quit")) schedule(250,0, quit);
    //
    // }

}

function SceneObject::onInspectPostApply(%this) {
    echo("onInspectPostApply" SPC %this);
    Aquarium.dirty = true;
    SceneObjects.sort("compareLayers");
}
//----------------------------------------------------------------------
function Aquarium::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) {
    if (%isDown) {
        if (%scancode == SDL_SCANCODE_ESCAPE) {
            if (GuiTool.CurrentMenu == 0) GuiTool.CurrentMenu =%this.MainMenu;
            else GuiTool.CurrentMenu = 0;
        }
        if (%scancode == SDL_SCANCODE_F10) %this.showInspector = !%this.showInspector;
    }
}
function Aquarium::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {
    if (%isDown) {
    }
}
function Aquarium::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){}
