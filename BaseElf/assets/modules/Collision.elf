#define PLAYER_SIZE "16 16"

function createCollision() {
    %obj = new Group() {
        class = "Collision";
        TypeS32 player = 0;
    };

    return %obj;
}
//----------------------------------------------------------------------
function Collision::spawnPlayer(%this, %position) {
    if (%position $= "") %position = "550 130";
    echo("Spawn player at:" SPC %position);
    if (isObject(%this.player)) %this.player.delete();
    %this.add( %this.player = new SpriteObject() {
        x = %position.x;
        y = %position.y;
        veloX = $shift ? getRandom(-5, 5): 0;
        veloY = 10;
        color = getRandom(0,255) SPC getRandom(0,255) SPC getRandom(0,255) SPC getRandom(32,255);
        width = PLAYER_SIZE;
        height = PLAYER_SIZE;
    });

    %this.player.dumpFields();
    $p = %this.player; //debug global
}
//----------------------------------------------------------------------
function Collision::onAdd(%this) {
    SetClearBackground(SLATEGRAY); //only set once

    // cat face ;)
    %this.lines = new Array();
    %this.lines.push_back({150, 150, 400, 250});
    %this.lines.push_back({1000, 150, 750, 250});
    %this.lines.push_back({576, 220, 500, 300});
    %this.lines.push_back({576, 220, 652, 300});
    %this.lines.push_back({300, 350, 450, 320});
    %this.lines.push_back({850, 350, 700, 320});
    %this.lines.push_back({450, 420, 520, 480});
    %this.lines.push_back({520, 480, 576, 420});
    %this.lines.push_back({576, 420, 632, 480});
    %this.lines.push_back({632, 480, 702, 420});
    %this.lines.push_back({150, 150, 400, 250});


    return true;
}
//----------------------------------------------------------------------
function Collision::OnRemove(%this) {
}
//----------------------------------------------------------------------
function Collision::OnUpdate(%this, %dt) {
}

//----------------------------------------------------------------------
function Collision::Render(%this) {
    %playerSpawned =  isObject(%this.player);
    %p = %this.player;
    if (%playerSpawned) {
        // %p.moveGravity(0, 9.81);
        %p.moveGravity(0.0 , 30.0);
    }

    foreach(%line in %this.lines) {
        DrawLineRec(%line, BLUE);
        if (%playerSpawned && %p.solveCollideLine(%line, 0.5)) {
            %collided = true;
        }
    }

    if (%playerSpawned) {
        %pos = %p.getCenter2F();
        DrawCircle(%pos.x,%pos.y,%p.width / 2, %collided ? RED : YELLOW);
    }
}

//----------------------------------------------------------------------
function Collision::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) {
   $Shift =  (%modifiers & SDL_KMOD_SHIFT);
}
function Collision::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {
    if (%isDown && %button == SDL_BUTTON_LEFT)  {
        %this.spawnPlayer(%x SPC %y);
    }
}
function Collision::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){}
