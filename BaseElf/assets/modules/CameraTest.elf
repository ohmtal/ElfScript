//----------------------------------------------------------------------
exec ("include/TextureAtlas.elf");
#define SCENE_FILE "pref:/aquarium.elfscene"
//----------------------------------------------------------------------
function createCameraTest() {
    %obj = new ScriptGroup(CameraTest) {
        // class = "CameraTest";
    };

    return %obj;
}
//----------------------------------------------------------------------
function CameraTest::onAdd(%this) {
    SetClearBackground("160 160 200"); //only set once

    %this.Spritesheet = loadTextureAtlas("texture/kenney_fish-pack_2/Spritesheet/", "spritesheet-double.xml", 0.5);
    %this.Spritesheet.name = "SpriteSheet";
    %this.add(%this.Spritesheet);


    %this.add( new SimSet(BubbleSet));

    // we load our saved aquarium if any.
    %path = getFullPath(SCENE_FILE);
    if (SDL_FileExists(%path)) exec(%path);

    // Fallback we did not load anything
    if (!isObject(SceneObjects)) {
        new SpriteGroup(SceneObjects);

        SceneObjects.add(
            new SpriteBaseObject(MyFish) {
                srcRect = SpriteSheet.fish_brown;
                dstRect = "100 100 128 128";
            }
        );
    } else {
        // i want MyFish ;)
        foreach(%obj in SceneObjects) {
            if (%obj.textureName $= "fish_brown_outline") {
                %obj.name = MyFish;
                %obj.savColor = %obj.color;
                %obj.savDstRect = %obj.dstRect;
                %obj.savLayer = %obj.layer;
                // break;
            }
            if (%obj.textureName $= "bubble_a") {
                %obj.veloY = getRandom(-20, -50);
                BubbleSet.add(%obj);
            }
        }

    }

    MyFish.veloX = 100.0;
    %this.add(SceneObjects);

    %this.add( new Camera2DObject(Camera));


    return true;
}
//----------------------------------------------------------------------
function CameraTest::OnRemove(%this) {
}
//----------------------------------------------------------------------
function CameraTest::OnUpdate(%this, %dt) {

    MyFish.moveLinear(%dt);
    if (MyFish.x > 1200) {
        MyFish.x = 1200;
        MyFish.veloX = -100.0;
        MyFish.flip = 1;
    } else if (MyFish.x < -300) {
        MyFish.x = -300;
        MyFish.veloX = 100.0;
        MyFish.flip = 0;
    }

    foreach(%bubble in BubbleSet) {
        %bubble.moveLinear(%dt);
        // %bubble.moveGravity(0,-200);
        // %bubble.moveOrbital(MyFish.getCenter2F(), -50);
        if (%bubble.y < -30) {
            %bubble.y = 480;
            %bubble.x = getRandom(20, 1100);
            %bubble.veloY = getRandom(-20, -50);
            %bubble.velox = 0.0;
        }
    }


    %speed = %dt * 100;
    if (SDL_IsKeyDown(SDL_SCANCODE_LEFT))     Camera.x -= %speed;
    if (SDL_IsKeyDown( SDL_SCANCODE_RIGHT))    Camera.x += %speed;
    if (SDL_IsKeyDown( SDL_SCANCODE_UP))       Camera.y -= %speed;
    if (SDL_IsKeyDown( SDL_SCANCODE_DOWN))     Camera.y += %speed;
    if (SDL_IsKeyDown( SDL_SCANCODE_PAGEUP)) {
        Camera.zoom -= %dt;
        Camera.zoom = mClampF(Camera.zoom, 0.1, 5.0);
    }
    if (SDL_IsKeyDown( SDL_SCANCODE_PAGEDOWN)) {
        Camera.zoom += %dt;
        Camera.zoom = mClampF(Camera.zoom, 0.1, 5.0);
    }
    if (SDL_IsKeyPressed( SDL_SCANCODE_SPACE)) {
        Camera.reset();
    }


    // testing only the Camera.GetMousePosition => not the smartest way on every update:
    if (isObject(MyFish) && PointInRect(Camera.GetMousePosition(), MyFish.dstRect) ) {
        if (MyFish.layer > 0) {
            playSound("sound/beep.wav");
            MyFish.color = "128 255 0 254";
            // MyFish.x = MyFish.savDstRect.x - 10;
            // MyFish.y = MyFish.savDstRect.y - 10;
            // MyFish.width  = MyFish.savDstRect.width + 20;
            // MyFish.height = MyFish.savDstRect.height + 20;
            MyFish.layer = 0;
            SceneObjects.sortLayers();
        }

    } else {
        if (MyFish.layer == 0) {
            MyFish.color = MyFish.savColor;
            // MyFish.dstRect = MyFish.savDstRect;
            MyFish.layer = MyFish.savLayer;
            SceneObjects.sortLayers();
        }
    }

}
//----------------------------------------------------------------------
function CameraTest::Render(%this) {

    SceneObjects.drawAtlasBatch(Spritesheet.getId(), Camera.getId());


    // Example how to do it manually ... drawAtlasBatch does it all for me
    // %obj = MySprite.getId();
    //NOTE translate dstRect to screenRect and centerPoint to screenCenterPoint
    // %doRender = Camera.TranslateSpriteBaseObject(%obj);
    // if (%doRender) {
    //     Spritesheet.DrawRotatedSrcDstRect(%obj.srcRect,
    //                                       %obj.screenRect, //NOTE this!
    //                                       %obj.angle,
    //                                       %obj.screenCenterPoint, //NOTE and this!
    //                                       %obj.flip,
    //                                       %obj.color
    //     );
    // }



    %y = 10;
    DrawText(10,%y, "Mouse:" SPC GetMousePosition() SPC "/" SPC Camera.GetMousePosition(), 1.2, WHITE);
    %y += 15; DrawText(10,%y, "CAM:" SPC Camera.x SPC Camera.y SPC Camera.zoom , 1.2, WHITE);
    // %y += 15; DrawText(10,%y, "ScreenRect:" SPC %obj.screenRect, 1.2, WHITE);
}
//----------------------------------------------------------------------
function CameraTest::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) {}
function CameraTest::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {}
function CameraTest::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){}
