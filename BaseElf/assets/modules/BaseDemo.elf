exec("include/AtlasFont.elf");

#define LOGO_SPAWN_RATE 50
#define LOGO_START_SPEED 100
#define MAG_DIR_VALUE 15
#define MAG_MAX 5000
//----------------------------------------------------------------------
function createBaseDemo() {
    %obj = new Group() {
        class = "BaseDemo";
        TypeF32 magDirection = 0.0;
        TypeF32 magnetism = 0.0;
        TypeS32 GrayTexture = 0;
        TypeS32 IconTexture = 0;
        TypeS32 logoList = 0;

        TypeF32 _border   = 60.0;
        TypeF32 _logoSize = 32.0;
        TypeF32 logoHalfSize = 16.0;
        TypeF32 _bouncy   = 6.66;
    };

    return %obj;
}
//----------------------------------------------------------------------
function BaseDemo::onAdd(%this) {
    SetClearBackground( SEABLUE ); //set background color
    %this.add ( %this.IconTexture = new TextureObject() { fileName = "texture/icon_32.png"; } );
    %this.add ( %this.GrayTexture =  new TextureObject() { fileName = "texture/icon_32_gray.png"; });

    %this.logoList = new Group(LogoList);
    %this.add(%this.logoList);

    %this.magDirection = MAG_DIR_VALUE;
    $showBla =1;


    %f = new TextureObject(FontTerminatorTwo) {
        class = "AtlasFont";
        // fileName = "texture/fonts/kenney_mini_24x40.png";
        // fileName = "texture/fonts/kenney_blocks_36x48.png";
        // fileName = "texture/fonts/source_code_32x60.png";
        fileName = "texture/fonts/terminatortwo_45x48.png";
    };
    %this.add(%f);
    %f = new TextureObject(FontKenneyBlocks) {
        class = "AtlasFont";
        fileName = "texture/fonts/kenney_blocks_36x48.png";
    };
    %this.add(%f);

    return true;
}
//----------------------------------------------------------------------
function BaseDemo::OnRemove(%this) {

}
//----------------------------------------------------------------------
function BaseDemo::OnUpdate(%this, %dt) {
}

//----------------------------------------------------------------------
function BaseDemo::Render(%this) {
    %borders = GetScreenSize();
   if ($showBla) {
        %y = 20;
        %x = 10;
        if (isObject(%this.IconTexture)) {
             %this.IconTexture.DrawRotatedCentered( %x + 16,%y + 8, mFmod( getGameTime() * 150, 359)  );
        }

        %fontScale = 1.25;
        %addY = 14;

        DrawText(%x + 40,%y,"BaseElf - ElfScript on SDL3 (+BaseFlux) and ImGui", 2.1, WHITE, true, SLATEGRAY);
        %y+= 30;DrawText(%x,%y,"[X] ConsoleTypes and Colors", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] ClearBackground", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] DrawText", %fontScale, GREEN, true, SLATEGRAY);
        //not needed  %y+= %addY;DrawText(%x,%y,"[ ] SetColor", %fontScale, WHITE, true, SLATEGRAY);
        //not needed  %y+= %addY;DrawText(%x,%y,"[ ] SetScale", %fontScale, WHITE, true, SLATEGRAY);
        //not needed  %y+= %addY;DrawText(%x,%y,"[ ] DrawPoint", %fontScale, WHITE, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] DrawLine", %fontScale, GREEN, true, SLATEGRAY);
        DrawLine(200, %y, 400, %y+10,RED);
        %y+= %addY;DrawText(%x,%y,"[X] DrawRect", %fontScale, GREEN, true, SLATEGRAY);
        DrawRect(195, %y,10,10,RED,false);
        DrawRect(215, %y,10,10,BLUE,true);
        %y+= %addY;DrawText(%x,%y,"[X] DrawCircle", %fontScale, GREEN, true, SLATEGRAY);
        DrawCircle(200, %y+5, 5,RED,false);
        DrawCircle(220, %y+5, 5,BLUE,true);
        %y+= %addY;DrawText(%x,%y,"[X] DrawArc", %fontScale, GREEN, true, SLATEGRAY);
        DrawArc(200, %y+5, 5, 0,mDegToRad(180),RED,false);
        DrawArc(220, %y+5, 5, mDegToRad(180),mDegToRad(359),BLUE,TRUE);
        %y+= %addY;DrawText(%x,%y,"[X] DrawDonut", %fontScale, GREEN, true, SLATEGRAY);
        DrawDonut(200, %y+5, 3, 6,RED,false);
        DrawDonut(220, %y+5, 3, 6,BLUE,true);
        %y+= %addY;DrawText(%x,%y,"[X] GetWindowSize" SPC GetWindowSize(), %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] TextureObject", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X/X] Texture object needs color and getSize()", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] SoundObject", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] BaseFlux Settings window size/vsync/appname/icon/...", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] Basic GameObject hold positon/velocity and color", %fontScale, GREEN, true, SLATEGRAY);
        %measure = MeasureText("[X] Basic GameObject hold positon/velocity and color", %fontScale);
        DrawLine(%x, %y + %measure.y / 2,%x + %measure.x, %y + %measure.y / 2, LIGHTGRAY);
        // %y+= %addY;DrawText(%x,%y,"[ ] load assets/main.elf from current folder.", %fontScale, WHITE, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] create web build", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] primitives Draw color ignore alpha! << BeginBlendMode/EndBlendMode", %fontScale, GREEN, true, SLATEGRAY);
        BeginBlendMode();
        DrawRect(%x, %y - 5, %borders.x - 2 * %x, 20, "20 20 20 80");
        EndBlendMode();
        DrawRect(%x, %y - 5, %borders.x - 2 * %x, 20, "155 155 155 255", false);
        %y+= %addY;DrawText(%x,%y,"[X] Texture rotate", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] atlas font script", %fontScale, GREEN, true, SLATEGRAY);
        // %y+= %addY;DrawText(%x,%y,"[ ] add source editor with example", %fontScale, DARKGRAY, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] SDL_SetRenderTarget / create target TextureObject +SDL_SavePNG", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] (Base)SpriteObject with movement and collision", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] Camera2D Object", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] Add SDL_BLENDMODE_* to TextureObject draw calls", %fontScale, GREEN, true, SLATEGRAY);
        %y+= %addY;DrawText(%x,%y,"[X] Test Lights with SDL_BLENDMODE_ADD", %fontScale, GREEN, true, SLATEGRAY);

        %y+=20;
        FontTerminatorTwo.DrawAnimatedText(%x, %y, "Hello AtlasFont using TextureObject's getAtlasRect","255 200 100 100", GetGameTime() , $FONT_EFFECT_WAVE);

        %y+=30;
        // FontKenneyBlocks.drawText(%x, %y, "using different fonts... exported with OhmFlux BitmapFont Tool","0 200 255 254");
        FontKenneyBlocks.DrawAnimatedText(%x, %y
                ,"using different fonts... exported with OhmFlux BitmapFont Tool"
                ,"0 200 255 254",
                 GetGameTime() ,
                $FONT_EFFECT_RAINBOW
        );



        %y+= 60;DrawText(%x,%y,"right click for fun ;)", 1.5, ORANGE, true, SLATEGRAY);
    } else {

        // physic playground -----------------

        %dt = GetFrameTime();
         %cnt = %this.logoList.getCount();

        $ticker++;

        %bx = %borders.x - %this._border; %by = %borders.y -%this._border;
        %cp = (%bx - %this._border) / 2 SPC (%by - %this._border) / 2 SPC 0;
        // %cp = (%bx - %this._border) / 2 SPC (%by - %this._border)  SPC 0;
        // echo(%cp);

        // is half ...
        #define TEX_SIZE 16

        DrawRect(%this._border - TEX_SIZE, %this._border - TEX_SIZE, %bx - %this._border + TEX_SIZE * 2, %by - %this._border + TEX_SIZE * 2, "10 10 10 255");
        DrawRect(%this._border - TEX_SIZE, %this._border - TEX_SIZE, %bx - %this._border + TEX_SIZE * 2, %by - %this._border + TEX_SIZE * 2, WHITE, false);


        %this.magnetism += %this.magDirection;
        if ( %this.magnetism > MAG_MAX ) %this.magDirection = -MAG_DIR_VALUE;
        else if ( %this.magnetism < -MAG_MAX ) {
            %this.magDirection = MAG_DIR_VALUE;
            // %this.impulse();
        }

        %damping = %this._bouncy; //1

        DrawCircle(%cp.x, %cp.y, mAbs(%this.magnetism) / 50,  %this.magnetism < 0 ? RED : ORANGE);
        if (%this.magDirection > 0) DrawLine(%this._border, %by, %bx, %by , ORANGE);
        else  DrawLine(%this._border, %this._border, %bx, %this._border, ORANGE);

        %mag = %this.magnetism / 200;
        foreach(%logo in %this.logoList ) { //much faster than for/getObject
            // %logo.moveLinear();
            %logo.moveGravity(0, 4 * %this.magDirection);
            %logo.moveOrbital(%cp, %mag , 5, LOGO_START_SPEED );

            // if (%logo.solveCollideRect({0.0,0.0,}))

            if ($ticker % 2 == 0) {
                if (%logo.x <= %this._border ) { %logo.VeloX *= -%damping; %logo.x = %this._border;}
                else if ( %logo.x >= %bx - %this._logoSize) { %logo.VeloX *= -%damping; %logo.x = %bx - %this._logoSize - 0.01;}
                if (%logo.y <= %this._border)  { %logo.VeloY *= -%damping; %logo.y = %this._border;}
                else if ( %logo.y >= %by - %this._logoSize) { %logo.VeloY *= -%damping; %logo.y = %by - %this._logoSize - 0.01; }
            }
            %logo.Draw();
        }

        // -----------------

        DrawText(80,0, %cnt SPC "magdir:" SPC %this.magDirection SPC "mag:" SPC %this.magnetism ,2, "100 100 150");
    }

    DrawFPS(0,0);
}
//----------------------------------------------------------------------
function BaseDemo::impulse(%this) {

    foreach(%logo in %this.logoList ) {
        %logo.veloX = getRandom(-LOGO_START_SPEED * 5,LOGO_START_SPEED * 5);
        %logo.veloY = getRandom(-LOGO_START_SPEED * 5,LOGO_START_SPEED * 5);
    }
}
//----------------------------------------------------------------------
function BaseDemo::addLogo(%this,%x,%y) {

    %logo = new SpriteObject() {
        x = %x;
        y = %y;
        veloX = getRandom(-LOGO_START_SPEED,LOGO_START_SPEED);
        veloY = getRandom(-LOGO_START_SPEED,LOGO_START_SPEED);
        color = getRandom(0,255) SPC getRandom(0,255) SPC getRandom(0,255) SPC getRandom(32,255);
        width = %this._logoSize;
        height = %this._logoSize;
        textureObjectId = %this.GrayTexture.getId();
    };
    %this.logoList .add(%logo);

}
//----------------------------------------------------------------------
function BaseDemo::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) {}
function BaseDemo::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {
    if (%isDown == 1) {
        if (%button == SDL_BUTTON_RIGHT) {
            $showBla = 0;
            for (%i = 0; %i < LOGO_SPAWN_RATE; %i++) %this.addLogo(%x, %y);
        } else  if (%button == SDL_BUTTON_LEFT) {
            %this.impulse();
        }
    }
}
function BaseDemo::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){}

