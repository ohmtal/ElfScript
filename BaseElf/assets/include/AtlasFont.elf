// AtlasFont must be a TextureObject
// assuming the AtlasFont's grid is 10x10

//FIXME move this to a Cpp !!!
$FONT_EFFECT_WAVE=1;
$FONT_EFFECT_SHAKE=2;
$FONT_EFFECT_RAINBOW=3;
$FONT_EFFECT_PULSE=4;

// to export it i used my Bitmap Font Tool:
//  https://github.com/ohmtal/OhmFlux/tree/main/Tools/BitmapFont/qt

function AtlasFont::onAdd(%this) {
    %this.StartChar = 32;
    %this.EndChar   =  127;
    %this.CharWidth = 16;
    %this.CharHeight = 32;

    if (!%this.isField("rowCount")) %this.rowCount = 10;
    if (!%this.isField("colCount")) %this.colCount = 10;
    %size = %this.getSize();
    %this.FrameWidth = %size.x / %this.rowCount;
    %this.FrameHeight = %size.y / %this.colCount;

}


// now in c++ ==>  function getAtlasRect( int colCount, int rowCount, int index );
// OBSOLETE use getAtlasRect
function AtlasFont::getSrcRect(%this, %index) {
    %col = %index % (%this.rowCount);
    %row = mFloor(%index / %this.colCount) ;

    %h = %this.FrameHeight;
    %w = %this.FrameWidth;


    %srcRect = "0 0 0 0";
    %srcRect.x = %col * %w;
    %srcRect.y = %row * %h;
    %srcRect.z = %w;
    %srcRect.w = %h;

    // echo("index:" SPC %index SPC "gridpos: " SPC %col SPC %row SPC "result:" SPC %srcRect);
    return %srcRect;
}


// this is the most boring way to handle the single chars ;)

function AtlasFont::DrawText(%this, %x, %y, %text, %color) {

    %len = strlen(%text);
    %cw = %this.CharWidth;
    %ch = %this.CharHeight;
    %cols = %this.rowCount;
    %rows = %this.colCount;
    %start = %this.StartChar;
    %end = %this.EndChar;
    if (%len == 0) return;
    for (%i = 0; %i < %len; %i++) {
        %c = getSubStr(%text, %i, 1);
        %asc = strasc(%c);
        if (%asc >= %start && %asc <= %end) {
            %index = %asc - %start;
            %srcRect = %this.getAtlasRect(%cols, %rows, %index);
            %dstRect = %x + %i * %cw SPC %y SPC %cw SPC %ch;
            %this.DrawSrcDstRect(%srcRect, %dstRect, %color);
        }
    }
}

// ------------------------ animatated text ---------------------------------

// Animtypes: "wave", "shake", "rainbow", "pulse" << FONT_EFFECT_*
// GetGameTime() can be used for time but you can also change the speed by multiply it

function AtlasFont::DrawAnimatedText(%this, %x, %y, %text, %baseColor, %time, %animType) {
    %len = strlen(%text);
    if (%len == 0) return;

    %cw = %this.CharWidth;
    %ch = %this.CharHeight;
    %cols = %this.rowCount;
    %rows = %this.colCount;
    %start = %this.StartChar;
    %end = %this.EndChar;

    for (%i = 0; %i < %len; %i++) {
        %c = getSubStr(%text, %i, 1);
        %asc = strasc(%c);

        if (%asc >= %start && %asc <= %end) {
            %index = %asc - %start;
            %srcRect = %this.getAtlasRect(%cols, %rows, %index);

            %curX = %x + %i * %cw;
            %curY = %y;
            %curColor = %baseColor;

            if (%animType == $FONT_EFFECT_WAVE) {
                %offsetY = mSin(%time * 5.0 + %i * 0.5) * 10.0;
                %curY += %offsetY;
            }
            else if (%animType == $FONT_EFFECT_SHAKE) {
                %curX += getRandom(-2, 2);
                %curY += getRandom(-2, 2);
            }
            else if (%animType == $FONT_EFFECT_RAINBOW) {
                %hue = mFmod((%time * 50.0) + (%i * 20.0), 360.0);
                %curColor = getColorFromHSV(%hue, 1.0, 1.0);
            }
            else if (%animType == $FONT_EFFECT_PULSE) {
                %scale = 1.0 + mSin(%time * 4.0) * 0.15;
                %scaledW = %cw * %scale;
                %scaledH = %ch * %scale;
                %curX -= (%scaledW - %cw) / 2;
                %curY -= (%scaledH - %ch) / 2;

                %dstRect = %curX SPC %curY SPC %scaledW SPC %scaledH;
                %this.DrawSrcDstRect(%srcRect, %dstRect, %curColor);
                continue;
            }

            %dstRect = %curX SPC %curY SPC %cw SPC %ch;
            %this.DrawSrcDstRect(%srcRect, %dstRect, %curColor);
        }
    }
}

