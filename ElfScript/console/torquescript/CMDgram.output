  154                 | opSRASN expr

  155 stmt_expr: funcall_expr
  156          | assert_expr
  157          | inline_command_expr
  158          | object_decl
  159          | VAR '=' expr
  160          | VAR '=' '{' expr_list '}'
  161          | VAR '=' '[' expr_list ']'
  162          | VAR '[' aidx_expr ']' '=' expr
  163          | VAR '[' aidx_expr ']' '=' '{' expr_list '}'
  164          | VAR assign_op_struct
