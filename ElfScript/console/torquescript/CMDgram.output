Grammar

    0 $accept: start $end

    1 start: decl_list

    2 decl_list: ε
    3          | decl_list decl

    4 decl: stmt
    5     | fn_decl_stmt
    6     | package_decl

    7 package_decl: rwPACKAGE IDENT '{' fn_decl_list '}' ';'

    8 fn_decl_list: fn_decl_stmt
    9             | fn_decl_list fn_decl_stmt

   10 statement_list: ε
   11               | statement_list stmt

   12 stmt: if_stmt
   13     | while_stmt
   14     | for_stmt
   15     | foreach_stmt
   16     | datablock_decl
   17     | switch_stmt
   18     | rwBREAK ';'
   19     | rwCONTINUE ';'
   20     | rwRETURN ';'
   21     | rwRETURN expr ';'
   22     | expression_stmt ';'
   23     | TTAG '=' expr ';'
   24     | TTAG '=' expr ',' expr ';'
   25     | DOCBLOCK

   26 fn_decl_stmt: rwDEFINE IDENT '(' var_list_decl ')' '{' statement_list '}'
   27             | rwDEFINE IDENT opCOLONCOLON IDENT '(' var_list_decl ')' '{' statement_list '}'

   28 var_list_decl: ε
   29              | var_list

   30 var_list: param
   31         | var_list ',' param

   32 param: VAR
   33      | VAR '?'
   34      | VAR '=' expr
   35      | VAR '?' '=' expr

   36 datablock_decl: rwDATABLOCK class_name_expr '(' expr parent_block ')' '{' slot_assign_list_opt '}' ';'

   37 object_decl: rwDECLARE class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   38            | rwDECLARE class_name_expr '(' object_name parent_block object_args ')'
   39            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')' '{' object_declare_block '}'
   40            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')'
   41            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   42            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')'

   43 parent_block: ε
   44             | ':' IDENT

   45 object_name: ε
   46            | expr

   47 object_args: ε
   48            | ',' expr_list

   49 object_declare_block: ε
   50                     | slot_assign_list
   51                     | object_decl_list
   52                     | slot_assign_list object_decl_list

   53 object_decl_list: object_decl ';'
   54                 | object_decl_list object_decl ';'

   55 stmt_block: '{' statement_list '}'
   56           | stmt

   57 switch_stmt: rwSWITCH '(' expr ')' '{' case_block '}'
   58            | rwSWITCHSTR '(' expr ')' '{' case_block '}'

   59 case_block: rwCASE case_expr ':' statement_list
   60           | rwCASE case_expr ':' statement_list rwDEFAULT ':' statement_list
   61           | rwCASE case_expr ':' statement_list case_block

   62 case_expr: expr
   63          | case_expr rwCASEOR expr

   64 if_stmt: rwIF '(' expr ')' stmt_block
   65        | rwIF '(' expr ')' stmt_block rwELSE stmt_block

   66 while_stmt: rwWHILE '(' expr ')' stmt_block
   67           | rwDO stmt_block rwWHILE '(' expr ')'

   68 for_stmt: rwFOR '(' expr ';' expr ';' expr ')' stmt_block
   69         | rwFOR '(' expr ';' expr ';' ')' stmt_block
   70         | rwFOR '(' expr ';' ';' expr ')' stmt_block
   71         | rwFOR '(' expr ';' ';' ')' stmt_block
   72         | rwFOR '(' ';' expr ';' expr ')' stmt_block
   73         | rwFOR '(' ';' expr ';' ')' stmt_block
   74         | rwFOR '(' ';' ';' expr ')' stmt_block
   75         | rwFOR '(' ';' ';' ')' stmt_block

   76 foreach_stmt: rwFOREACH '(' VAR rwIN expr ')' stmt_block
   77             | rwFOREACHSTR '(' VAR rwIN expr ')' stmt_block

   78 expression_stmt: stmt_expr

   79 expr: stmt_expr
   80     | '(' expr ')'
   81     | expr '^' expr
   82     | expr '%' expr
   83     | expr '&' expr
   84     | expr '|' expr
   85     | expr '+' expr
