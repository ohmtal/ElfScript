   87         | rwFOR '(' VAR rwIN rwRANGE expr opDOTDOT expr rwSTEP expr ')' stmt_block
   88         | rwFOR '(' VAR rwIN rwRANGE expr ')' stmt_block

   89 foreach_stmt: rwFOREACH '(' VAR rwIN expr ')' stmt_block
   90             | rwFOREACHSTR '(' VAR rwIN expr ')' stmt_block
   91             | rwFOREACH '(' VAR rwIN expr opDOTDOT expr ')' stmt_block
   92             | rwFOREACH '(' VAR rwIN rwRANGE expr opDOTDOT expr ')' stmt_block
   93             | rwFOREACH '(' VAR rwIN expr opDOTDOT expr rwSTEP expr ')' stmt_block
   94             | rwFOREACH '(' VAR rwIN rwRANGE expr opDOTDOT expr rwSTEP expr ')' stmt_block
   95             | rwFOREACH '(' VAR rwIN rwRANGE expr ')' stmt_block

   96 expression_stmt: stmt_expr

   97 expr: stmt_expr
   98     | '(' expr ')'
   99     | expr '^' expr
  100     | expr '%' expr
  101     | expr '&' expr
  102     | expr '|' expr
