Grammar

    0 $accept: start $end

    1 start: decl_list

    2 decl_list: ε
    3          | decl_list decl

    4 decl: stmt
    5     | fn_decl_stmt
    6     | package_decl

    7 package_decl: rwPACKAGE IDENT '{' fn_decl_list '}' ';'

    8 fn_decl_list: fn_decl_stmt
    9             | fn_decl_list fn_decl_stmt

   10 statement_list: ε
   11               | statement_list stmt

   12 stmt: if_stmt
   13     | while_stmt
   14     | for_stmt
   15     | foreach_stmt
   16     | datablock_decl
   17     | switch_stmt
   18     | rwBREAK ';'
   19     | rwCONTINUE ';'
   20     | rwRETURN ';'
   21     | rwRETURN expr ';'
   22     | rwRETURN '{' expr_list '}' ';'
   23     | expression_stmt ';'
   24     | TTAG '=' expr ';'
   25     | TTAG '=' expr ',' expr ';'
   26     | DOCBLOCK
   27     | '[' unpack_var_list ']' '=' expr ';'
   28     | '[' unpack_var_list ']' '=' '[' expr_list ']' ';'
   29     | '[' unpack_var_list ']' '=' '{' expr_list '}' ';'

   30 fn_decl_stmt: rwDEFINE IDENT '(' var_list_decl ')' '{' statement_list '}'
   31             | rwDEFINE IDENT opCOLONCOLON IDENT '(' var_list_decl ')' '{' statement_list '}'

   32 var_list_decl: ε
   33              | func_var_list

   34 func_var_list: param
   35              | func_var_list ',' param

   36 param: VAR
   37      | VAR '?'
   38      | VAR '=' expr
   39      | VAR '?' '=' expr

   40 unpack_var_list: unpack_param
   41                | unpack_var_list ',' unpack_param

   42 unpack_param: VAR
   43             | VAR '?'

   44 datablock_decl: rwDATABLOCK class_name_expr '(' expr parent_block ')' '{' slot_assign_list_opt '}' ';'

   45 object_decl: rwDECLARE class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   46            | rwDECLARE class_name_expr '(' object_name parent_block object_args ')'
   47            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')' '{' object_declare_block '}'
   48            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')'
   49            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   50            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')'

   51 parent_block: ε
   52             | ':' IDENT

   53 object_name: ε
   54            | expr

   55 object_args: ε
   56            | ',' expr_list

   57 object_declare_block: ε
   58                     | slot_assign_list
   59                     | object_decl_list
   60                     | slot_assign_list object_decl_list

   61 object_decl_list: object_decl ';'
   62                 | object_decl_list object_decl ';'

   63 stmt_block: '{' statement_list '}'
   64           | stmt

   65 switch_stmt: rwSWITCH '(' expr ')' '{' case_block '}'
   66            | rwSWITCHSTR '(' expr ')' '{' case_block '}'

   67 case_block: rwCASE case_expr ':' statement_list
   68           | rwCASE case_expr ':' statement_list rwDEFAULT ':' statement_list
   69           | rwCASE case_expr ':' statement_list case_block

   70 case_expr: expr
   71          | case_expr rwCASEOR expr

   72 if_stmt: rwIF '(' expr ')' stmt_block
   73        | rwIF '(' expr ')' stmt_block rwELSE stmt_block

   74 while_stmt: rwWHILE '(' expr ')' stmt_block
   75           | rwDO stmt_block rwWHILE '(' expr ')'

   76 for_stmt: rwFOR '(' expr ';' expr ';' expr ')' stmt_block
   77         | rwFOR '(' expr ';' expr ';' ')' stmt_block
   78         | rwFOR '(' expr ';' ';' expr ')' stmt_block
   79         | rwFOR '(' expr ';' ';' ')' stmt_block
   80         | rwFOR '(' ';' expr ';' expr ')' stmt_block
   81         | rwFOR '(' ';' expr ';' ')' stmt_block
   82         | rwFOR '(' ';' ';' expr ')' stmt_block
   83         | rwFOR '(' ';' ';' ')' stmt_block
   84         | rwFOR '(' VAR rwIN expr opDOTDOT expr ')' stmt_block
   85         | rwFOR '(' VAR rwIN rwRANGE expr opDOTDOT expr ')' stmt_block
   86         | rwFOR '(' VAR rwIN expr opDOTDOT expr rwSTEP expr ')' stmt_block
   87         | rwFOR '(' VAR rwIN rwRANGE expr opDOTDOT expr rwSTEP expr ')' stmt_block
   88         | rwFOR '(' VAR rwIN rwRANGE expr ')' stmt_block

   89 foreach_stmt: rwFOREACH '(' VAR rwIN expr ')' stmt_block
   90             | rwFOREACHSTR '(' VAR rwIN expr ')' stmt_block
   91             | rwFOREACH '(' VAR rwIN expr opDOTDOT expr ')' stmt_block
   92             | rwFOREACH '(' VAR rwIN rwRANGE expr opDOTDOT expr ')' stmt_block
   93             | rwFOREACH '(' VAR rwIN expr opDOTDOT expr rwSTEP expr ')' stmt_block
   94             | rwFOREACH '(' VAR rwIN rwRANGE expr opDOTDOT expr rwSTEP expr ')' stmt_block
   95             | rwFOREACH '(' VAR rwIN rwRANGE expr ')' stmt_block

   96 expression_stmt: stmt_expr

   97 expr: stmt_expr
   98     | '(' expr ')'
   99     | expr '^' expr
  100     | expr '%' expr
  101     | expr '&' expr
  102     | expr '|' expr
  103     | expr '+' expr
  104     | expr '-' expr
  105     | expr '*' expr
  106     | expr '/' expr
  107     | '-' expr
  108     | '*' expr
  109     | TTAG
  110     | expr '?' expr ':' expr
  111     | expr '?' '{' expr_list '}' ':' '{' expr_list '}'
  112     | expr '?' expr ':' '{' expr_list '}'
  113     | expr '?' '{' expr_list '}' ':' expr
  114     | expr '<' expr
  115     | expr '>' expr
  116     | expr opGE expr
  117     | expr opLE expr
  118     | expr opEQ expr
  119     | expr opNE expr
  120     | expr opOR expr
  121     | expr opSHL expr
  122     | expr opSHR expr
  123     | expr opAND expr
  124     | expr opSTREQ expr
  125     | expr opSTRNE expr
  126     | expr '@' expr
  127     | '!' expr
  128     | '~' expr
  129     | TAGATOM
  130     | FLTCONST
  131     | INTCONST
  132     | rwBREAK
  133     | slot_acc
  134     | intslot_acc
  135     | IDENT
  136     | STRATOM
  137     | VAR
  138     | VAR '[' aidx_expr ']'

  139 slot_acc: expr '.' IDENT
  140         | expr '.' IDENT '[' aidx_expr ']'

  141 intslot_acc: expr opINTNAME class_name_expr
  142            | expr opINTNAMER class_name_expr

  143 class_name_expr: IDENT
  144                | '(' expr ')'

  145 assign_op_struct: opPLUSPLUS
  146                 | opMINUSMINUS
  147                 | opPLASN expr
  148                 | opMIASN expr
  149                 | opMLASN expr
  150                 | opDVASN expr
  151                 | opMODASN expr
  152                 | opANDASN expr
  153                 | opXORASN expr
  154                 | opORASN expr
  155                 | opSLASN expr
  156                 | opSRASN expr

  157 stmt_expr: funcall_expr
  158          | assert_expr
  159          | inline_command_expr
  160          | object_decl
  161          | VAR '=' expr
  162          | VAR '=' '{' expr_list '}'
  163          | VAR '=' '[' expr_list ']'
  164          | VAR '[' aidx_expr ']' '=' expr
  165          | VAR '[' aidx_expr ']' '=' '{' expr_list '}'
  166          | VAR assign_op_struct
  167          | VAR '[' aidx_expr ']' assign_op_struct
  168          | slot_acc assign_op_struct
  169          | slot_acc '=' expr
  170          | slot_acc '=' '{' expr_list '}'
  171          | slot_acc '=' '[' expr_list ']'

  172 funcall_expr: IDENT '(' func_arg_list_decl ')'
  173             | IDENT opCOLONCOLON IDENT '(' func_arg_list_decl ')'
  174             | expr '.' IDENT '(' func_arg_list_decl ')'

  175 func_arg_item: expr
  176              | '{' expr_list '}'

  177 func_arg_list: func_arg_item
  178              | func_arg_list ',' func_arg_item

  179 func_arg_list_decl: ε
  180                   | func_arg_list

  181 assert_expr: rwASSERT '(' expr ')'
  182            | rwASSERT '(' expr ',' STRATOM ')'

  183 inline_command_expr: rwPRINT '(' expr_list ')'
  184                    | rwPRINTF '(' expr_list ')'
  185                    | rwSPRINTF '(' expr_list ')'
  186                    | rwRANDOMF '(' ')'
  187                    | rwRANDOMF '(' expr_list ')'
  188                    | rwFLOOR '(' expr_list ')'
  189                    | rwCEIL '(' expr_list ')'
  190                    | rwFABS '(' expr_list ')'
  191                    | rwSIN '(' expr_list ')'
  192                    | rwCOS '(' expr_list ')'
  193                    | rwATAN '(' expr_list ')'
  194                    | rwTANH '(' expr_list ')'
  195                    | rwSQRT '(' expr_list ')'
  196                    | rwISZERO '(' expr_list ')'
  197                    | rwFMOD '(' expr_list ')'
  198                    | rwMIN '(' expr_list ')'
  199                    | rwMAX '(' expr_list ')'
  200                    | rwATAN2 '(' expr_list ')'
  201                    | rwPOW '(' expr_list ')'
  202                    | rwCLAMP '(' expr_list ')'
  203                    | rwCLAMPF '(' expr_list ')'
  204                    | rwLERP '(' expr_list ')'
  205                    | rwSMOOTHSTEP '(' expr_list ')'

  206 expr_list: expr
  207          | expr_list ',' expr

  208 slot_assign_list_opt: ε
  209                     | slot_assign_list

  210 slot_assign_list: slot_assign
  211                 | slot_assign_list slot_assign

  212 slot_assign: IDENT '=' expr ';'
  213            | IDENT '=' '{' expr_list '}' ';'
  214            | IDENT '=' '[' expr_list ']' ';'
  215            | TYPEIDENT IDENT '=' expr ';'
  216            | TYPEIDENT IDENT '=' '{' expr_list '}' ';'
  217            | rwDATABLOCK '=' expr ';'
  218            | IDENT '[' aidx_expr ']' '=' expr ';'
  219            | IDENT '[' aidx_expr ']' '=' '{' expr_list '}' ';'
  220            | TYPEIDENT IDENT '[' aidx_expr ']' '=' expr ';'

  221 aidx_expr: expr
  222          | aidx_expr ',' expr


