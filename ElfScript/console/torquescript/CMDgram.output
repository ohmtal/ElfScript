Grammar

    0 $accept: start $end

    1 start: decl_list

    2 decl_list: ε
    3          | decl_list decl

    4 decl: stmt
    5     | fn_decl_stmt
    6     | package_decl

    7 package_decl: rwPACKAGE IDENT '{' fn_decl_list '}' ';'

    8 fn_decl_list: fn_decl_stmt
    9             | fn_decl_list fn_decl_stmt

   10 statement_list: ε
   11               | statement_list stmt

   12 stmt: if_stmt
   13     | while_stmt
   14     | for_stmt
   15     | foreach_stmt
   16     | datablock_decl
   17     | switch_stmt
   18     | rwBREAK ';'
   19     | rwCONTINUE ';'
   20     | rwRETURN ';'
   21     | rwRETURN expr ';'
   22     | rwRETURN '{' expr_list '}' ';'
   23     | expression_stmt ';'
   24     | TTAG '=' expr ';'
   25     | TTAG '=' expr ',' expr ';'
   26     | DOCBLOCK

   27 fn_decl_stmt: rwDEFINE IDENT '(' var_list_decl ')' '{' statement_list '}'
   28             | rwDEFINE IDENT opCOLONCOLON IDENT '(' var_list_decl ')' '{' statement_list '}'

   29 var_list_decl: ε
   30              | var_list

   31 var_list: param
   32         | var_list ',' param

   33 param: VAR
   34      | VAR '?'
   35      | VAR '=' expr
   36      | VAR '?' '=' expr

   37 datablock_decl: rwDATABLOCK class_name_expr '(' expr parent_block ')' '{' slot_assign_list_opt '}' ';'

   38 object_decl: rwDECLARE class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   39            | rwDECLARE class_name_expr '(' object_name parent_block object_args ')'
   40            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')' '{' object_declare_block '}'
   41            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')'
   42            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   43            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')'

   44 parent_block: ε
   45             | ':' IDENT

   46 object_name: ε
   47            | expr

   48 object_args: ε
   49            | ',' expr_list

   50 object_declare_block: ε
   51                     | slot_assign_list
   52                     | object_decl_list
   53                     | slot_assign_list object_decl_list

   54 object_decl_list: object_decl ';'
   55                 | object_decl_list object_decl ';'

   56 stmt_block: '{' statement_list '}'
   57           | stmt

   58 switch_stmt: rwSWITCH '(' expr ')' '{' case_block '}'
   59            | rwSWITCHSTR '(' expr ')' '{' case_block '}'

   60 case_block: rwCASE case_expr ':' statement_list
   61           | rwCASE case_expr ':' statement_list rwDEFAULT ':' statement_list
   62           | rwCASE case_expr ':' statement_list case_block

   63 case_expr: expr
   64          | case_expr rwCASEOR expr

   65 if_stmt: rwIF '(' expr ')' stmt_block
   66        | rwIF '(' expr ')' stmt_block rwELSE stmt_block

   67 while_stmt: rwWHILE '(' expr ')' stmt_block
   68           | rwDO stmt_block rwWHILE '(' expr ')'

   69 for_stmt: rwFOR '(' expr ';' expr ';' expr ')' stmt_block
   70         | rwFOR '(' expr ';' expr ';' ')' stmt_block
   71         | rwFOR '(' expr ';' ';' expr ')' stmt_block
   72         | rwFOR '(' expr ';' ';' ')' stmt_block
   73         | rwFOR '(' ';' expr ';' expr ')' stmt_block
   74         | rwFOR '(' ';' expr ';' ')' stmt_block
   75         | rwFOR '(' ';' ';' expr ')' stmt_block
   76         | rwFOR '(' ';' ';' ')' stmt_block

   77 foreach_stmt: rwFOREACH '(' VAR rwIN expr ')' stmt_block
   78             | rwFOREACHSTR '(' VAR rwIN expr ')' stmt_block
   79             | rwFOREACH '(' VAR rwIN expr opDOTDOT expr ')' stmt_block
   80             | rwFOREACH '(' VAR rwIN rwRANGE expr opDOTDOT expr ')' stmt_block

   81 expression_stmt: stmt_expr

   82 expr: stmt_expr
   83     | '(' expr ')'
   84     | expr '^' expr
   85     | expr '%' expr
   86     | expr '&' expr
   87     | expr '|' expr
   88     | expr '+' expr
   89     | expr '-' expr
   90     | expr '*' expr
   91     | expr '/' expr
   92     | '-' expr
   93     | '*' expr
   94     | TTAG
   95     | expr '?' expr ':' expr
   96     | expr '<' expr
   97     | expr '>' expr
   98     | expr opGE expr
   99     | expr opLE expr
  100     | expr opEQ expr
  101     | expr opNE expr
  102     | expr opOR expr
  103     | expr opSHL expr
  104     | expr opSHR expr
  105     | expr opAND expr
  106     | expr opSTREQ expr
  107     | expr opSTRNE expr
  108     | expr '@' expr
  109     | '!' expr
  110     | '~' expr
  111     | TAGATOM
  112     | FLTCONST
  113     | INTCONST
  114     | rwBREAK
  115     | slot_acc
  116     | intslot_acc
  117     | IDENT
  118     | STRATOM
  119     | VAR
  120     | VAR '[' aidx_expr ']'

  121 slot_acc: expr '.' IDENT
  122         | expr '.' IDENT '[' aidx_expr ']'

  123 intslot_acc: expr opINTNAME class_name_expr
  124            | expr opINTNAMER class_name_expr

  125 class_name_expr: IDENT
  126                | '(' expr ')'

  127 assign_op_struct: opPLUSPLUS
  128                 | opMINUSMINUS
  129                 | opPLASN expr
  130                 | opMIASN expr
  131                 | opMLASN expr
  132                 | opDVASN expr
  133                 | opMODASN expr
  134                 | opANDASN expr
  135                 | opXORASN expr
  136                 | opORASN expr
  137                 | opSLASN expr
  138                 | opSRASN expr

  139 stmt_expr: funcall_expr
  140          | assert_expr
  141          | object_decl
  142          | VAR '=' expr
  143          | VAR '=' '{' expr_list '}'
  144          | VAR '[' aidx_expr ']' '=' expr
  145          | VAR '[' aidx_expr ']' '=' '{' expr_list '}'
  146          | VAR assign_op_struct
  147          | VAR '[' aidx_expr ']' assign_op_struct
  148          | slot_acc assign_op_struct
  149          | slot_acc '=' expr
  150          | slot_acc '=' '{' expr_list '}'

  151 funcall_expr: IDENT '(' func_arg_list_decl ')'
  152             | IDENT opCOLONCOLON IDENT '(' func_arg_list_decl ')'
  153             | expr '.' IDENT '(' func_arg_list_decl ')'

  154 func_arg_item: expr
  155              | '{' expr_list '}'

  156 func_arg_list: func_arg_item
  157              | func_arg_list ',' func_arg_item

  158 func_arg_list_decl: ε
  159                   | func_arg_list

  160 assert_expr: rwASSERT '(' expr ')'
  161            | rwASSERT '(' expr ',' STRATOM ')'

  162 expr_list: expr
  163          | expr_list ',' expr

  164 slot_assign_list_opt: ε
  165                     | slot_assign_list

  166 slot_assign_list: slot_assign
  167                 | slot_assign_list slot_assign

  168 slot_assign: IDENT '=' expr ';'
  169            | IDENT '=' '{' expr_list '}' ';'
  170            | TYPEIDENT IDENT '=' expr ';'
  171            | TYPEIDENT IDENT '=' '{' expr_list '}' ';'
  172            | rwDATABLOCK '=' expr ';'
  173            | IDENT '[' aidx_expr ']' '=' expr ';'
  174            | IDENT '[' aidx_expr ']' '=' '{' expr_list '}' ';'
  175            | TYPEIDENT IDENT '[' aidx_expr ']' '=' expr ';'

  176 aidx_expr: expr
  177          | aidx_expr ',' expr


