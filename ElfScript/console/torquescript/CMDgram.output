  122     | rwBREAK
  123     | slot_acc
  124     | intslot_acc
  125     | IDENT
  126     | STRATOM
  127     | VAR
  128     | VAR '[' aidx_expr ']'

  129 slot_acc: expr '.' IDENT
  130         | expr '.' IDENT '[' aidx_expr ']'

  131 intslot_acc: expr opINTNAME class_name_expr
  132            | expr opINTNAMER class_name_expr

  133 class_name_expr: IDENT
  134                | '(' expr ')'

  135 assign_op_struct: opPLUSPLUS
  136                 | opMINUSMINUS
  137                 | opPLASN expr
  138                 | opMIASN expr
  139                 | opMLASN expr
  140                 | opDVASN expr
  141                 | opMODASN expr
  142                 | opANDASN expr
  143                 | opXORASN expr
  144                 | opORASN expr
  145                 | opSLASN expr
  146                 | opSRASN expr

  147 stmt_expr: funcall_expr
  148          | assert_expr
  149          | inline_command_expr
  150          | object_decl
  151          | VAR '=' expr
  152          | VAR '=' '{' expr_list '}'
  153          | VAR '[' aidx_expr ']' '=' expr
  154          | VAR '[' aidx_expr ']' '=' '{' expr_list '}'
  155          | VAR assign_op_struct
  156          | VAR '[' aidx_expr ']' assign_op_struct
  157          | slot_acc assign_op_struct
  158          | slot_acc '=' expr
  159          | slot_acc '=' '{' expr_list '}'

  160 funcall_expr: IDENT '(' func_arg_list_decl ')'
  161             | IDENT opCOLONCOLON IDENT '(' func_arg_list_decl ')'
  162             | expr '.' IDENT '(' func_arg_list_decl ')'

  163 func_arg_item: expr
  164              | '{' expr_list '}'

  165 func_arg_list: func_arg_item
  166              | func_arg_list ',' func_arg_item

  167 func_arg_list_decl: ε
  168                   | func_arg_list

  169 assert_expr: rwASSERT '(' expr ')'
  170            | rwASSERT '(' expr ',' STRATOM ')'

  171 inline_command_expr: rwPRINT '(' expr_list ')'
  172                    | rwRANDOMF '(' ')'
  173                    | rwRANDOMF '(' expr_list ')'

  174 expr_list: expr
  175          | expr_list ',' expr

  176 slot_assign_list_opt: ε
  177                     | slot_assign_list

  178 slot_assign_list: slot_assign
  179                 | slot_assign_list slot_assign

  180 slot_assign: IDENT '=' expr ';'
  181            | IDENT '=' '{' expr_list '}' ';'
  182            | TYPEIDENT IDENT '=' expr ';'
  183            | TYPEIDENT IDENT '=' '{' expr_list '}' ';'
  184            | rwDATABLOCK '=' expr ';'
  185            | IDENT '[' aidx_expr ']' '=' expr ';'
  186            | IDENT '[' aidx_expr ']' '=' '{' expr_list '}' ';'
  187            | TYPEIDENT IDENT '[' aidx_expr ']' '=' expr ';'

  188 aidx_expr: expr
  189          | aidx_expr ',' expr


