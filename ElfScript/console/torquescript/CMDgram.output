  139 intslot_acc: expr opINTNAME class_name_expr
  140            | expr opINTNAMER class_name_expr

  141 class_name_expr: IDENT
  142                | '(' expr ')'

  143 assign_op_struct: opPLUSPLUS
  144                 | opMINUSMINUS
  145                 | opPLASN expr
  146                 | opMIASN expr
  147                 | opMLASN expr
  148                 | opDVASN expr
  149                 | opMODASN expr
  150                 | opANDASN expr
  151                 | opXORASN expr
  152                 | opORASN expr
