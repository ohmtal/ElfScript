  114     | IDENT
  115     | STRATOM
  116     | VAR
  117     | VAR '[' aidx_expr ']'

  118 slot_acc: expr '.' IDENT
  119         | expr '.' IDENT '[' aidx_expr ']'

  120 intslot_acc: expr opINTNAME class_name_expr
  121            | expr opINTNAMER class_name_expr

  122 class_name_expr: IDENT
  123                | '(' expr ')'

  124 assign_op_struct: opPLUSPLUS
  125                 | opMINUSMINUS
  126                 | opPLASN expr
  127                 | opMIASN expr
  128                 | opMLASN expr
  129                 | opDVASN expr
