Grammar

    0 $accept: start $end

    1 start: decl_list

    2 decl_list: ε
    3          | decl_list decl

    4 decl: stmt
    5     | fn_decl_stmt
    6     | package_decl

    7 package_decl: rwPACKAGE IDENT '{' fn_decl_list '}' ';'

    8 fn_decl_list: fn_decl_stmt
    9             | fn_decl_list fn_decl_stmt

   10 statement_list: ε
   11               | statement_list stmt

   12 stmt: if_stmt
   13     | while_stmt
   14     | for_stmt
   15     | foreach_stmt
   16     | datablock_decl
   17     | switch_stmt
   18     | rwBREAK ';'
   19     | rwCONTINUE ';'
   20     | rwRETURN ';'
   21     | rwRETURN expr ';'
   22     | rwRETURN '{' expr_list '}' ';'
   23     | expression_stmt ';'
   24     | TTAG '=' expr ';'
   25     | TTAG '=' expr ',' expr ';'
   26     | DOCBLOCK
   27     | '[' var_list ']' '=' expr ';'

   28 fn_decl_stmt: rwDEFINE IDENT '(' var_list_decl ')' '{' statement_list '}'
   29             | rwDEFINE IDENT opCOLONCOLON IDENT '(' var_list_decl ')' '{' statement_list '}'

   30 var_list_decl: ε
   31              | var_list

   32 var_list: param
   33         | var_list ',' param

   34 param: VAR
   35      | VAR '?'
   36      | VAR '=' expr
   37      | VAR '?' '=' expr

   38 datablock_decl: rwDATABLOCK class_name_expr '(' expr parent_block ')' '{' slot_assign_list_opt '}' ';'

   39 object_decl: rwDECLARE class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   40            | rwDECLARE class_name_expr '(' object_name parent_block object_args ')'
   41            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')' '{' object_declare_block '}'
   42            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')'
   43            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   44            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')'

   45 parent_block: ε
   46             | ':' IDENT

   47 object_name: ε
   48            | expr

   49 object_args: ε
   50            | ',' expr_list

   51 object_declare_block: ε
   52                     | slot_assign_list
   53                     | object_decl_list
   54                     | slot_assign_list object_decl_list

   55 object_decl_list: object_decl ';'
   56                 | object_decl_list object_decl ';'

   57 stmt_block: '{' statement_list '}'
   58           | stmt

   59 switch_stmt: rwSWITCH '(' expr ')' '{' case_block '}'
   60            | rwSWITCHSTR '(' expr ')' '{' case_block '}'

   61 case_block: rwCASE case_expr ':' statement_list
   62           | rwCASE case_expr ':' statement_list rwDEFAULT ':' statement_list
   63           | rwCASE case_expr ':' statement_list case_block

   64 case_expr: expr
   65          | case_expr rwCASEOR expr

   66 if_stmt: rwIF '(' expr ')' stmt_block
   67        | rwIF '(' expr ')' stmt_block rwELSE stmt_block

   68 while_stmt: rwWHILE '(' expr ')' stmt_block
   69           | rwDO stmt_block rwWHILE '(' expr ')'

   70 for_stmt: rwFOR '(' expr ';' expr ';' expr ')' stmt_block
   71         | rwFOR '(' expr ';' expr ';' ')' stmt_block
   72         | rwFOR '(' expr ';' ';' expr ')' stmt_block
   73         | rwFOR '(' expr ';' ';' ')' stmt_block
   74         | rwFOR '(' ';' expr ';' expr ')' stmt_block
   75         | rwFOR '(' ';' expr ';' ')' stmt_block
   76         | rwFOR '(' ';' ';' expr ')' stmt_block
   77         | rwFOR '(' ';' ';' ')' stmt_block
   78         | rwFOR '(' VAR rwIN expr opDOTDOT expr ')' stmt_block
