Grammar

    0 $accept: start $end

    1 start: decl_list

    2 decl_list: ε
    3          | decl_list decl

    4 decl: stmt
    5     | fn_decl_stmt
    6     | package_decl

    7 package_decl: rwPACKAGE IDENT '{' fn_decl_list '}' ';'

    8 fn_decl_list: fn_decl_stmt
    9             | fn_decl_list fn_decl_stmt

   10 statement_list: ε
   11               | statement_list stmt

   12 stmt: if_stmt
   13     | while_stmt
   14     | for_stmt
   15     | foreach_stmt
   16     | datablock_decl
   17     | switch_stmt
   18     | rwBREAK ';'
   19     | rwCONTINUE ';'
   20     | rwRETURN ';'
   21     | rwRETURN expr ';'
   22     | rwRETURN '{' expr_list '}' ';'
   23     | expression_stmt ';'
   24     | TTAG '=' expr ';'
   25     | TTAG '=' expr ',' expr ';'
   26     | DOCBLOCK
   27     | '[' unpack_var_list ']' '=' expr ';'
   28     | '[' unpack_var_list ']' '=' '{' expr_list '}' ';'
   29     | '[' unpack_var_list ']' '=' '[' expr_list ']' ';'

   30 fn_decl_stmt: rwDEFINE IDENT '(' func_var_list_decl ')' '{' statement_list '}'
   31             | rwDEFINE IDENT opCOLONCOLON IDENT '(' func_var_list_decl ')' '{' statement_list '}'

   32 func_var_list_decl: ε
   33                   | func_var_list

   34 func_var_list: param
   35              | func_var_list ',' param

   36 param: VAR
   37      | VAR '?'
   38      | VAR '=' expr
   39      | VAR '?' '=' expr

   40 unpack_var_list: unpack_param
   41                | unpack_var_list ',' unpack_param

   42 unpack_param: VAR
   43             | VAR '?'

   44 datablock_decl: rwDATABLOCK class_name_expr '(' expr parent_block ')' '{' slot_assign_list_opt '}' ';'

   45 object_decl: rwDECLARE class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   46            | rwDECLARE class_name_expr '(' object_name parent_block object_args ')'
   47            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')' '{' object_declare_block '}'
   48            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')'
   49            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   50            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')'

   51 parent_block: ε
   52             | ':' IDENT

   53 object_name: ε
   54            | expr

   55 object_args: ε
   56            | ',' expr_list

   57 object_declare_block: ε
   58                     | slot_assign_list
   59                     | object_decl_list
   60                     | slot_assign_list object_decl_list

   61 object_decl_list: object_decl ';'
   62                 | object_decl_list object_decl ';'

   63 stmt_block: '{' statement_list '}'
   64           | stmt

   65 switch_stmt: rwSWITCH '(' expr ')' '{' case_block '}'
   66            | rwSWITCHSTR '(' expr ')' '{' case_block '}'

   67 case_block: rwCASE case_expr ':' statement_list
   68           | rwCASE case_expr ':' statement_list rwDEFAULT ':' statement_list
   69           | rwCASE case_expr ':' statement_list case_block

   70 case_expr: expr
   71          | case_expr rwCASEOR expr

   72 if_stmt: rwIF '(' expr ')' stmt_block
   73        | rwIF '(' expr ')' stmt_block rwELSE stmt_block

   74 while_stmt: rwWHILE '(' expr ')' stmt_block
   75           | rwDO stmt_block rwWHILE '(' expr ')'

   76 for_stmt: rwFOR '(' expr ';' expr ';' expr ')' stmt_block
   77         | rwFOR '(' expr ';' expr ';' ')' stmt_block
   78         | rwFOR '(' expr ';' ';' expr ')' stmt_block
   79         | rwFOR '(' expr ';' ';' ')' stmt_block
   80         | rwFOR '(' ';' expr ';' expr ')' stmt_block
   81         | rwFOR '(' ';' expr ';' ')' stmt_block
   82         | rwFOR '(' ';' ';' expr ')' stmt_block
   83         | rwFOR '(' ';' ';' ')' stmt_block
   84         | rwFOR '(' VAR rwIN expr opDOTDOT expr ')' stmt_block
   85         | rwFOR '(' VAR rwIN rwRANGE expr opDOTDOT expr ')' stmt_block
