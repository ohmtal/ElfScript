  136 stmt_expr: funcall_expr
  137          | assert_expr
  138          | object_decl
  139          | VAR '=' expr
  140          | VAR '=' '{' expr_list '}'
  141          | VAR '[' aidx_expr ']' '=' expr
  142          | VAR '[' aidx_expr ']' '=' '{' expr_list '}'
  143          | VAR assign_op_struct
  144          | VAR '[' aidx_expr ']' assign_op_struct
  145          | slot_acc assign_op_struct
  146          | slot_acc '=' expr
  147          | slot_acc '=' '{' expr_list '}'

  148 funcall_expr: IDENT '(' expr_list_decl ')'
  149             | IDENT opCOLONCOLON IDENT '(' expr_list_decl ')'
  150             | expr '.' IDENT '(' expr_list_decl ')'

  151 assert_expr: rwASSERT '(' expr ')'
  152            | rwASSERT '(' expr ',' STRATOM ')'

  153 expr_list_decl: ε
  154               | expr_list

  155 expr_list: expr
  156          | expr_list ',' expr

  157 slot_assign_list_opt: ε
  158                     | slot_assign_list

  159 slot_assign_list: slot_assign
  160                 | slot_assign_list slot_assign

  161 slot_assign: IDENT '=' expr ';'
  162            | IDENT '=' '{' expr_list '}' ';'
  163            | TYPEIDENT IDENT '=' expr ';'
  164            | TYPEIDENT IDENT '=' '{' expr_list '}' ';'
  165            | rwDATABLOCK '=' expr ';'
  166            | IDENT '[' aidx_expr ']' '=' expr ';'
  167            | IDENT '[' aidx_expr ']' '=' '{' expr_list '}' ';'
  168            | TYPEIDENT IDENT '[' aidx_expr ']' '=' expr ';'

  169 aidx_expr: expr
