   29 var_list_decl: ε
   30              | var_list

   31 var_list: param
   32         | var_list ',' param

   33 param: VAR
   34      | VAR '?'
   35      | VAR '=' expr
   36      | VAR '?' '=' expr

   37 datablock_decl: rwDATABLOCK class_name_expr '(' expr parent_block ')' '{' slot_assign_list_opt '}' ';'

   38 object_decl: rwDECLARE class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   39            | rwDECLARE class_name_expr '(' object_name parent_block object_args ')'
   40            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')' '{' object_declare_block '}'
   41            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')'
   42            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   43            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')'

   44 parent_block: ε
   45             | ':' IDENT

   46 object_name: ε
   47            | expr

   48 object_args: ε
   49            | ',' expr_list

   50 object_declare_block: ε
   51                     | slot_assign_list
   52                     | object_decl_list
   53                     | slot_assign_list object_decl_list

   54 object_decl_list: object_decl ';'
   55                 | object_decl_list object_decl ';'

   56 stmt_block: '{' statement_list '}'
   57           | stmt

   58 switch_stmt: rwSWITCH '(' expr ')' '{' case_block '}'
   59            | rwSWITCHSTR '(' expr ')' '{' case_block '}'

   60 case_block: rwCASE case_expr ':' statement_list
   61           | rwCASE case_expr ':' statement_list rwDEFAULT ':' statement_list
   62           | rwCASE case_expr ':' statement_list case_block

   63 case_expr: expr
   64          | case_expr rwCASEOR expr

   65 if_stmt: rwIF '(' expr ')' stmt_block
   66        | rwIF '(' expr ')' stmt_block rwELSE stmt_block

   67 while_stmt: rwWHILE '(' expr ')' stmt_block
