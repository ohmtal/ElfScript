  177 func_arg_list_decl: ε
  178                   | func_arg_list

  179 assert_expr: rwASSERT '(' expr ')'
  180            | rwASSERT '(' expr ',' STRATOM ')'

  181 inline_command_expr: rwPRINT '(' expr_list ')'
  182                    | rwPRINTF '(' expr_list ')'
  183                    | rwSPRINTF '(' expr_list ')'
  184                    | rwRANDOMF '(' ')'
