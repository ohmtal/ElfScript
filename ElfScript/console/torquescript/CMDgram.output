Grammar

    0 $accept: start $end

    1 start: decl_list

    2 decl_list: ε
    3          | decl_list decl

    4 decl: stmt
    5     | fn_decl_stmt
    6     | package_decl

    7 package_decl: rwPACKAGE IDENT '{' fn_decl_list '}' ';'

    8 fn_decl_list: fn_decl_stmt
    9             | fn_decl_list fn_decl_stmt

   10 statement_list: ε
   11               | statement_list stmt

   12 stmt: if_stmt
   13     | while_stmt
   14     | for_stmt
   15     | foreach_stmt
   16     | datablock_decl
   17     | switch_stmt
   18     | rwBREAK ';'
   19     | rwCONTINUE ';'
   20     | rwRETURN ';'
   21     | rwRETURN expr ';'
   22     | rwRETURN '{' expr_list '}' ';'
   23     | expression_stmt ';'
   24     | TTAG '=' expr ';'
   25     | TTAG '=' expr ',' expr ';'
   26     | DOCBLOCK
   27     | '[' unpack_var_list ']' '=' expr ';'

   28 fn_decl_stmt: rwDEFINE IDENT '(' func_var_list_decl ')' '{' statement_list '}'
   29             | rwDEFINE IDENT opCOLONCOLON IDENT '(' func_var_list_decl ')' '{' statement_list '}'

   30 func_var_list_decl: ε
   31                   | func_var_list

   32 func_var_list: param
   33              | func_var_list ',' param

   34 param: VAR
   35      | VAR '?'
   36      | VAR '=' expr
   37      | VAR '?' '=' expr

   38 unpack_var_list: unpack_param
   39                | unpack_var_list ',' unpack_param

   40 unpack_param: VAR
   41             | VAR '?'

   42 datablock_decl: rwDATABLOCK class_name_expr '(' expr parent_block ')' '{' slot_assign_list_opt '}' ';'

   43 object_decl: rwDECLARE class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   44            | rwDECLARE class_name_expr '(' object_name parent_block object_args ')'
   45            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')' '{' object_declare_block '}'
   46            | rwDECLARE class_name_expr '(' '[' object_name ']' parent_block object_args ')'
   47            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')' '{' object_declare_block '}'
   48            | rwDECLARESINGLETON class_name_expr '(' object_name parent_block object_args ')'

   49 parent_block: ε
   50             | ':' IDENT

   51 object_name: ε
   52            | expr

   53 object_args: ε
   54            | ',' expr_list

   55 object_declare_block: ε
   56                     | slot_assign_list
   57                     | object_decl_list
   58                     | slot_assign_list object_decl_list

   59 object_decl_list: object_decl ';'
   60                 | object_decl_list object_decl ';'

   61 stmt_block: '{' statement_list '}'
   62           | stmt

   63 switch_stmt: rwSWITCH '(' expr ')' '{' case_block '}'
   64            | rwSWITCHSTR '(' expr ')' '{' case_block '}'

   65 case_block: rwCASE case_expr ':' statement_list
   66           | rwCASE case_expr ':' statement_list rwDEFAULT ':' statement_list
   67           | rwCASE case_expr ':' statement_list case_block

   68 case_expr: expr
   69          | case_expr rwCASEOR expr

   70 if_stmt: rwIF '(' expr ')' stmt_block
   71        | rwIF '(' expr ')' stmt_block rwELSE stmt_block

   72 while_stmt: rwWHILE '(' expr ')' stmt_block
   73           | rwDO stmt_block rwWHILE '(' expr ')'

   74 for_stmt: rwFOR '(' expr ';' expr ';' expr ')' stmt_block
   75         | rwFOR '(' expr ';' expr ';' ')' stmt_block
   76         | rwFOR '(' expr ';' ';' expr ')' stmt_block
   77         | rwFOR '(' expr ';' ';' ')' stmt_block
   78         | rwFOR '(' ';' expr ';' expr ')' stmt_block
   79         | rwFOR '(' ';' expr ';' ')' stmt_block
   80         | rwFOR '(' ';' ';' expr ')' stmt_block
   81         | rwFOR '(' ';' ';' ')' stmt_block
   82         | rwFOR '(' VAR rwIN expr opDOTDOT expr ')' stmt_block
   83         | rwFOR '(' VAR rwIN rwRANGE expr opDOTDOT expr ')' stmt_block
   84         | rwFOR '(' VAR rwIN expr opDOTDOT expr rwSTEP expr ')' stmt_block
   85         | rwFOR '(' VAR rwIN rwRANGE expr opDOTDOT expr rwSTEP expr ')' stmt_block
   86         | rwFOR '(' VAR rwIN rwRANGE expr ')' stmt_block

   87 foreach_stmt: rwFOREACH '(' VAR rwIN expr ')' stmt_block
   88             | rwFOREACHSTR '(' VAR rwIN expr ')' stmt_block
   89             | rwFOREACH '(' VAR rwIN expr opDOTDOT expr ')' stmt_block
   90             | rwFOREACH '(' VAR rwIN rwRANGE expr opDOTDOT expr ')' stmt_block
   91             | rwFOREACH '(' VAR rwIN expr opDOTDOT expr rwSTEP expr ')' stmt_block
   92             | rwFOREACH '(' VAR rwIN rwRANGE expr opDOTDOT expr rwSTEP expr ')' stmt_block
   93             | rwFOREACH '(' VAR rwIN rwRANGE expr ')' stmt_block

   94 expression_stmt: stmt_expr

   95 expr: stmt_expr
   96     | '(' expr ')'
   97     | expr '^' expr
   98     | expr '%' expr
   99     | expr '&' expr
  100     | expr '|' expr
  101     | expr '+' expr
  102     | expr '-' expr
