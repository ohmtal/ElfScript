%myString = "one two three";
echo("WORD LOOP on ", %myString);
%count = getWordCount(%myString);
for (%i = 0; %i < %count; %i++ ) {
    %word = getword( %myString, %i);
    echo("Word is: ", %word);
}

foreach$(%word in %myString) echo("foreach Word is: ", %word);

