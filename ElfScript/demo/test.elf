function Pupser::update(%this) {
    %dt = 0.1;
    echo("1 THIS:" SPC %this SPC "THIS RECT=" SPC %this.rect SPC "VELO=" SPC %this.velo);
    %this.rect.x = 1.2;
    echo("2 THIS:" SPC %this SPC "THIS RECT=" SPC %this.rect SPC "VELO=" SPC %this.velo);
    %add = %this.velo.x * %dt;
    echo("add =" SPC %add);
    %this.rect.x += %add;
    echo("3 THIS:" SPC %this SPC "THIS RECT=" SPC %this.rect SPC "VELO=" SPC %this.velo);
    %this.rect.x += %this.velo.x * %dt;
    // // %this.rect.x += %this.velo.x * %dt;
    echo("4 THIS:" SPC %this SPC "THIS RECT=" SPC %this.rect SPC "VELO=" SPC %this.velo);
}

function cp() {
    %result = new Object(Pupser) {
        TypeVector rect = {10,10,50,50};
        TypeVector velo = {0.5,-0.5,0,0};
    };
    %result.update();
}


printSeparator();
print("--- component test ---");
$globalVec = {1,2,3,4};
%localVec = {5,6,7,8};
%obj = new Object() { TypeVector vec = {9,10,11,12}; TypeString strVec = "13 14 15 16";};

for (%i in range 10) {
    $globalVec.x ++;
    %localVec.x ++;
    %obj.vec.x ++;
    %obj.strVec.x++;
}
if ($globalVec.x != 11) error("$globalVec.x failed!"); else print("* global passed");
if (%localVec.x != 15) error("%localVec.x failed!"); else   print("* local passed");
if (%obj.vec.x != 19) error("%obj.vec.x failed!"); else    print("* field passed");
if (%obj.strVec.x != 23) error("%obj.strVec.x failed!"); else print("* strfieled passed");

vardump("$globalVec");
vardump("%localVec");
vardumpField("%obj.vec");
vardumpField("%obj.strVec");

%obj.vec.y = $globalVec.y + %localVec.y + %obj.vec.y + %obj.strVec.y; //
echo("%obj.vec.y should be 32:" SPC %obj.vec.y);

%obj.delete();


