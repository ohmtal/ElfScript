function FooBar::Hello(%this) {
    foo();
    print("Hello dynX is:" SPC %this.DynX SPC "sto is:" SPC %this);
}

if (isObject(sto)) sto.delete();
new PointStorageObject(sto) {
    class ="FooBar";
    TypeS32 DynX = 99;
    TypeF32 speed = 0.1;

};

sto.x = 1;


error("********** SPEED IS: ", sto.speed);

function foo() {
    sto.DynX++;
    echo("...." SPC sto.DynX);

}

$MODULES = "A B C D E F G H I J K L M N O P";
sto.Module = getWord($MODULES,1);
echo(sto.Module);


for (%i = 0; %i < 10; %i++) {
    sto.Keys[%i] = %i;
    %key = getWord($MODULES, %i);
    echo("* setting sto.Keys[",%key,"] to:",%i * 10);
    sto.Keys[%key] = %i * 10;

}
sto.dumpFields();


