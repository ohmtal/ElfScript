function localPoints( ) {
    sto.x = 1.0;sto.y = 2.0;sto.z = 3.0;
    %pointX = %pointY = %pointZ = 47.01;


    whereAmI();
    varDump("%pointY");
    // varDump("");
    // varDump("%localVec");

    setLocalFloatVariable("%pointY", 66.66);
    varDump("%pointY");

    echo("SET BY REFERENCE :D variables must exist");
    sto.x = 100.12; sto.y = 200.11;
    %x = $y = 0.0; //testing local AND global
    sto.getPosByReference("%x","$y");
    varDump("%x");
    varDump("$y");

    %vec = {1.5};
    echo("vec x is:" SPC %vec.x);
    %vec.x *= 2;
    %vec.y += 2;
    %vec.z += 3;
    %vec.w += 4;
    // %vec * = 2;
    varDump("%vec");


}

