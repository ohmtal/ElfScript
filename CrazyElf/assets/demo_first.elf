//------------------------------------------------------------------------------
// CrazyElf - "Hello World" example
// File: assets/demo_first.elf
//------------------------------------------------------------------------------

// ------ Init -----
if (!SDL_Init(SDL_INIT_VIDEO)) return;
%window = SDL_CreateWindow("Crazy Elf Hello World", 800, 450, 0);
if (!%window) return;
%renderer = SDL_CreateRenderer(%window);
if (!%renderer) {
    SDL_DestroyWindow(%window);
    return;
}
SDL_SetRenderVSync(%renderer, true);

%fontScale = 3.0;
// ------ Main Loop -----
while (true) {
    SDL_SetRenderDrawColor(%renderer, 60, 20, 60);
    SDL_RenderClear(%renderer);

    SDL_SetRenderScale(%renderer, %fontScale,%fontScale);
    SDL_SetRenderDrawColor(%renderer, 55,155,155);
    SDL_RenderDebugText(%renderer, 250 / %fontScale, 180 / %fontScale, "Hello World!");

    SDL_RenderPresent(%renderer);

    if (!SDL_MainLoop()) break;
    if (SDL_IsKeyPressed(SDL_SCANCODE_ESCAPE)) break;
}

// ------ Cleanup -----
SDL_DestroyRenderer(%renderer);
SDL_DestroyWindow(%window);
