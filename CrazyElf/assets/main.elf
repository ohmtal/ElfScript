$MODULES = "NativSDL blank StarField Pixels";

//------------------------------------------------------------------------------
$Global::ScreenSize = {320,200};
$Global::FPS = 60; //initial - not a limit
$Global::FrameTime = 0; //initial - not a limit
$Global::FullScreen = 0; //initial
$Global::VSync = 1; //initial
//------------------------------------------------------------------------------
function GetFrameTime() { return $Global::FrameTime; }
function GetFPS() { return $Global::FPS; }
function ToggleFullScreen() { $Global::FullScreen = !$Global::FullScreen; SDL_SetWindowFullscreen($Main.window, $Global::FullScreen); }
function ToggleVSync() { $Global::VSync = !$Global::VSync; SDL_SetRenderVSync($Main.renderer, $Global::VSync); }
//------------------------------------------------------------------------------
function Main::init(%this) {

    if (!SDL_Init()) return false;

    // I create Window ;)
    %flags = SDL_WINDOW_RESIZABLE;
    %this.window = SDL_CreateWindow("Crazy Elf.", $WindowSize.x, $WindowSize.y, %flags);


    if (!%this.window) return false;
    %this.renderer = SDL_CreateRenderer(%this.window);
    if (!%this.renderer) {
        SDL_DestroyWindow(%this.window);
        return false;
    }

    SDL_SetRenderVSync(%this.renderer, 1);


    %surface = SDL_LoadSurface("assets/texture/icon_32.png");
    if (%surface > 0) {
        SDL_SetWindowIcon(%this.window, %surface);
        SDL_DestroySurface(%surface);
    }

    Audio_Init(); //Init Audio Subsystem


    %this.scaledScreen = SDL_SetRenderLogicalPresentation(%this.renderer, $Global::ScreenSize.x,$Global::ScreenSize.y);



    %this.loadModule();

    return true;
}
//------------------------------------------------------------------------------
function Main::OnRemove(%this) {
    SDL_DestroyRenderer(%this.renderer);
    SDL_DestroyWindow(%this.window);
    if (isObject(%this.module)) %this.module.delete();
}
//------------------------------------------------------------------------------
function Main::loadModule(%this, %setNewModuleIndex) {
    if (%setNewModuleIndex !$= "" ) {
        %this.moduleIndex = %setNewModuleIndex;
    }
     %this.hideBottomMessage = false;

    %cnt = getWordCount($MODULES);
    if (%this.moduleIndex >= %cnt)  %this.moduleIndex = 0;
    if (%this.moduleIndex < 0 ) %this.moduleIndex = %cnt - 1;

    %this.moduleName = getword($MODULES, %this.moduleIndex);
    echo("---------------------------------------------------------------------");
    echo(" Load Module:" SPC %this.moduleName);
    echo("---------------------------------------------------------------------");

    if (!exec("./modules/" @ %this.moduleName @ ".elf")) {
        error("Failed to load module" SPC %this.moduleName);
        return false;
    }

    if (isObject(%this.module)) {
        %this.module.delete();
    }
    // --- old Module unloaded go ahead
    // %cmd = %this.getId() @ ".module = Create" @ %this.moduleName @ "();";
    // using the ElfScript's formatString :) not so cryptic as the concat before
    %cmd = formatString("%d.module = Create%s(%d,%d);",
                        %this.getId(), %this.moduleName,
                        %this.renderer, %this.window);


    echo("loadModule command is:" SPC %cmd);
    eval(%cmd);
    %created = isObject(%this.module);
    echo("loadModule success:" SPC %created SPC "id:" SPC %this.module.getId());

    SDL_SetWindowTitle(%this.window,FormatString( "CrazyElf (%dx%d) %s [ctrl up/down]"
        ,$Global::ScreenSize.x,$Global::ScreenSize.y, %this.moduleName
    ));


    if (!%created || !%this.module.isMethod("render")) {
        error("Module failed!! obj:" SPC %this.module SPC "method render exists:" SPC %this.module.isMethod("render"));
        if (%created) %this.module.delete();
        %this.module = 0;
        return false;
    }
    return true;
}
//------------------------------------------------------------------------------
function Main::DrawText(%this, %x, %y, %text, %scale=1.0, %colorStr, %shadow, %shadowColorStr ) {

    // %scale = 0.7;
    SDL_SetRenderScale(%this.renderer, %scale, %scale);
    SDL_RenderDebugText(%this.renderer, %x /%scale , %y/%scale, %text );
    SDL_SetRenderScale(%this.renderer, 1.0, 1.0);
}

//------------------------------------------------------------------------------
function Main::Render(%this) {


    // set the background color  <<< let the module do this!!!
    // SDL_SetRenderDrawColor(%this.renderer, 15,15,30);
    // // clear the screen
    // SDL_RenderClear(%this.renderer);


    // we scale the screen (setScreenSize) so we have to use out ScreenSize not windowSize




    if (isObject(%this.module)){
        %this.module.render();
        // if (!%this.hideBottomMessage ) %this.DrawText(5, $ScreenSize.y - 20,"Loaded module:" SPC %this.moduleName ,  1.5, BLUE, true, BLACK);
    } else {
        // ClearBackground("20 100 100");
        %this.DrawText(5, $ScreenSize.y - 20,"Failed to load module:" SPC %this.moduleName,  1.5, RED);
    }
    if ( %this.hideBottomMessage ) return;



    // %this.DrawText(2,2, { $Global::FPS , "FPS", $Global::FrameTime}, 0.8);
    %this.DrawText(2,2, { $Global::FPS , "FPS" }, 0.5);

    // %this.DrawText (5, $ScreenSize.y - 40,"CTRL + UP or DOWN to load an other module.", 1.5,  "200 200 180", true, SLATEGRAY);
    //
    //
    // %this.DrawText( 15,15, FormatString("%.4f sec. Mouse: %.0f,%.0f", GetFrameTime(), SDL_GetMouseX(), SDL_GetMouseY()) );

    // %this.DrawText($ScreenSize.x - 500, $ScreenSize.y - 10
    //     , "Mouse:" SPC strFormat("%.2f",SDL_GetMouseX()) SPC strFormat("%.2f",SDL_GetMouseY())
    //       SPC "BUTTONS:"
    //             SPC SDL_IsMouseButtonDown(SDL_BUTTON_LEFT)
    //             SPC SDL_IsMouseButtonDown(SDL_BUTTON_MIDDLE)
    //             SPC SDL_IsMouseButtonDown(SDL_BUTTON_RIGHT)
    //       SPC "WHEEL:" SPC SDL_GetMouseWheelY()
    //     , 1.2, "0 255 200");


    // draw the stuff ...
    SDL_RenderPresent(%this.renderer);

}

// -----------------------------------------------------------------------------
/*
 * OnInit is called after window is open
 */
function onInit() {
    $Main = new ScriptGroup(Main) {
        TypeS32 moduleIndex = 0;
        TypeS32 module = 0;
        TypeBool hideBottomMessage = false;
    };
    return $Main.init();

}
// -----------------------------------------------------------------------------
function onSDLMouseWheelEvent(%wheelX, %wheelY) {
    // echo("onSDLMouseWheelEvent" SPC %wheelX SPC %wheelY );
    if (isObject($Main.module)) $Main.module.onSDLMouseWheelEvent(%wheelX, %wheelY);
}
// -----------------------------------------------------------------------------
function onSDLMouseButtonEvent(%button, %isDown, %x, %y) {
    // echo("onSDLMouseButtonEvent" SPC %button SPC %isDown SPC %x SPC %y);
    if (isObject($Main.module)) $Main.module.onSDLMouseButtonEvent(%button, %isDown, %x, %y);

}

// -----------------------------------------------------------------------------
function onSDLKeyBoardEvent(%scancode, %modifiers, %isDown, %isRepeat) {
// echo("onSDLKeyBoardEvent" SPC %scancode SPC %modifiers SPC  %isDown SPC  %isRepeat);
    %ctrl =  (%modifiers & SDL_KMOD_CTRL);
    %alt  = (%modifiers & SDL_KMOD_ALT);
    %shift =  (%modifiers & SDL_KMOD_SHIFT);

    if (%isDown) {
        if (%scancode == SDL_SCANCODE_RETURN && %alt) ToggleFullScreen();

        if (%scancode == SDL_SCANCODE_HOME) ToggleVSync();

        if (%scancode == SDL_SCANCODE_R && %ctrl) {
            echo("Shortcut detected! Reload");
            rl();
        }
        if (%scancode == SDL_SCANCODE_UP && %ctrl) {
            $Main.moduleIndex--;
            $Main.loadModule();
        }
        if (%scancode == SDL_SCANCODE_DOWN && %ctrl) {
            $Main.moduleIndex++;
            $Main.loadModule();
        }

        // if (%scancode == SDL_SCANCODE_ESCAPE) quit();
    }

        if (isObject($Main.module)) $Main.module.onSDLKeyBoardEvent(%scancode, %modifiers, %isDown, %isRepeat);
}

// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
// reload helper
function rl() {
    Main.delete();
    exec("assets/main.elf");
}

function updateDocu() {
    %file = "script_stub.elf";
    // exportConsoleDocu( String fileName, bool humanreadable=false, bool append=false, bool dumpScript=true, bool dumpEngine=true )

    if (exportConsoleDocu(%file, false, false, false, true))
    {
        echo ("Docu exported to:" SPC %file);
        echo ("- In vim you can simple open it alongside the other file to use autocomplete");
        echo (" In VSCode / VSCodium you can install the Script Package (FIXME add URL)");
        echo (" and it should work automaticly as long you have it opened.");
        echo (" FIXME: fine out and docu on how to get it work when it's closed.");
    } else {
        error("Failed to export" SPC %file SPC "!");
    }
}
// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------

// scale to 320x200 ^^
$WindowSize = {640,400};

$running = onInit();

%main = Main.getId();

echo("************** %main: ", %main, " RUNNUNG: ", $running);

// hardcode variable test ^^
%performanceFrequency = SDL_GetPerformanceFrequency();
%lastTick = SDL_GetPerformanceCounter();

%fpsTimer = 0.0;
%frameCounter = 0;


// we only need to push the renderer if we scaled the screen....
%mainLoopParam = %main.scaledScreen ? %main.renderer : 0;

while ($running) {

    %tickCount = SDL_GetPerformanceCounter();

    //lol all 64bit .. let see what we get
    $Global::FrameTime = (%tickCount - %lastTick) / %performanceFrequency;


    %main.Render();
    // Main::Render(%main); //not really >>Fast call we are in a critical loop
    if (!SDL_MainLoop(%mainLoopParam)) {
        echo("quit by SDL_MainLoop");
        break;
    }

    %fpsTimer += $Global::FrameTime;
    %frameCounter++;

    if (%fpsTimer >= 1.0) { // Every 1 second
        $Global::FPS = %frameCounter;
        %frameCounter = 0;
        %fpsTimer  -= 1.0; // not 100%
    }

    // gGameTime += gFrameTime;
    %lastTick  = %tickCount;
}
Main.delete();
