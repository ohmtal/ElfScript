//----------------------------------------------------------------------
// Gui Text Widget
// using an old school input - no scrolling -
//----------------------------------------------------------------------
// NOTE: Need calls:
//  - render
//  - onSDLTextInputEvent
//  - onSDLMouseButtonEvent
//  - onSDLTextInputEvent
//
// NOTE: dont forget to call:
//  - updateBounds
//  when you changed bounds or fontSize.
//----------------------------------------------------------------------
function createGuiTextWidgetVintage(%renderer, %window, %editorBounds) {

    if( !%renderer || !%window
         || !%editorBounds.width || !%editorBounds.height
    ) {
        error("createGuiTextWidgetVintage - missing or invalid parameters!");
        printf("Renderer: %d, Window: %d, bounds:%s", %renderer, %window, %editorBounds);
        return 0;
    }

    %obj = new Group() {
        class = "GuiTextWidgetVintage";

        // dynamic:
        TypeS32 renderer = %renderer;
        TypeS32 window   = %window;
        TypeF32 cursorCounter = 0.0;
        TypeS32 Lines = 0;
        TypeS32 maxLines = 24;
        TypeS32 maxLineLength = 80;
        TypeS32 AbsolteMaxLineLength = 255; // prepare for x scrolling
        // for what ? TypeS32 longestLine = 0; // length of the longest string
        TypeS32 ScrollX = 0; // scroll offset
        TypeS32 ScrollY = 0; // scroll offset
        TypeBool dirty = false;

        TypeVector EditorBounds = %editorBounds;
        TypeVector fontScale        = {0.6, 0.8};
        TypeVector backgroundColor  = {20,20,20,255};
        TypeVector borderColor      = {150,150,150,255};
        TypeVector fontColor        = {100,255,50,255};

        TypeVector cursorPos = {0,0};
        TypeVector cursorScreenPos = {0,0,0,0};

        TypeBool onlyUpperCase = false;
        TypeBool isEnabled = true; //  read only
        TypeBool isFocused = false;

    };

    return %obj;
}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::setFocus(%this, %isFocused) {
    if (%isFocused == %this.isFocused) return ;


    %this.isFocused = %isFocused ;

    if (%this.isFocused) SDL_StartTextInput(%this.window);
    else SDL_StopTextInput(%this.window);


}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::updateBounds(%this) {
    %this.maxLines = (%this.EditorBounds.height  / (10 * %this.fontScale.y) ) - 1; //8+2
    %this.maxLineLength = (%this.EditorBounds.width  / (8 * %this.fontScale.x) ) - 2;
    printf("DEBUG: fontscale: %s",%this.fontScale);
    printf("DEBUG: bounds.width: %d font.width:%d", %this.EditorBounds.width , (8 * %this.fontScale.x) );
    printf("DEBUG: line calc: lines: %d, length: %d", %this.maxLines, %this.maxLineLength);

}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::onAdd(%this) {

    %this.add(%this.Lines = new Group() { });
    %this.updateBounds();
    %this.addLine("");
    // %this.schedule(100, AddLine,"");
    // %this.schedule(110, AddLine,"");

    return true;
}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::OnRemove(%this) {
    %this.setFocus(false);
}
//----------------------------------------------------------------------
// function GuiTextWidgetVintage::UpdateLines(%this) {
//     if (!%this.dirty) return;
//
//     %this.longestLine = 0;
//     foreach(%lineObj in %this.Lines) {
//         %len = strlen(%lineObj.text);
//         if (%len > %this.longestLine)
//             %this.longestLine = %len;
//     }
//     %this.dirty = false;
// }
//----------------------------------------------------------------------
function GuiTextWidgetVintage::RenderEditor(%this) {

    // %this.UpdateLines();

    SDL_SetRenderDrawColorVec(%this.renderer, %this.backgroundColor);
    SDL_RenderFillRect(%this.renderer,%this.EditorBounds);
    SDL_SetRenderDrawColorVec(%this.renderer, %this.borderColor);
    SDL_RenderRect(%this.renderer,%this.EditorBounds);

    SDL_SetRenderScale(%this.renderer, %this.fontScale.x, %this.fontScale.y);

    %x = (%this.EditorBounds.x + 4.0) / %this.fontScale.x;
    %y = (%this.EditorBounds.y + 4.0) / %this.fontScale.y;

    %yOffset = 8 + 2; //Debug text is 8x8
    %y = (%this.EditorBounds.y + 2.0) /  %this.fontScale.x;
    // foreach(%lineObj in %this.Lines) {
//
    %max = math.min( %this.Lines.size() , %this.ScrollY + %this.maxLines );

    // sysprint("size: ", %this.Lines.size() ," scrollY: ", %this.ScrollY ," maxlines: ", %this.maxLines, "added:", (%this.ScrollY + %this.maxLines));
    // sysprint(%this.ScrollY , "..", %max);

    for(%i in range %this.ScrollY .. %max) {
        %lineObj = %this.Lines.at(%i);
        SDL_SetRenderDrawColorVec(%this.renderer, %lineObj.color);
        //NOTE here i could add a line scrolling here but also need to change edit
        if (%this.ScrollX > 0) {
            %len = strlen(%lineObj.text);
            if (%len > %this.ScrollX) {
                SDL_RenderDebugText(%this.renderer, %x, %y,
                        getSubStr( %lineObj.text, %this.ScrollX)
                );
            }
        } else {
            SDL_RenderDebugText(%this.renderer, %x, %y,%lineObj.text);
        }
        %y += %yOffset;
    }

    if (%this.isFocused) {
        SDL_SetRenderDrawColorVec(%this.renderer, %this.fontColor);
        %this.cursorCounter += GetFrameTime();
        if ( %this.cursorCounter > 0.5 ) {
            if (%this.cursorCounter > 1.0) %this.cursorCounter-= 1.0;
        } else {
            SDL_RenderDebugText(%this.renderer, %this.cursorPos.width, %this.cursorPos.height,"_");
        }
    }
    SDL_SetRenderScale(%this.renderer);


    // -------
    %infoscale = 0.5;
    SDL_SetRenderDrawColorVec(%this.renderer, %this.fontColor);
    SDL_SetRenderScale(%this.renderer, %infoscale, %infoscale);
    SDL_RenderDebugText(%this.renderer
                        , (%this.EditorBounds.x + 3) /%infoscale
                        , (%this.EditorBounds.y + %this.EditorBounds.height - 4) / %infoscale
                        ,sprintf("cur: %02d[%02d] : %02d[%02d] L:%-3d",
                                   %this.cursorPos.x,%this.getScreenX()
                                 , %this.cursorPos.y,%this.getScreenY()
                                 , %this.Lines.size()

                         ));
    SDL_SetRenderScale(%this.renderer);

}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::getScreenX(%this) {
    return math.max( 1, %this.cursorPos.x - %this.ScrollX);
}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::getScreenY(%this) {
    return math.max( 1, %this.cursorPos.y - %this.ScrollY);
}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::setScrollX(%this, %value) {
    if (%value < 0 ) %value = 0;
    %this.ScrollX = %value;
    if (%this.cursorPos.x < %value) %this.moveCursor( %value, 0);
}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::AppendText(%this, %text) {
    if (%this.Lines.size() == 0) return;
    if (%this.onlyUpperCase) %text = strupr(%text);

    %cur = %this.Lines.at(%this.cursorPos.y - 1);
    if (!%cur) {
        error("AppendText: SYSTEM ERROR CURSORPOS.Y");
        return;
    }

    %len = strLen(%cur.text);
     if ( %len >= %this.AbsolteMaxLineLength) return;
    if (%len == 0) {
        %cur.text = %text;
    } else {
        %pre = getSubStr(%cur.text, 0, %this.cursorpos.x - 1);
        %post = getSubStr(%cur.text,%this.cursorpos.x - 1);
        %cur.text = %pre @ %text @ %post;
    }

    %this.moveCursor(strLen(%text),0);

    %this.dirty = true;

}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::onBackSpacePressed(%this) {
    if (%this.Lines.size() == 0 ) return;
    // %cur = %this.Lines.last();
    %cur = %this.Lines.at(%this.cursorPos.y - 1);
    if (!%cur) {
        error("onBackSpacePressed: SYSTEM ERROR CURSORPOS.Y");
        return;
    }
    if (%this.cursorPos.x == 1 ) // on the left we want to move up
    {
        if (%this.cursorPos.y <= 1) // we are on top ignore ir
            return;

        %prev = %this.Lines.at(%this.cursorPos.y - 2);
        if (! %prev ) {
            error("onBackSpacePressed: SYSTEM ERROR CURSORPOS.Y PREV!");
            return;
        }
        %prevLen = strLen(%prev.text);
        %prev.text = %prev.text @ %cur.text;
        %cur.delete();
        %this.moveCursor(%prevLen,-1);
    } else {
        %len = strLen(%cur.text);
        if (%len == 0) return;
        %pre = getSubStr(%cur.text, 0, %this.cursorpos.x - 2);
        %post = getSubStr(%cur.text,%this.cursorpos.x - 1);
        %cur.text = %pre @ %post;
        %this.moveCursor(-1,0);
    }


    %this.dirty = true;
}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::onDeletePressed(%this) {
    if (%this.Lines.size() == 0 ) return;
    // %cur = %this.Lines.last();
    %cur = %this.Lines.at(%this.cursorPos.y - 1);
    if (!%cur) {
        error("onDeletePressed: SYSTEM ERROR CURSORPOS.Y");
        return;
    }
    %len = strLen(%cur.text);
    if (%len == 0) return;
    if (%this.cursorpos.x > %len) return;


    %pre = getSubStr(%cur.text, 0, %this.cursorpos.x - 1);
    %post = getSubStr(%cur.text,%this.cursorpos.x );
    %cur.text = %pre @ %post;

    %this.dirty = true;
}

// no idea why but cls sucks!
//----------------------------------------------------------------------
function GuiTextWidgetVintage::cls(%this, %initialLine = "") {
    %this.Lines.clear();
    %this.Lines.push_back(new Object() { TypeString text = %initialLine; TypeVector color = %this.fontcolor; });
    %this.moveCursor(-1000,-1000);
    %this.addLine("");
}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::parser(%this, %text, %modifiers) {
    // This can be overwritten !
    // if it return true onReturnPressed skip newline
    return false;
}
//----------------------------------------------------------------------
// new line based on cursorpos
function GuiTextWidgetVintage::_newLine(%this) {
    %curLine = %this.Lines.at(%this.cursorPos.y - 1);
    if (!%curLine) {
        error("onReturnPressed: SYSTEM ERROR: CURSORPOS.Y");
        return;
    }

    %len = strlen(%curLine.text);

    %cursorWasAtBottom = %this.cursorPos.y == %this.Lines.size();

    // sysprint("_newLine at bottom:" SPC %cursorWasAtBottom);
    if (%cursorWasAtBottom && %this.cursorPos.x > %len ) {
        sysprint("AN ADD!");
        %this.AddLine("");
        %this.moveCursor(-1000,1000);
    } else {
        if ( %this.cursorPos.x <= %len || %len == 0) {
             sysprint("AN INSERT!");
            %post = getSubStr(%curLine.text, 0, %this.cursorPos.x - 1);
            %pre = getSubStr(%curLine.text,%this.cursorPos.x - 1);
            // sysprint("PRE" SPC %pre);
            // sysprint("POST" SPC %post);
            %curLine.text = %pre;
            %this.AddLine(%post,"", true);
            %this.moveCursor(-1000,1);

        } else {
          %this.moveCursor(-1000,1);
        }
    }
}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::onReturnPressed(%this, %modifiers) {
    %curLine = %this.Lines.at(%this.cursorPos.y - 1);
    if (!%curLine) {
        error("onReturnPressed: SYSTEM ERROR: CURSORPOS.Y");
        return;
    }

    %len = strlen(%curLine.text);

    if (%len > 0 && %this.isMethod("parser")) {
        // parser handled the return
        if (%this.parser(%curLine.text, %modifiers)) return;
    }

    %this._newLine();

}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::moveCursor(%this, %requestX,%requestY) {
    // // printf("MOVE CURSOR REQUEST: %d, %d CUR: %s", %requestX, %requestY, %this.cursorPos);
    if (%this.Lines.size() == 0) return;

    %this.cursorPos.y += %requestY;
    if (%this.cursorPos.y < 1 ) {
        %this.cursorPos.y = 1;
    } else if (%this.cursorPos.y > %this.lines.size()){
        %this.cursorPos.y = %this.lines.size();
    }


    if (%this.cursorPos.y  - 1 < %this.ScrollY) {
        %this.ScrollY = %this.cursorPos.y - 1;
        // sysPrint("lower new scrollY = ", %this.ScrollY);
    }
    else if (%this.cursorPos.y > %this.maxLines) {
        %this.ScrollY =  %this.cursorPos.y - %this.maxLines;
        // sysPrint( "%this.lines.size()=",%this.lines.size(),   "  %this.cursorPos.y= ",%this.cursorPos.y, "  %this.maxLines= ", %this.maxLines, " new scrollY = ", %this.ScrollY);
    }

    %curLine = %this.Lines.at(%this.cursorPos.y - 1);
    if (!%curLine) {
        error("moveCursor: SYSTEM ERROR: CURSORPOS.Y");
        return;
    }


    %curLen = strlen(%curLine.text);
    %this.cursorPos.x += %requestX;

    if (%this.cursorPos.x < 1 )
        %this.cursorPos.x = 1;
    else if (%this.cursorPos.x - 1 > %curLen) {
        %this.cursorPos.x = %curLen + 1;
    }

    if (%this.cursorPos.x  - 1 < %this.ScrollX) {
        %this.ScrollX = %this.cursorPos.x - 1;
    } else if (%this.cursorPos.x > %this.maxLineLength) {
        %newScrollX = %this.cursorPos.x - %this.maxLineLength ;
        %this.ScrollX = %newScrollX ;
    }

 // real cursor pos

    %x = (%this.EditorBounds.x + 4.0) / %this.fontScale.x;
    %y = (%this.EditorBounds.y + 4.0) / %this.fontScale.y;
    %yOffset = 8 + 2;
    // %this.cursorPos.width = %x + ( 8  * ( %this.cursorPos.x - 1 ));
    // %this.cursorPos.height= %y + ( %yOffset * ( %this.cursorPos.y - 1 ));
    // NOTE: width / height are screenPos x y
    %this.cursorPos.width = %x + ( 8  * ( %this.getScreenX() - 1 ));
    %this.cursorPos.height= %y + ( %yOffset * ( %this.getScreenY() - 1 ));


}
//----------------------------------------------------------------------
// like the old school we overwrite the next line if any
function GuiTextWidgetVintage::AddLine(%this, %text, %color = "", %insert=false) {

    %text = getSubStr( %text, 0, %this.AbsolteMaxLineLength);
    if (%this.onlyUpperCase) strupr(%text);

    %cursorWasAtBottom = %this.cursorPos.y >= %this.Lines.size() || %this.Lines.size() == 0;

    if (%cursorWasAtBottom || %insert) {

        %obj = new Object() {
            TypeString text = %text;
            TypeVector color = %color !$= "" ?  %color : %this.fontColor;
        };

        if (%insert && %this.cursorPos.y - 1 >= 0 ) {
            // sysPrint("INSERT LINE (",%obj,") AT " SPC %this.cursorPos.y - 1 SPC %text);
            %this.Lines.insert(%this.cursorPos.y - 1, %obj);
        } else {
            // sysPrint("ADDLINE LINE (",%obj,") AFTER " SPC %this.cursorPos.y - 1 SPC %text);
            // if (%this.Lines.size() == 0) %obj.dumpFields();
            %this.Lines.push_back(%obj);
            %this.moveCursor(0,1);
        }

    } else {
        %this.moveCursor(0,1);
        %curLine = %this.Lines.at(%this.cursorPos.y - 1);
        if (!%curLine) {
            error("AddLine SYSTEM ERROR: CURSORPOS.Y");
            return;
        }
        %curLine.text = %text;
        %curLine.color = %color !$= "" ?  %color : %this.fontColor;
    }
    %this.dirty = true;
}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::Render(%this) {
    if (!%this.renderer) return;

    %this.RenderEditor();

}
//----------------------------------------------------------------------
function GuiTextWidgetVintage::onSDLTextInputEvent(%this, %text) {
    if (!%this.isFocused) return;
    %this.AppendText(%text);
}
//----------------------------------------------------------------------
function  GuiTextWidgetVintage::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) {
    if (!%this.isFocused) return;
    if (%isDown) {
        switch (%scancode) {
            case SDL_SCANCODE_RETURN: %this.onReturnPressed(%modifiers);
            case SDL_SCANCODE_KP_ENTER: %this.onReturnPressed(%modifiers);
            case SDL_SCANCODE_BACKSPACE: %this.onBackSpacePressed();
            case SDL_SCANCODE_DELETE: %this.onDeletePressed();
            case SDL_SCANCODE_LEFT: %this.moveCursor(-1,0);
            case SDL_SCANCODE_RIGHT: %this.moveCursor(1,0);
            case SDL_SCANCODE_UP: %this.moveCursor(0,-1);
            case SDL_SCANCODE_PAGEUP: %this.moveCursor(0,-10);
            case SDL_SCANCODE_PAGEDOWN: %this.moveCursor(0, 10);
            case SDL_SCANCODE_DOWN: %this.moveCursor(0,1);
            case SDL_SCANCODE_HOME: %this.moveCursor(-1000,0);
            case SDL_SCANCODE_END: %this.moveCursor(1000,0);
            case SDL_SCANCODE_V :
                if (%modifiers & SDL_KMOD_CTRL) {
                    %text = SDL_GetClipboardText();
                    if (%text !$= "") %this.AddLine(%text);
                }
        }
    }

}
function  GuiTextWidgetVintage::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {

    if (!%this.isEnabled) return false;
    if (!%this.isFocused) {
        if (%button == SDL_BUTTON_LEFT
            && SDL_PointInRectFloat({%x, %y}, %this.EditorBounds)
        )  {
            %this.setFocus(true);
        }

        return;
    }

}
function  GuiTextWidgetVintage::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){}



