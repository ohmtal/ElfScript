//------------------------------------------------------------------------------
function createPixels(%renderer, %window) {

    // if ($Globals::mountAttempt == 0) EmscriptenMount();
    // $Globals::mountAttempt++;

    // if (getOS() $= "Emscripten") {
    //     if (!$Globals::mountReady ) {
    //         Main.schedule(100, loadModule); //without index parameter should work
    //         return 0;
    //     }
    // }
    if (getOS() $= "Emscripten") {
        schedule(100,0,SDL_SetWindowFullscreen,%window,1);
    }

    if (_Pixels_Load() && isObject(Pixels)){
         Pixels.renderer  = %renderer;
         Pixels.window    = %window;

         echo("----------------------------");
         echo("STORAGE IS:" SPC PixelStorage.getId());
         echo("----------------------------");

         return Pixels.getId();
    }


    %obj = new ScriptGroup(Pixels) {
        TypeS32 renderer    = %renderer;
        TypeS32 window      = %window;

        TypeS32 CanvasW     = $Global::ScreenSize.x - 8;
        TypeS32 CanvasH     = $Global::ScreenSize.y - 8;
        TypeS32 BorderTop   = 32;
        TypeS32 BorderLeft  = 8;
        TypeS32 selectedFirstIndex = -1;
        TypeVector TopLeft       = {255, 50,100}; //pink
        TypeVector TopRight      = {  0,200,255}; //cyan
        TypeVector BottomLeft    = { 80,  0,150}; //violett
        TypeVector BottomRight   = {255,150,  0}; //orange


        TypeVector CanvasBackGroundRect  =  { 0.0 ,0.0 ,0.0 ,0.0 };
        TypeVector CanvasBordeRect       =  { 0.0 ,0.0 ,0.0 ,0.0 };
        TypeVector HeaderRect            =  { 0.0 ,0.0 ,0.0 ,0.0 };
        TypeVector OverlayRect           =  { 0.0 ,0.0 ,0.0 ,0.0 };
        TypeVector SettingsButtonRect    =  { 0.0 ,0.0 ,0.0 ,0.0 };

        // status
        TypeS32 BlockSize      = 24; //24; // 16; //16; //32 ; //42; //8 .. 48
        TypeBool  cheatMode   = false; // difficult to see
        TypeS32   shuffleDelay = 1400;

        TypeBool  gameWon    = false;
        TypeBool  gridSetup  = false;
        TypeBool  menuActive = false;
        TypeBool  recordSet  = false;

        TypeBool soundOn = true;
        TypeS32   clickCount = 0;
    };
    $_LOADING = false;

    return %obj;
}
//----------------------------------------------------------------------
// TODO this can be used to calculate the available blocksizes for selection
function Pixels::getPixelCount(%this, %blockSize) {
    %w = %this.CanvasW;
    %h = %this.CanvasH;
    %borderTop  = %this.BorderTop;
    %borderLeft = %this.BorderLeft;

    %blockSize  = %this.BlockSize;

    %cols = mFloor((%w - %borderLeft) / %blockSize);
    %rows = mFloor((%h - %borderTop) / %blockSize);
    return  %cols * %rows;
}
//----------------------------------------------------------------------
function Pixels::refreshBlockSize(%this) {


    %w = %this.CanvasW;
    %h = %this.CanvasH;
    %borderTop  = %this.BorderTop;
    %borderLeft = %this.BorderLeft;

    %blockSize  = %this.BlockSize;


    %this.cols = mFloor((%w - %borderLeft) / %blockSize);
    %this.rows = mFloor((%h - %borderTop) / %blockSize);
    %this.pixelCount = %this.cols * %this.rows;

    print("Add ", %this.pixelCount, " pixels to storage. (Cols: ", %this.cols, ", Rows: ", %this.rows, ")");

    if (isObject(PixelStorage)) PixelStorage.delete();
    %this.add (new PointStorageObject(PixelStorage) {
        storageSize = %this.pixelCount;
    });

    if (isObject(SolvedPixelStorage)) SolvedPixelStorage.delete();
    %this.add(new PointStorageObject(SolvedPixelStorage) {
        storageSize = %this.pixelCount;
    });


    %this.newGame();
}
//----------------------------------------------------------------------

function Pixels::onAdd(%this) {
    echo("Pixels::onAdd ............ Loading:" SPC $_LOADING SPC "PixelStorage exists:" SPC isObject(PixelStorage));

    %w = %this.CanvasW;
    %h = %this.CanvasH;
    %borderTop  = %this.BorderTop;
    %borderLeft = %this.BorderLeft;

    %this.CanvasBackGroundRect = { %borderLeft - 2, %borderTop - 2, %w - %borderLeft + 4, %h - %borderTop + 4 };
    %this.CanvasBordeRect = { %borderLeft - 1, %borderTop - 1, %w - %borderLeft + 2, %h - %borderTop + 2 };
    %this.HeaderRect = %this.CanvasBackGroundRect;
    %this.HeaderRect.y = 0;
    %this.HeaderRect.height = %borderTop - 4;

    %this.OverlayRect = { 40 ,40, $Global::ScreenSize.x - 80, $Global::ScreenSize.y - 80};
    %this.SettingsButtonRect = { %this.HeaderRect.x + %this.HeaderRect.width - 40, %this.HeaderRect.y +7, 30,14 };

    %this.SndBlop = Audio_LoadWav("assets/sound/blop.wav");
    %this.SndShuffle = Audio_LoadWav("assets/sound/shuffle.wav");
    %this.SndWon = Audio_LoadWav("assets/sound/won.wav");


    if (!$_LOADING ) {
        %this.refreshBlockSize();
    }

    return true;
}

//----------------------------------------------------------------------
function Pixels::OnRemove(%this) {
    Audio_UnLoadWav(%this.SndBlop);
    Audio_UnLoadWav(%this.SndShuffle);
    Audio_UnLoadWav(%this.SndWon);
    _Pixels_Save();
}
//----------------------------------------------------------------------
function Pixels::newGame(%this) {
    Audio_Stop(%this.SndWon);
    %this.gameWon = false;
    %this.clickCount = 0;
    %this.recordSet = false;

    %this.gridSetup = true;

    %this.resetGrid();

    %this.PlaySound(%this.SndShuffle);

    %this.schedule(%this.shuffleDelay,shuffleGrid);
}

//----------------------------------------------------------------------
function Pixels::PlaySound(%this, %snd) {

    if (!%this.soundOn) return;
    Audio_Play(%snd);
}
//----------------------------------------------------------------------
function Pixels::shuffleGrid(%this) {
    %this.gameWon = false;
    %storage = PixelStorage.getId();
    %count = %this.pixelCount;

    print("shuffleGrid......");

    for (%i in %count - 1 .. 0 step -1) {
        %storage.fetchPoint(%i);
        if (%storage.w == 1.0) continue; // skip
        %rA = %storage.x; %gA = %storage.y; %bA = %storage.z; %wA = %storage.w;

        %j = getRandom(%i);

        %storage.fetchPoint(%j);
        if (%storage.w == 1.0) continue;

        %rB = %storage.x; %gB = %storage.y; %bB = %storage.z; %wB = %storage.w;

        %storage.x = %rB; %storage.y = %gB; %storage.z = %bB; %storage.w = %wB;
        %storage.storePoint(%i);

        %storage.x = %rA; %storage.y = %gA; %storage.z = %bA; %storage.w = %wA;
        %storage.storePoint(%j);
    }

    // %this.PlaySound(%this.SndBlop);
    %this.gridSetup = false;
    print("shuffle done");
}

//----------------------------------------------------------------------
function Pixels::dumpPixelStorage(%this) {
    for(%i in range PixelStorage.storageSize) {
        print(formatString("%d: %s", %i, PixelStorage.getPointVec(%i)));
    }
}
//----------------------------------------------------------------------
function Pixels::generateBorderColors(%this) {


    %rTL = 200 + getRandom(55);
    %gTL = getRandom(80);
    %bTL = getRandom(120);
    %this.TopLeft = { %rTL, %gTL, %bTL };

    %rTR = getRandom(80);
    %gTR = 200 + getRandom(55);
    %bTR = 100 + getRandom(155);
    %this.TopRight = { %rTR, %gTR, %bTR };

    %rBL = 50 + getRandom(100);
    %gBL = getRandom(60);
    %bBL = 200 + getRandom(55);
    %this.BottomLeft = { %rBL, %gBL, %bBL };

    %rBR = 200 + getRandom(55);
    %gBR = 120 + getRandom(100);
    %bBR = getRandom(60);
    %this.BottomRight = { %rBR, %gBR, %bBR };

}
//----------------------------------------------------------------------
function Pixels::resetGrid(%this) {

    %this.generateBorderColors();

    %storage    = PixelStorage.getId();
    %solvedPixelStorage    = SolvedPixelStorage.getId();

    %rTL = %this.TopLeft.r;    %gTL = %this.TopLeft.g;     %bTL = %this.TopLeft.b;
    %rTR = %this.TopRight.r;   %gTR = %this.TopRight.g;    %bTR = %this.TopRight.b;
    %rBL = %this.BottomLeft.r; %gBL = %this.BottomLeft.g;  %bBL = %this.BottomLeft.b;
    %rBR = %this.BottomRight.r;%gBR = %this.BottomRight.g; %bBR = %this.BottomRight.b;

    %index = 0;

    for (%gridY = 0; %gridY < %this.rows; %gridY++) {
        %pctY = %gridY / (%this.rows - 1);

        for (%gridX = 0; %gridX < %this.cols; %gridX++) {
            %pctX = %gridX / (%this.cols - 1);

            %rTop = %rTL + (%rTR - %rTL) * %pctX;
            %gTop = %gTL + (%gTR - %gTL) * %pctX;
            %bTop = %bTL + (%bTR - %bTL) * %pctX;

            %rBot = %rBL + (%rBR - %rBL) * %pctX;
            %gBot = %gBL + (%gBR - %gBL) * %pctX;
            %bBot = %bBL + (%bBR - %bBL) * %pctX;

            %finalR = mFloor(%rTop + (%rBot - %rTop) * %pctY);
            %finalG = mFloor(%gTop + (%gBot - %gTop) * %pctY);
            %finalB = mFloor(%bTop + (%bBot - %bTop) * %pctY);

            %isCorner = 0.0;
            if ((%gridX == 0 || %gridX == %this.cols - 1) && (%gridY == 0 || %gridY == %this.rows - 1)) {
                %isCorner = 1.0;
            }

            %storage.x = %finalR;
            %storage.y = %finalG;
            %storage.z = %finalB;
            %storage.w = %isCorner;

            %storage.storePoint(%index);
            %index++;
        }
    }
    foreach(%index in range %storage.storageSize) {
        %solvedPixelStorage.setPointVec(%index, %storage.getPointVec(%index));
    }
}
//----------------------------------------------------------------------
function Pixels::DrawText(%this, %x, %y, %text, %scale=1.0 /*, %colorStr, %shadow, %shadowColorStr*/ ) {

    SDL_SetRenderScale(%this.renderer, %scale, %scale);
    SDL_RenderDebugText(%this.renderer, %x /%scale , %y/%scale, %text );
    SDL_SetRenderScale(%this.renderer, 1.0, 1.0);
}
//----------------------------------------------------------------------
function Pixels::Button(%this, %rect, %text, %fontScale = 1.0) {
    %result = false;
    %r = %this.renderer;
    SDL_SetRenderDrawColor(%r, 60,60,60);
    SDL_RenderFillRect(%r, %rect);
    SDL_SetRenderDrawColor(%r, 128, 128, 128);
    SDL_RenderRect(%r, %rect);


    if (SDL_PointInRectFloat({ SDL_GetMouseX(), SDL_GetMouseY() }, %rect)) {
        SDL_SetRenderDrawColor(%r, 128, 255, 128);
        if (SDL_IsMouseButtonPressed(SDL_BUTTON_LEFT)) {
            %result = true;
        }
    } else {
        SDL_SetRenderDrawColor(%r, 205,205, 205,255);
    }
    %this.DrawText(%rect.x+6 ,%rect.y+4, %text,%fontScale);

    return %result;
}
//----------------------------------------------------------------------
function Pixels::Render(%this) {
    if (!%this.renderer) return;

    %dt = GetFrameTime();


    %r = %this.renderer;
    %blockSize  = %this.BlockSize;
    %borderTop     = %this.BorderTop;
    %borderLeft     = %this.BorderLeft;
    if(!isObject(PixelStorage)) return;
    %storage    = PixelStorage.getId();
    %solvedPixelStorage    = SolvedPixelStorage.getId();


    SDL_SetRenderDrawColor(%r, 125, 125, 145);
    SDL_RenderClear(%r);

    SDL_SetRenderDrawColor(%r, 60, 60, 60);
    SDL_RenderFillRect(%r, %this.CanvasBackGroundRect);

    %index = 0;
    for ( %gridY in range  %this.rows) {
        %y = %borderTop + (%gridY * %blockSize);

        for (%gridX in range %this.cols) {
            %x = %borderLeft + (%gridX * %blockSize);

            %storage.fetchPoint(%index);


            if (%index == %this.selectedFirstIndex) {
                SDL_SetRenderDrawColor(%r, 20, 20, 20);
            } else {
                SDL_SetRenderDrawColor(%r, %storage.x, %storage.y, %storage.z);
            }

            // Mouse:
            if (!%this.gameWon && !%this.gridSetup && !%this.menuActive) {
                if (  SDL_IsMouseButtonPressed(SDL_BUTTON_LEFT)
                    && SDL_PointInRectFloat(
                        { SDL_GetMouseX(), SDL_GetMouseY() },
                        { %x, %y, %blockSize, %blockSize })
                    ) {
                    %this.onPixelClicked(%index);
                }
            }

            SDL_RenderRectF(%r, %x, %y, %blockSize, %blockSize, true);

            if (%storage.w == 1.0 || %solvedPixelStorage.getPointVec(%index) $= %storage.getPointVec(%index)) {
                SDL_SetRenderDrawColor(%r, 200,200,200);
                SDL_RenderRectF(%r, %x + 2, %y + 2, %blockSize - 4 , %blockSize - 4 , false);
                // SDL_RenderRectF(%r, %x + %blockSize / 2 - 2, %y + %blockSize / 2 - 2, 4 , 4 , false);

            }


            if (%this.cheatMode) {
                %solvedPixelStorage.fetchPoint(%index);
                SDL_SetRenderDrawColor(%r,%solvedPixelStorage.x, %solvedPixelStorage.y, %solvedPixelStorage.z);
            }
            else if (%this.gameWon && !%this.gridSetup) {
                // SDL_SetRenderDrawColor(%r, getRandom(200 + 55), getRandom(200 + 55), getRandom(200 + 55));
                SDL_SetRenderDrawColor(%r, getRandom( 50 + 55), getRandom( 50 + 55), getRandom(50 + 55));
            }
            else {
                SDL_SetRenderDrawColor(%r, 20, 20, 20);
            }


            SDL_RenderRectF(%r, %x, %y, %blockSize, %blockSize, false);

            // ---
            %index++;
        }
    }

    if ( %this.selectedFirstIndex >= 0) {
        %selPo = %storage.getPointVec( %this.selectedFirstIndex);
        SDL_SetRenderDrawColor(%r, %selPo.x, %selPo.y, %selPo.z);
        SDL_RenderRectF(%r, SDL_GetMouseX() - %blockSize / 2, SDL_GetMouseY() - %blockSize / 2, %blockSize, %blockSize, true);
    }

    SDL_SetRenderDrawColor(%r, 128, 128, 128);
    SDL_RenderRect(%r, %this.CanvasBordeRect);



    // Write scaled text with a top and bottom line
    SDL_SetRenderDrawColor(%r, 28, 28, 28);
    SDL_RenderFillRect(%r, %this.HeaderRect);
    SDL_SetRenderDrawColor(%r, 128,20,255);
    SDL_RenderLine(%r, %this.HeaderRect.x + 2, %this.HeaderRect.y + 2, %this.HeaderRect.x + %this.HeaderRect.width - 4 , %this.HeaderRect.y + 2);
    SDL_RenderLine(%r, %this.HeaderRect.x + 2, %this.HeaderRect.height - 4, %this.HeaderRect.x + %this.HeaderRect.width - 4 , %this.HeaderRect.height - 4);
    %scale = 0.9;
    SDL_SetRenderDrawColor(%r, 255,20,128);
    SDL_SetRenderScale(%r, %scale, %scale);
    SDL_RenderDebugText(%r, 34 / %scale, 10 / %scale, "Color Sort");
    %scale = 0.6;
    SDL_SetRenderDrawColor(%r, 200,220,220);
    SDL_SetRenderScale(%r, %scale, %scale);
    SDL_RenderDebugText(%r, 140 / %scale, 7 / %scale, "Clicks:" SPC %this.clickCount);
    SDL_RenderDebugText(%r, 140 / %scale, 17 / %scale, "Size  :" SPC %this.blockSize);
     %this.DrawText(200,7, "Best:" SPC (%this.record[%this.blockSize] * 1 > 0  ? %this.record[%this.blockSize] : "---"),%scale);
    SDL_SetRenderScale(%r); //reset

    if (%this.Button(%this.SettingsButtonRect, "Menu", 0.6)) {
        %this.MenuBlockSize = %this.BlockSize;
        %this.Menuactive = true;

    }





    if (%this.menuActive) {
        SDL_SetRenderDrawBlendMode(%r, SDL_BLENDMODE_BLEND);
        SDL_SetRenderDrawColor(%r, 50,50,50,180);
        SDL_RenderFillRect(%r,%this.OverlayRect);
        SDL_SetRenderDrawBlendMode(%r, SDL_BLENDMODE_NONE);
        // a silver border
        SDL_SetRenderDrawColor(%r, 128,128, 128);
        SDL_RenderRect(%r,%this.OverlayRect);


        %y = %this.OverlayRect.y;
        %y += 5;
        %x = %this.OverlayRect.x + 10;
        SDL_SetRenderDrawColor(%r, 205,205, 205,255);
        %this.DrawText(%x,%y+1, "Menu",0.9);


        %y += 12;
        %rect = { %x , %y, 100,12 };
        // Button Sound on ...
        if (%this.Button(%rect, "Sound" SPC (%this.soundOn ? "on" : "off") , 0.6)) {
             %this.soundOn = !%this.soundOn;
        }

        // Select BlockSize
        %y += 16;
        %rect = { %x , %y, 15,12 };
        if (%this.Button(%rect, "<", 0.6) ) {
            %this.MenuBlockSize = mClamp(%this.MenuBlockSize - 2, 8, 48);
        }
        SDL_SetRenderDrawColor(%r, 205,205, 205,255);
        %this.DrawText(%x+17,%y+4, "BlockSize:" SPC %this.MenuBlockSize,0.6);
        %rect = { %x + 85, %y, 15,12 };
        if (%this.Button(%rect, ">", 0.6) ) {
            %this.MenuBlockSize = mClamp(%this.MenuBlockSize + 2, 8, 48);
        }

        %y = %this.OverlayRect.y + %this.OverlayRect.height - 18;
        %rect = { %x , %y, 60,12 };
        // Button Sound on ...
        if (%this.Button(%rect, "Apply", 0.6) ) {
            if (%this.BlockSize != %this.MenuBlockSize) {
                %this.BlockSize = %this.MenuBlockSize;
                %this.refreshBlockSize();
            }
            %this.menuActive = false;
        }

        // %y += 20;
        %rect = { %x + 62, %y, 50,12 };
        // Button Sound on ...
        if (%this.Button(%rect, "Close", 0.6) ) {
            %this.menuActive = false;
        }

        // %y += 20;
        %rect = { %x + 164, %y, 60,12 };
        // Button Sound on ...
        if (%this.Button(%rect, "Quit Game", 0.6) ) {
            quit();
        }




    } else if (%this.gameWon) {
        SDL_SetRenderDrawBlendMode(%r, SDL_BLENDMODE_BLEND);
        SDL_SetRenderDrawColor(%r, 50,50,50,180);
        SDL_RenderFillRect(%r,%this.OverlayRect);
        SDL_SetRenderDrawBlendMode(%r, SDL_BLENDMODE_NONE);
        // a silver border
        SDL_SetRenderDrawColor(%r, 128,128, 128);
        SDL_RenderRect(%r,%this.OverlayRect);

        %y = %this.OverlayRect.y;
        %y += 20;
        SDL_SetRenderDrawColor(%r, 28,28, 28,255);
        %this.DrawText(91,%y+1, "You Won!",2);
        SDL_SetRenderDrawColor(%r, 100,100,200);
        %this.DrawText(90,%y, "You Won!",2);
        // %this.DrawText(96,%y+1, "Solved!",2);
        // SDL_SetRenderDrawColor(%r, 100,100,200);
        // %this.DrawText(95,%y, "Solved!",2);


        SDL_SetRenderDrawColor(%r, 200,200,200);
        %y += 30;
        %this.DrawText(92,%y,  "Clicks:" SPC %this.clickCount,1.3);


        SDL_SetRenderDrawColor(%r, 200,220,28);
        %y += 20;
        %this.DrawText(92,%y, "Best  :" SPC %this.record[%this.blockSize],1.3);

        %y += 20;
        if (%this.recordSet) {
            SDL_SetRenderDrawColor(%r, 28,28,28);
            %this.DrawText(46,%y+1, "You set a new record !",1.3 );
            SDL_SetRenderDrawColor(%r, 255,20,28);
            %this.DrawText(45,%y, "You set a new record !",1.3 );
        }


        $ignoreButtonTimer += %dt;
        if ($ignoreButtonTimer > 1.5) {
            SDL_SetRenderDrawColor(%r, 205,205,225);
            %y += 20;
            %this.DrawText(102,%y, "Click for new puzzle.",0.7);
            if (SDL_IsMouseButtonPressed(SDL_BUTTON_LEFT)) {
                $ignoreButtonTimer = 0.0;
                %this.newGame();
            }
        }


    }




    //----- reset color .......
    SDL_SetRenderDrawColor(%r, 255, 255, 255);
}

//----------------------------------------------------------------------
function Pixels::checkWinCondition(%this) {

    %this.clickCount++;

    %storage = PixelStorage.getId();
    %solvedPixelStorage    = SolvedPixelStorage.getId();
    foreach(%index in range %storage.storageSize) {
        // string compare good idea ?
        if (%solvedPixelStorage.getPointVec(%index) !$= %storage.getPointVec(%index))
            return false;
    }


    return true;

}

//----------------------------------------------------------------------
function  Pixels::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) {
    if (!%isDown) return ;
    switch (%scancode) {
        // case SDL_SCANCODE_SPACE: if (%this.gameWon) %this.newGame();
        case SDL_SCANCODE_F5:
            if (isDebugBuild()) {
                exec("assets/modules/Pixels.elf");
            }
    }
}
//----------------------------------------------------------------------

function Pixels::onPixelClicked(%this, %clickedIndex) {

    if (%this.gameWon || %this.gridSetup || %this.menuActive) return;

    if (%clickedIndex == -1) return;


    %storage = PixelStorage.getId();
    %solvedPixelStorage = SolvedPixelStorage.getId();
    if (%storage.getPointW(%clickedIndex) == 1.0) {
        return;
    }

    if (%this.selectedFirstIndex == -1) {
        %this.selectedFirstIndex = %clickedIndex;
    } else {
        %idxA = %this.selectedFirstIndex;
        %idxB = %clickedIndex;

        %this.selectedFirstIndex = -1;



        if (%idxA != %idxB) {
            %bucket = %storage.getPointVec(%idxA);
            %storage.setPointVec(%idxA, %storage.getPointVec(%idxB));
            %storage.setPointVec(%idxB, %bucket);

            if (
                %storage.getPointVec(%idxA) $= %solvedPixelStorage.getPointVec(%idxA)
                || %storage.getPointVec(%idxB) $= %solvedPixelStorage.getPointVec(%idxB)
            ) {
                %this.PlaySound(%this.SndBlop);
            }
            // print("Pixel swap: ", %idxA, " with ", %idxB);
        }  else {
           return;
        }

        if (%this.checkWinCondition()) {
            %this.PlaySound(%this.SndWon);
            %this.gameWon = true;

            if (%this.record[%this.blockSize] $= ""
                ||  %this.record[%this.blockSize] > %this.clickCount) {
                    %this.recordSet = true;
                    %this.record[%this.blockSize] = %this.clickCount;
                }

        }
    }
}


function  Pixels::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {
    if (!%isDown) return ;

    if (%button == SDL_BUTTON_RIGHT) {
        %this.selectedFirstIndex = -1;
        return;
    }

}
function  Pixels::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){}
