//----------------------------------------------------------------------
function  Pixels::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) {
    if (!%isDown) return ;
    switch (%scancode) {
        case SDL_SCANCODE_SPACE: if (%this.gameWon) %this.newGame();
    }
}
function  Pixels::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {
    if (!%isDown) return ;


    if (%button == SDL_BUTTON_RIGHT) {
        %this.selectedFirstIndex = -1;
        return;
    }
    if (%button != SDL_BUTTON_LEFT) return;

    if (%this.gameWon) return;

    %clickedIndex = %this.getGridIndexFromMouse(%x, %y);
    if (%clickedIndex == -1) return;


    %storage = Storage.getId();
    %solvedStorage = SolvedStorage.getId();
    if (%storage.getPointW(%clickedIndex) == 1.0) {
        return;
    }

    if (%this.selectedFirstIndex == -1) {
        %this.selectedFirstIndex = %clickedIndex;
        // print("first pixel at index: ", %clickedIndex);
    } else {
        %idxA = %this.selectedFirstIndex;
        %idxB = %clickedIndex;

        %this.selectedFirstIndex = -1;



        if (%idxA != %idxB) {
            %bucket = %storage.getPointVec(%idxA);
            %storage.setPointVec(%idxA, %storage.getPointVec(%idxB));
            %storage.setPointVec(%idxB, %bucket);

            if (
                %storage.getPointVec(%idxA) $= %solvedStorage.getPointVec(%idxA)
                || %storage.getPointVec(%idxB) $= %solvedStorage.getPointVec(%idxB)
            ) {
                Audio_Play(%this.SndBlop);
            }
            // print("Pixel swap: ", %idxA, " with ", %idxB);
        }  else {
           return;
        }

        if (%this.checkWinCondition()) {
            Audio_Play(%this.SndBlop);schedule(500,0,Audio_Play,%this.SndBlop);schedule(300,0,Audio_Play,%this.SndBlop);
            %this.gameWon = true;
        }
    }
}
function  Pixels::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){}
