
$_DISABLE_SAVE_LOAD = false;

echo("Pixels running on " SPC getOS());

//

/*
 Color Sort
 ==========
 Pixel Puzzle Color Sort is a relaxing yet challenging logic puzzle game where your goal is to restore order to a corrupted grid of colors. The pixels have been scrambled, and only you can heal the canvas by recreating a perfect color gradient.

 Objective
 Rearrange the scrambled color pixels so they form a perfectly smooth, seamless transition (gradient) between the four fixed corner tiles.

 How to Play

 1. Spot the Anchor Points (Fixed Corners)
 - Look for the four corner pixels on the grid.
 - These tiles are marked with a white border.
 - Important: These corners are permanently fixed in their correct positions. They cannot be clicked, moved, or swapped. Use them as your ultimate guide!

 2. Swap Pixels to Restore the Canvas
 - Left-Click on any standard pixel to select it.
 - Left-Click on a second pixel to swap their positions and colors.

 Strategically move the colors closer to their matching corners (e.g., drag reddish pixels toward the pink corner, cyan pixels toward the blue corner).

 3. Win the Game
 - The puzzle is solved the exact moment every single pixel is back in its mathematically correct position.
 - Once the grid forms a flawlessly smooth color blanket, you win!

 Difficulty Levels

 You can adjust the difficulty of the puzzle by changing the Block Size:

 - Easy Mode (Large Blocks): Perfect for a quick, relaxing session.
 - Hard Mode (Small Blocks): The ultimate challenge. A massive grid filled with high-contrast, vibrant colors that will truly test your perception of color nuances.
 */
//----------------------------------------------------------------------
$_PixelsFileName = SDL_GetPrefPath("Ohmtal", "Pixels") @ "userdata.elfdata";



//NOTE Emscriten check mount: Module.FS.mounts.map(m => ({ point: m.mountpoint, type: m.type.mount.name, opts: m.opts }));

function _Pixels_Save(%filename = $_PixelsFileName) {
    if ($_DISABLE_SAVE_LOAD) return false;
    echo("Saving" SPC %fileName SPC ".......");
    if (!Pixels.save($_PixelsFileName)) {
        error("Failed to save " SPC %filename);
        return false;
    }
    EmscriptenSync();
    return true;
}
function _Pixels_Load(%filename = $_PixelsFileName) {
    if ($_DISABLE_SAVE_LOAD) return false;

    echo("DIRECTORY exists? " SPC SDL_FileExists(SDL_GetPrefPath("Ohmtal", "Pixels")));
    echo("FILE exists? " SPC %filename SPC SDL_FileExists(%filename));


    if (SDL_FileExists(%filename)) {
        echo("Loading" SPC %fileName SPC ".......");
        $_LOADING = true;
        if (isObject(Pixels)) Pixels.delete();
        exec(%filename);
        $_LOADING = false;
    } else {
        return false;
    }
    return true;
}
