//----------------------------------------------------------------------
function Pixels::resetGrid(%this) {

    %this.generateBorderColors();

    %storage    = Storage.getId();
    %solvedStorage    = SolvedStorage.getId();

    %rTL = %this.TopLeft.r;    %gTL = %this.TopLeft.g;     %bTL = %this.TopLeft.b;
    %rTR = %this.TopRight.r;   %gTR = %this.TopRight.g;    %bTR = %this.TopRight.b;
    %rBL = %this.BottomLeft.r; %gBL = %this.BottomLeft.g;  %bBL = %this.BottomLeft.b;
    %rBR = %this.BottomRight.r;%gBR = %this.BottomRight.g; %bBR = %this.BottomRight.b;

    %index = 0;

    for (%gridY = 0; %gridY < %this.rows; %gridY++) {
        %pctY = %gridY / (%this.rows - 1);

        for (%gridX = 0; %gridX < %this.cols; %gridX++) {
            %pctX = %gridX / (%this.cols - 1);

            %rTop = %rTL + (%rTR - %rTL) * %pctX;
            %gTop = %gTL + (%gTR - %gTL) * %pctX;
            %bTop = %bTL + (%bTR - %bTL) * %pctX;

            %rBot = %rBL + (%rBR - %rBL) * %pctX;
            %gBot = %gBL + (%gBR - %gBL) * %pctX;
            %bBot = %bBL + (%bBR - %bBL) * %pctX;

            %finalR = mFloor(%rTop + (%rBot - %rTop) * %pctY);
            %finalG = mFloor(%gTop + (%gBot - %gTop) * %pctY);
            %finalB = mFloor(%bTop + (%bBot - %bTop) * %pctY);

            %isCorner = 0.0;
            if ((%gridX == 0 || %gridX == %this.cols - 1) && (%gridY == 0 || %gridY == %this.rows - 1)) {
                %isCorner = 1.0;
            }

            %storage.x = %finalR;
            %storage.y = %finalG;
            %storage.z = %finalB;
            %storage.w = %isCorner;

            %storage.storePoint(%index);
            %index++;
        }
    }
    foreach(%index in range %storage.storageSize) {
        %solvedStorage.setPointVec(%index, %storage.getPointVec(%index));
    }
}
//----------------------------------------------------------------------
function Pixels::onAdd(%this) {
    %w = %this.CanvasW;
    %h = %this.CanvasH;
    %border = %this.Border;
    %blockSize = %this.BlockSize;

    %this.CanvasBackGroundRect = { %border - 2, %border - 2, %w - %border + 4, %h - %border + 4 };
    %this.CanvasBordeRect = { %border - 1, %border - 1, %w - %border + 2, %h - %border + 2 };
    %this.HeaderRect = %this.CanvasBackGroundRect;
    %this.HeaderRect.y = 0;
    %this.HeaderRect.height = %border - 4;

    %this.cols = mFloor((%w - %border) / %blockSize);
    %this.rows = mFloor((%h - %border) / %blockSize);
    %this.pixelCount = %this.cols * %this.rows;

    print("Add: ", %this.pixelCount, " pixels to storage. (Cols: ", %this.cols, ", Rows: ", %this.rows, ")");

    %this.SndBlop = Audio_LoadWav("assets/sound/blop.wav");


    if (! $_LOADING ) {

        %this.add (new PointStorageObject(Storage) {
            storageSize = %this.pixelCount;
        });

        %this.add(new PointStorageObject(SolvedStorage) {
            storageSize = %this.pixelCount;
        });

        %this.newGame();
    } else {
        print(".... skip object create we did load a game ....");
    }

    return true;
}

//----------------------------------------------------------------------
function Pixels::OnRemove(%this) {
    Audio_UnLoadWav(%this.SndBlop);
}
//----------------------------------------------------------------------
function Pixels::Render(%this) {
    if (!%this.renderer) return;

    %r = %this.renderer;
    %blockSize  = %this.BlockSize;
    %border     = %this.Border;
    if(!isObject(Storage)) return;
    %storage    = Storage.getId();
    %solvedStorage    = SolvedStorage.getId();


    SDL_SetRenderDrawColor(%r, 125, 125, 145);
    SDL_RenderClear(%r);

    SDL_SetRenderDrawColor(%r, 60, 60, 60);
    SDL_RenderFillRect(%r, %this.CanvasBackGroundRect);

    // FIXME CACHE RENDERING !!!!

    %index = 0;
    // for (%gridY = 0; %gridY < %this.rows; %gridY++) {
    for ( %gridY in range  %this.rows) {
        %y = %border + (%gridY * %blockSize);

        // for (%gridX = 0; %gridX < %this.cols; %gridX++) {
        for (%gridX in range %this.cols) {
            %x = %border + (%gridX * %blockSize);

            %storage.fetchPoint(%index);


            if (%index == %this.selectedFirstIndex) {
                SDL_SetRenderDrawColor(%r, 20, 20, 20);
            } else {
                SDL_SetRenderDrawColor(%r, %storage.x, %storage.y, %storage.z);
            }
            SDL_RenderRectF(%r, %x, %y, %blockSize, %blockSize, true);

            if (%storage.w == 1.0 || %solvedStorage.getPointVec(%index) $= %storage.getPointVec(%index)) {
                SDL_SetRenderDrawColor(%r, 160,160,160);
                SDL_RenderRectF(%r, %x, %y, %blockSize, %blockSize, false);
            } else {

                    if (%this.cheatMode) {
                        %solvedStorage.fetchPoint(%index);
                        SDL_SetRenderDrawColor(%r,%solvedStorage.x, %solvedStorage.y, %solvedStorage.z);
                    }
                    else SDL_SetRenderDrawColor(%r, 20, 20, 20);


                SDL_RenderRectF(%r, %x, %y, %blockSize, %blockSize, false);
            }

            %index++;
        }
    }

    if ( %this.selectedFirstIndex >= 0) {
        %selPo = %storage.getPointVec( %this.selectedFirstIndex);
        SDL_SetRenderDrawColor(%r, %selPo.x, %selPo.y, %selPo.z);
        SDL_RenderRectF(%r, SDL_GetMouseX() - %blockSize / 2, SDL_GetMouseY() - %blockSize / 2, %blockSize, %blockSize, true);
    }

    SDL_SetRenderDrawColor(%r, 128, 128, 128);
    SDL_RenderRect(%r, %this.CanvasBordeRect);



    // Write scaled text with a top and bottom line
    SDL_SetRenderDrawColor(%r, 28, 28, 28);
    SDL_RenderFillRect(%r, %this.HeaderRect);
    SDL_SetRenderDrawColor(%r, 128,20,255);
    SDL_RenderLine(%r, %this.HeaderRect.x + 2, %this.HeaderRect.y + 2, %this.HeaderRect.x + %this.HeaderRect.width - 4 , %this.HeaderRect.y + 2);
    %scale = 0.9;
    SDL_SetRenderScale(%r, %scale, %scale);
    SDL_RenderDebugText(%r, 34 / %scale, 10 / %scale, "Color Sort");
    %scale = 0.6;
    SDL_SetRenderDrawColor(%r, 128,20,255);
    SDL_SetRenderScale(%r, %scale, %scale);
    SDL_RenderDebugText(%r, 140 / %scale, 08 / %scale, "Clicks:" SPC %this.clickCount);
    SDL_RenderDebugText(%r, 140 / %scale, 18 / %scale, "Size  :" SPC %this.blockSize);
    SDL_RenderDebugText(%r, 220 / %scale, 13 / %scale, "WON*  :" SPC %this.gameWon);
    SDL_SetRenderScale(%r); //reset
    SDL_RenderLine(%r, %this.HeaderRect.x + 2, %this.HeaderRect.height - 4, %this.HeaderRect.x + %this.HeaderRect.width - 4 , %this.HeaderRect.height - 4);

    //----- reset color .......
    SDL_SetRenderDrawColor(%r, 255, 255, 255);
}

