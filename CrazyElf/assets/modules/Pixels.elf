function Save() { Pixels.save("test.sto"); }
function Load() { $_LOADING = true; Pixels.delete(); schedule(0,0,postLoad); }
function postLoad() { exec("test.sto"); $main.module = Pixels.getId(); $_LOADING = false; }
//

/*
 � �* Color Sort:
 Pixel Puzzle Color Sort is a relaxing yet challenging logic puzzle game where your goal is to restore order to a corrupted grid of colors. The pixels have been scrambled, and only you can heal the canvas by recreating a perfect color gradient.

 🕹️ ObjectiveRearrange the scrambled color pixels so they form a perfectly smooth, seamless transition (gradient) between the four fixed corner tiles.

 📖 How to Play

 1. Spot the Anchor Points (Fixed Corners)
 - Look for the four corner pixels on the grid.
 - These tiles are marked with a glowing white border ⬜.
 - Important: These corners are permanently fixed in their correct positions. They cannot be clicked, moved, or swapped. Use them as your ultimate guide!

 2. Swap Pixels to Restore the CanvasLeft
 - Click on any standard pixel to select it. It will be highlighted with a blue border 🟦.
 - Left-Click on a second pixel to swap their positions and colors.Strategically move the colors closer to their matching corners (e.g., drag reddish pixels toward the pink corner, cyan pixels toward the blue corner).

 3. Win the Game
 - The puzzle is solved the exact moment every single pixel is back in its mathematically correct position.
 - Once the grid forms a flawlessly smooth color blanket, you win!

 ⚙️ Difficulty Levels

 You can adjust the difficulty of the puzzle by changing the Block Size:

 - Easy Mode (Large Blocks): Perfect for a quick, relaxing session. The colors automatically shift into a soft, gentle pastel palette, making it easier on the eyes and faster to solve.
 - Hard Mode (Small Blocks): The ultimate challenge. A massive grid filled with high-contrast, vibrant colors that will truly test your perception of color nuances.
 */
//----------------------------------------------------------------------
function createPixels(%renderer, %window) {
    %obj = new ScriptGroup(Pixels) {
        TypeS32 renderer    = %renderer;
        TypeS32 window      = %window;

        TypeS32 CanvasW     = $Global::ScreenSize.x - 32;
        TypeS32 CanvasH     = $Global::ScreenSize.y - 32;
        TypeS32 Border      = 32;
        TypeS32 selectedFirstIndex = -1;
        TypeColor TopLeft       = {255, 50,100}; //pink
        TypeColor TopRight      = {  0,200,255}; //cyan
        TypeColor BottomLeft    = { 80,  0,150}; //violett
        TypeColor BottomRight   = {255,150,  0}; //orange

        // status
        TypeS32 BlockSize      = 16; //16; //32 ; //42; //8 .. 42
        TypeBool  cheatMode   = false; // difficult to see
        TypeS32   shuffleDelay = 2000;

        TypeBool  gameWon    = false;
        TypeS32   clickCount = 0;
    };
    $_LOADING = false;
    return %obj;
}
//----------------------------------------------------------------------
function Pixels::newGame(%this) {
      // %this.gameWon = false;
      %this.clickCount = 0;

       %this.resetGrid();

      %this.schedule(%this.shuffleDelay,shuffleGrid);
}
//----------------------------------------------------------------------
function Pixels::getGridIndexFromMouse(%this, %mouseX, %mouseY) {
    %border = %this.Border;
    %blockSize = %this.BlockSize;

    if (%mouseX < %border || %mouseX >= %this.CanvasW) return -1;
    if (%mouseY < %border || %mouseY >= %this.CanvasH) return -1;

    %gridX = mFloor((%mouseX - %border) / %blockSize);
    %gridY = mFloor((%mouseY - %border) / %blockSize);

    %cols = (%this.CanvasW - %border) / %blockSize;

    %index = (%gridY * %cols) + %gridX;
    return %index;
}
//----------------------------------------------------------------------
function Pixels::shuffleGrid(%this) {
    %this.gameWon = false;
    %storage = Storage.getId();
    %count = %this.pixelCount;

    print("shuffleGrid......");

    for (%i in %count - 1 .. 0 step -1) {
        %storage.fetchPoint(%i);
        if (%storage.w == 1.0) continue; // skip
        %rA = %storage.x; %gA = %storage.y; %bA = %storage.z; %wA = %storage.w;

        %j = getRandom(%i);

        %storage.fetchPoint(%j);
        if (%storage.w == 1.0) continue;

        %rB = %storage.x; %gB = %storage.y; %bB = %storage.z; %wB = %storage.w;

        %storage.x = %rB; %storage.y = %gB; %storage.z = %bB; %storage.w = %wB;
        %storage.storePoint(%i);

        %storage.x = %rA; %storage.y = %gA; %storage.z = %bA; %storage.w = %wA;
        %storage.storePoint(%j);
    }

    Audio_Play(%this.SndBlop);
    print("shuffle done");
}

//----------------------------------------------------------------------
function Pixels::dumpStorage(%this) {
    for(%i in range Storage.storageSize) {
        print(formatString("%d: %s", %i, Storage.getPointVec(%i)));
    }
}
