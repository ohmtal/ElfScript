// .----.
//
// Script based partial grid with objects..
//
// .----.

// bad idea i guess ;)
#define INT TypeS32
#define FLOAT TypeF32
#define STRING TypeString
#define VECTOR TypeVector

#define PIXEL_SIZE 4.0
#define INITAL_COUNT 2
#define UPDATE_TIME 0.05
#define CANVAS_WIDTH 250.0
#define CANVAS_HEIGHT 200.0


function createPlayGround(%renderer, %window) {
    %obj = new Group(PlayGround) {
        TypeS32 renderer = %renderer;
        TypeS32 window   = %window;

        TypeF32 updateDT = 0.0;
    };


    return %obj;
}
//----------------------------------------------------------------------
function Pupser::onAdd(%this) { }
function Pupser::onRemove(%this) { }

function Pupser::Update(%this, %dt) {
    echo("1 THIS:" SPC %this SPC "THIS RECT=" SPC %this.rect SPC "VELO=" SPC %this.velo);
    %this.rect.x += %this.velo.x * %dt;
    echo("2 THIS:" SPC %this SPC "THIS RECT=" SPC %this.rect SPC "VELO=" SPC %this.velo);
    if (%this.rect.x  > CANVAS_WIDTH - PIXEL_SIZE) {
        %this.rect.x = CANVAS_WIDTH - PIXEL_SIZE;
        %this.velo.x *= -1.0;
    } else if (%this.rect.x < 0.0) {
        %this.rect.x = 0.0;
        %this.velo.x *= -1.0;
    }

    %this.rect.y += %this.velo.y * %dt;
    if (%this.rect.y > CANVAS_HEIGHT - PIXEL_SIZE) {
        %this.rect.y = CANVAS_HEIGHT - PIXEL_SIZE;
        %this.velo.y *= -1.0;
    } else if (%this.rect.y < 0.0) {
        %this.rect.y = 0.0;
        %this.velo.y *= -1.0;
    }

    %pos = {%this.rect.x, %this.rect.y};
    %nodeRect = %this.node.rect;
    if ( %this.node == 0)  {
        %this.node = Grid.getNode(%pos.x, %pos.y);
        %this.node.add(%this);
    } else if ( !Vec4PointInRect( "%pos", "%nodeRect")) { // by reference

        %this.node.remove(%this);
        %this.node = Grid.getNode(%pos.x, %pos.y);
        // echo("MOVE object ", %this, " to node: ", %this.node);
        %this.node.add(%this);
    }
}

//----------------------------------------------------------------------
function Grid::getNode(%this, %x, %y) {
    %xNode = mFloor(%x / %this.nodeSize);
    %yNode = mFloor(%y / %this.nodeSize);
    %node  = %xNode + %yNode * %this.nodesX;


    if (%node < %this.getCount()) {
        %obj = %this.getObject(%node);
        // echo(FormatString("NODE: %d, %d/%d {%s}", %node, %xNode, %yNode, %obj.rect));
        return %obj;
    }
    return 0;
}

function Grid::onAdd(%this) {
    if (!%this.nodeSize) %this.nodeSize = 50.0;
    %this.nodesX = CANVAS_WIDTH / %this.nodeSize;
    echo("XNODES: ", %this.nodesX);
    %this.nodesY = CANVAS_HEIGHT / %this.nodeSize;
    for (%j in range %this.nodesY)
     for (%i in range %this.nodesX) {
        %node = new SimSet() {
            VECTOR rect = {
              ( %i * %this.nodeSize ),
              ( %j * %this.nodeSize ),
              %this.nodeSize,
              %this.nodeSize
            };
        };
        // %node.dumpFields();
        echo( formatString("NODE[%d]: %d,%d pos %7.2f, %7.2f", %node, %i,%j, %node.rect.x, %node.rect.y));
        %this.add(%node);
    }
}
//----------------------------------------------------------------------
function PlayGround::onAdd(%this) {

    %this.add(new Group(PupserGroup));

    %this.add(new Group(Grid) {
        FLOAT nodeSize = 50.0;
        INT   nodesX = 0;
        INT   nodesY = 0;
    });

    for (%i in range INITAL_COUNT) {
        %pupser = new Object() {
            class   = "Pupser";
            VECTOR  rect    = { GetRandomF(CANVAS_WIDTH),  GetRandomF(CANVAS_HEIGHT), PIXEL_SIZE, PIXEL_SIZE};
            INT     gender  = GetRandom(1);
            FLOAT   age     = 0.0;
            VECTOR  velo    = { GetRandomF(-10.0,10.0), GetRandomF(-10.0,10.0) };
            INT     Node    = 0;
        };
        %pupser.dumpFields();
        PupserGroup.add(%pupser);
    }

    // %pupser.dumpFields();

    return true;
}
//----------------------------------------------------------------------
function PlayGround::OnRemove(%this) { }
//----------------------------------------------------------------------
function PlayGround::Render(%this) {
    if (!%this.renderer) return;
    %r  = %this.renderer;
    %dt = GetFrameTime();
    %this.updateDT += %dt;
    %doUpdate = %this.updateDT > UPDATE_TIME;
    if (%doUpdate) {
        %udt = %this.updateDT;
        %this.updateDT -= UPDATE_TIME;
    }

    SDL_SetRenderDrawColor(%r, 20, 20, 40);
    SDL_RenderClear(%r);

    SDL_SetRenderDrawColor(%r, 20, 50, 20);
    SDL_RenderRectF(%r, 0,0,CANVAS_WIDTH, CANVAS_HEIGHT, true);

    %scale = 0.7;
    foreach(%node in Grid) {
        SDL_SetRenderDrawColor(%r, 180, 180, 180);
        SDL_SetRenderScale(%r, %scale, %scale);
        SDL_RenderDebugText(%r, (%node.rect.x + 3.0 ) / %scale, (%node.rect.y + 3.0)/ %scale, %node.getCount());
        SDL_SetRenderScale(%r);
        SDL_SetRenderDrawColor(%r, 80, 80, 80);
        SDL_RenderRect(%r, %node.rect);
    }

    foreach(%pupser in PupserGroup) {
        if (%doUpdate) {
            %pupser.update(%udt);
        }

        if (%pupser.gender == 0) SDL_SetRenderDrawColor(%r,   0,   0, 200);
        else SDL_SetRenderDrawColor(%r,   200,   0, 0);

        SDL_RenderRect(%r, %pupser.rect);
    }


    SDL_SetRenderDrawColor(%r, 55,55,55);
    %scale = 0.7;
    SDL_SetRenderScale(%r, %scale, %scale);
    SDL_RenderDebugText(%r, (CANVAS_WIDTH + 5) / %scale , 7, getFPS() SPC "FPS");
    SDL_SetRenderDrawColor(%r, 255,255,255);
    SDL_RenderDebugText(%r, (CANVAS_WIDTH + 4) / %scale, 6, getFPS() SPC "FPS");
    SDL_SetRenderScale(%r);
}
//----------------------------------------------------------------------
function  PlayGround::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) { }
function  PlayGround::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {}
function  PlayGround::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){}


