//----------------------------------------------------------------------
// Squash mit cursor up/down for paddle and space for start game
//  Evolution AI with F12 - but Evolution takes ages until it works ..
//  Learn would be better ... F11>> %this.AI.Learn = true;
//----------------------------------------------------------------------
function createSquash(%renderer, %window) {
    %obj = new Group() {
        class = "Squash";
        TypeS32 renderer = %renderer;
        TypeS32 window   = %window;
        TypeVector saveSize = {0};
        TypeU32    main     = $Main;
        TypeF32    textScale = 0.0;

        TypeU32    ball      = 0;
        TypeU32    paddle    = 0;
        TypeU32    AI        = 0;
        TypeString  AIFile   = "squashBrain.elfdata";

        TypeBool   GameOver  = true;
        TypeS32    score     = 0;
    };

    return %obj;
}
//----------------------------------------------------------------------
function Squash::startGame(%this) {
    if (%this.GameOver) {
        %this.ball.dir =  {-1.0, math.randomf(-1.0, 1.0)};
        %this.ball.speed     = 10.0;
        %this.paddle.rect =  {35,10,1,5};
        %this.GameOver = false;
        %this.score = 0;
    }
}
//----------------------------------------------------------------------
function Squash::onAdd(%this) {
    %this.saveSize = $Global::ScreenSize;
    %this.main.setScreenSize({40,24});


    %this.add(%this.ball = new Object(){
       TypeVector pos =  {20,12};
       TypeVector dir = {-1.0, math.randomf(-1.0, 1.0)};
       TypeF32    speed     = 10.0;
       TypeVector dnorm     = {0}; //for AI
       TypeF32    maxSpeed  = 2.0;
    });

    %this.add(%this.paddle = new Object(){
        TypeVector rect =  {35,10,1,5};
        TypeF32    speed = 20.0;
        TypeF32    dir   = 0.0;

    });

    %this.add( %this.AI =  new NeuralNetObject(){
        TypeBool    active = false;
        TypeF64     fitness = 0.0;
        TypeF64     BestFitness = 0.0;
        TypeBool    Learn = false;

        TypeS64     PopulationSize = 20;
        TypeS64     CurrentGeneration = 1;
        TypeS64     CurrentAgentIndex = 0;

    });
    if (!%this.AI.load(%this.AIFile)) {
        // Inputs: see below
        // OutPuts:
        // 0: direction -1.0 / 1.0


        %this.AI.Init(5, 1, 5, 1);
    }
    // F11 %this.AI.Learn = true;

    %this.AI.setActivationHidden(2); // ReLU  for hidden layers!
    %this.AI.setActivationOutput(1); // Tanh for symmetrical steering (-1 to 1)
    // %this.AI.WarmUP(); // call run with empty inputs


    return true;
}
//----------------------------------------------------------------------
//----------------------------------------------------------------------
function Squash::OnRemove(%this) {
    $Main.setScreenSize(%this.saveSize);
    if (%this.AI.fitness > 0.0 && %this.AI.fitness > %this.AI.BestFitness) {
        printf("--> New Best Fitness Record: %.3f",%this.AI.BestFitness);
        %this.AI.save(%this.AIFile);
    }
}
//----------------------------------------------------------------------
function Squash::BallOut(%this) {
    %this.ball.pos = {20,12};
    %this.gameOver = true;

    if (%this.AI.active ) {

        // if (%this.AI.Learn) {
        //     %this.AI.fitness = 0;
        //     %this.startGame();
        //     return;
        // }

        printf("Generation %d - Agent %d died. Fitness:%.1f", %this.AI.CurrentGeneration,%this.AI.CurrentAgentIndex,%this.AI.fitness);

        %this.AI.CurrentAgentIndex++;

        if(%this.AI.CurrentAgentIndex >= %this.AI.PopulationSize) {
                %this.AI.CurrentGeneration++;
                %this.AI.CurrentAgentIndex = 1;
                printSeparator();
                sprintf("=== STARTING GENERATION %d ===",  %this.AI.CurrentGeneration);
                print("Current All-Time Best Fitness: ", %this.AI.BestFitness);
                printSeparator();

                %this.AI.load(%this.AIFile);
                // %this.AI.WarmUP();
        } else {
            if (%this.AI.fitness > %this.AI.BestFitness) {
                %this.AI.BestFitness = %this.AI.fitness;
                printf("--> New Best Fitness Record: %.3f",%this.AI.BestFitness);
                %this.AI.save(%this.AIFile);
            } else {
                // if (!%this.AI.Learn) {
                    // load previous best file
                    %this.AI.load(%this.AIFile);
                    %this.AI.mutate(0.15, 0.3);
                    // %this.AI.WarmUP(); // call run with empty inputs after mutate
                // }
            }
        }
        %this.AI.fitness = 0;
        %this.startGame();
        return;
    }


}
//----------------------------------------------------------------------
function Squash::OnPaddleHit(%this) {
    %ball = %this.ball;

    %ball.pos.x = %this.paddle.rect.x - 1;
    %ball.dir.x *= -1.0;
    %this.score++;
    %ball.speed += 0.1;


    if (%this.paddle.dir != 0.0)  %ball.dir.y += %this.paddle.dir *  0.2;
    else %ball.dir.y *= 0.75;

    if (%ball.dir.y > 1.0) %ball.dir.y = 1.0;
    else if (%ball.dir.y < -1.0) %ball.dir.y = -1.0;

    if (%this.AI.active) {
        %this.AI.fitness += 100;
    }

}
//----------------------------------------------------------------------
function Squash::UpdateAI(%this) {

    if (!%this.AI.active) return;



    // 0: Ball.pos.x   / normalized
    %this.AI.setIn(0, %this.ball.pos.x / $Global::ScreenSize.x);
    // 1: Ball.pos.y   / normalized
    %this.AI.setIn(1, %this.ball.pos.y / $Global::ScreenSize.y);
    // 2: Ball Speed x / max Speed
    %this.AI.setIn(2, %this.ball.dnorm.x);
    // 3: Ball Speed y / max Speed
    %this.AI.setIn(3, %this.ball.dnorm.y);
    // 4: Paddle.y middle normalized
    %this.AI.setIn(4, (%this.paddle.rect.y + %this.paddle.rect.height / 2) / $Global::ScreenSize.y );

    if (%this.AI.Learn) {

        %div =  %this.ball.pos.y -  %this.paddle.rect.y + %this.paddle.rect.height / 2;
        if (math.fAbs(%div) <  %this.paddle.rect.height / 2) %value = 0.0;
        else %value = %div > 0 ? 0.35 : -0.35;

        %this.AI.setout( 0, %value);

        // printf("LEARN VALUE IS : %.4f %%div=%.4f", %value, %div);
        for (%i in RANGE 1000) %this.AI.train(0.3);


    }



    %this.AI.Run();
    %this.paddle.dir = %this.AI.getOut(0);
    // printf("Inputs: %s %g OUT: %g", %this.AI.getInVec(0), %this.AI.getIn(4), %this.paddle.dir );

    if (math.fabs( %this.paddle.dir ) > 0.3) %this.AI.fitness-=1.0 * GetFrameTime();
    else %this.AI.fitness+=1.0 * GetFrameTime();


}
//----------------------------------------------------------------------
function Squash::UpdateBall(%this) {

    %ball = %this.ball;
    %dt   = GetFrameTime();

    if (%ball.pos.x > $Global::ScreenSize.x + 2.0) {
        %this.ballOut();
        // game over

    }
    if (%this.gameOver) return;
    %xAdd = %ball.dir.x * %ball.speed * %dt;
    %yAdd = %ball.dir.y * %ball.speed * %dt;
    %ball.pos.x += %xAdd;
    %ball.pos.y += %yAdd;

    %ball.dnorm.x = %xAdd / %ball.maxSpeed;
    %ball.dnorm.y = %yAdd / %ball.maxSpeed;


    if (SDL_PointInRectFloat(%ball.pos, %this.paddle.rect))  %this.OnPaddleHit();
    // if (math.floor( %ball.pos.x ) == %this.paddle.rect.x - 1
    //     && %ball.pos.y >= %this.paddle.rect.y
    //     && %ball.pos.y <= %this.paddle.rect.y + %this.paddle.rect.height
    // ) {
    //     %this.OnPaddleHit();
    //
    //
    // }


    if (%ball.pos.x <= 0.0 ) {
        %ball.pos.x = 0.0;
        %ball.dir.x *= -1.0;
    }
    if (%ball.pos.y <= 0.0 ) {
        %ball.pos.y = 0.0;
        %ball.dir.y *= math.randomf(-0.9, -1.0);
    }
    if (%ball.pos.y >= $Global::ScreenSize.y - 1.0) {
        %ball.pos.y = $Global::ScreenSize.y - 1.0;
        %ball.dir.y *= math.randomf(-0.9, -1.0);
    }




}
//----------------------------------------------------------------------
function Squash::Render(%this) {
    if (!%this.renderer) return;

    %this.updateBall();

    SDL_SetRenderDrawColor(%this.renderer, 10, 10, 10);
    SDL_RenderClear(%this.renderer);

    SDL_SetRenderDrawColor(%this.renderer, 205, 205, 205);
    SDL_RenderPoint(%this.renderer, %this.ball.pos.x, %this.ball.pos.y);
    SDL_RenderFillRect(%this.renderer, %this.paddle.rect);

    // if (!%this.gameOver) {

        if (%this.paddle.dir < -0.3) {
            if (%this.paddle.rect.y > 0.0 ) {
                %this.paddle.rect.y -= GetFrameTime() * %this.paddle.speed;
                %this.paddle.dir = -1.0;
            }
        } else  if (%this.paddle.dir > 0.3) {
            if (%this.paddle.rect.y + %this.paddle.rect.height < $Global::ScreenSize.y ) {
                %this.paddle.rect.y += GetFrameTime() * %this.paddle.speed;
            }
        }

    // }


     $Main.drawText($Global::ScreenSize.x / 2.0 - 0.5, 0, %this.score, 0.3);

     if (%this.AI.active) {
        %this.UpdateAI();
        $Main.drawText(0, 0, sprintf("fit: %7.2f/%7.2f",%this.AI.fitness,%this.AI.BestFitness), 0.1);
        $Main.drawText(0, 1, sprintf("L:%d paddle dir: %0.4f",%this.AI.Learn, %this.paddle.dir), 0.1);
     }
}
//----------------------------------------------------------------------
function  Squash::onSDLKeyBoardEvent(%this,%scancode, %modifiers, %isDown, %isRepeat) {

    if (%this.AI.active) return;

    if (%isDown) {
        switch(%scancode) {
            case SDL_SCANCODE_SPACE: %this.startGame();
            case SDL_SCANCODE_UP: %this.paddle.dir = -1.0;
            case SDL_SCANCODE_DOWN: %this.paddle.dir = 1.0;
            case SDL_SCANCODE_F12:
                    %this.AI.active = true;
                    %this.startGame();
            case SDL_SCANCODE_F11:
                    %this.AI.Learn = true;
                    %this.AI.active = true;
                    %this.startGame();
        }
    } else {
        switch(%scancode) {
            case SDL_SCANCODE_UP: %this.paddle.dir = 0.0;
            case SDL_SCANCODE_DOWN: %this.paddle.dir = 0.0;
        }
    }

}
function  Squash::onSDLMouseButtonEvent(%this,%button, %isDown, %x, %y) {}
function  Squash::onSDLMouseWheelEvent(%this,%wheelX, %wheelY){}


