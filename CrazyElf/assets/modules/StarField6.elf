// orig 420
#define STAR_COUNT 4200
#define START_DIV 0.03125

function createStarField6() {
    %obj = new ScriptGroup() {
        class = "StarField6";
        TypeF32 speed = 0.4;
        TypeBool drawLines = false;
    };
    error("%obj.speed is" SPC %obj.speed);
    return %obj;
}
// -----------------------------------------------------------------------------
function StarField6::UpdateSize(%this) {
    %this.screenSize = $Global::ScreenSize;
    $screenWidth  = %this.screenSize.x;
    $screenHeight = %this.screenSize.y;

    // save as min/max
    $minH = -$screenWidth / 2;
    $maxH = $screenWidth / 2;
    $minW = -$screenHeight / 2;
    $maxW = $screenHeight / 2;

    $hW = $screenWidth  * 0.5;
    $hH = $screenHeight  * 0.5;

    // // update params
    // if (%this.starPoints.params > 0) {
    //     %p = %this.starPoints.params;
    //     %p.set(4, $minH);
    //     %p.set(5, $maxH);
    //     %p.set(6, $minW);
    //     %p.set(7, $maxW);
    //     %p.set(11, $hW);
    //     %p.set(12, $hH);
    // }
}
// -----------------------------------------------------------------------------
function StarField6::OnAdd(%this) {

    %this.updateSize();

    %this.add( %this.starPoints = new PointStorageObject() {
        storageSize = STAR_COUNT;
        TypeS32 params = 0;
    });


    for(%i in range STAR_COUNT)
    {
        %this.starPoints.setPoint(%i, math.randomf($minH , $maxH),math.randomf($minW , $maxW), 1.0 );
    }






    %this.starPoints.params =  %this.starPoints.mapInjectFn($gFn);


    return true;
}
// -----------------------------------------------------------------------------
function StarField6::onRemove(%this) {

}
// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
// using local vars maximum attempt:
// LITE VERSION some hard coded stuff
$gFn = fn (%vec, %renderer, %dt, %speed) {

    [ %pointX , %pointY, %pointZ] = %vec;
    %pointZ -= %dt * %speed;

    %invZ = 1.0 /  %pointZ;
    %screenPos_X = 160.0 + (%pointX * %invZ); // %hW = 160.0
    %screenPos_Y = 100.0 + (%pointY * %invZ); // %hH = 100.0

    if ( %pointZ < 0.0 || %screenPos_X < 0.0 || %screenPos_Y < 0.0
        || %screenPos_X > 320 || %screenPos_Y > 200)
    {
        %pointX = math.randomf(-160.0, 160.0);
        %pointY = math.randomf(-100.0, 100.0);
        %pointZ = 1.0;
        %screenPos_X = 160.0 +  %pointX;
        %screenPos_Y = 100.0 +  %pointY;
    }

    %radius = math.Lerp(2.0, 0.3, %pointZ);

    SDL_RenderFillRect(%renderer, { %screenPos_X, %screenPos_Y, %radius, %radius });

    return { %pointX, %pointY, %pointZ };
};


